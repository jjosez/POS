<view>
    <columns>
        <group name="data" numcolumns="12">
            <column name="code" numcolumns="3" order="100">
                <widget type="text" fieldname="clave" icon="fas fa-hashtag" required="true"/>
            </column>
            <column name='currency' numcolumns='3' order='120'>
                <widget type='autocomplete' fieldname='coddivisa' onclick='EditDivisa'>
                    <values source='divisas' fieldcode='coddivisa' fieldtitle='descripcion'/>
                </widget>
            </column>
            <column name="value" numcolumns="3" order="140">
                <widget type="number" decimal="0" fieldname="valor" required="true"/>
            </column>
            <column name="type" numcolumns="3" order="150">
                <widget type="select" fieldname="tipo" translate="true" required="true">
                    <values title="bill">bill</values>
                    <values title="coin">coin</values>
                </widget>
            </column>
        </group>
    </columns>
</view>
