{% macro customCheckboxInput(id, name, label, value) %}
    <div class="flex items-center text-sm mb-2">
        <input id="{{ id }}" name="{{ name }}" type="checkbox" class="mr-2"
               data-action="ui:order:field:edit" data-document-field="{{ name }}">
        <label for="{{ id }}">{{ label }}</label>
    </div>
{% endmacro %}

{% macro customTextInput(id, name, label, value) %}
    <div class="form-group text-sm mb-2">
        <label for="{{ id }}" class="font-semibold capitalize mb-1.5">{{ label }}</label>
        <input id="{{ id }}" name="{{ name }}" class="form-control" type="text"
               data-action="ui:order:field:edit" data-document-field="{{ name }}">
    </div>
{% endmacro %}

{% macro customNumberInput(id, name, label, value) %}
    <div class="form-group text-sm mb-2">
        <label for="{{ id }}" class="font-semibold capitalize mb-1.5">{{ label }}</label>
        <input id="{{ id }}" name="{{ name }}" class="form-control" type="number"
               data-action="ui:order:field:edit" data-document-field="{{ name }}">
    </div>
{% endmacro %}

{% macro customTextArea(id, name, label, value) %}
    <div class="form-group text-sm mb-2">
        <label for="{{ id }}" class="font-semibold capitalize mb-1.5">{{ label }}</label>
        <textarea id="{{ id }}" name="{{ name }}" cols="30" rows="4"
                  data-action="ui:order:field:edit" data-document-field="{{ name }}"></textarea>
    </div>
{% endmacro %}

{% macro menuToggleElement(toggle, target, icon, text, title) %}
    <li>
        <button class="btn w-full flex items-center justify-center hover:bg-slate-300 hover:text-slate-800 focus:ring-slate-100"
                data-toggle="{{ toggle }}" data-target="{{ target }}" title="{{ title }}">
            <i class="text-lg leading-lg {{ icon }} fa-fw"></i>
            {% if text %}
                <span class="ml-2">{{ text }}</span>
            {% endif %}
        </button>
    </li>
{% endmacro %}

{% macro menuActionElement(action, icon, text, title) %}
    <li>
        <button class="btn w-full items-center justify-center hover:bg-slate-300 hover:text-slate-800 focus:ring-slate-100"
                data-action="{{ action }}" title="{{ title }}">
            <i class="text-lg leading-lg {{ icon }} fa-fw"></i>
            {% if text %}
                <span class="ml-2">{{ text }}</span>
            {% endif %}
        </button>
    </li>
{% endmacro %}

{% macro menuLinkElement(url, icon, text, title) %}
    <li>
        <a class="btn flex items-center justify-center hover:bg-slate-300 hover:text-slate-800 focus:ring-slate-100"
           href="{{ url }}"
           target="_blank" title="{{ title }}">
            <i class="text-lg leading-lg {{ icon }} fa-fw"></i>
            {% if text %}
                <span class="ml-2">{{ text }}</span>
            {% endif %}
        </a>
    </li>
{% endmacro %}

{% macro processingMessageModal() %}
    <div id="processingMessageModal" class="modal hidden">
        <div class="modal-content md:modal-content-sm">
            <div class="modal-header">
                <h2 class="text-2xl text-slate-gray-700 font-semibold">{{ trans('processing') }}</h2>
                <button class="btn btn-icon btn-danger ml-2" data-toggle="modal" data-target="context:action:modal">
                    <i class="fa fw fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="items-center">
                    <svg class="w-24 h-24 animate-spin text-gray-900/50" viewBox="0 0 64 64" fill="none"
                         xmlns="http://www.w3.org/2000/svg" width="24" height="24">
                        <path d="M32 3C36.5778 3 41.0906 4.08374 45.1692 6.16256C49.2477 8.24138 52.7762 11.2562
                        55.466 14.9605C58.1558 18.6647 59.9304 22.9531 60.6448 27.4748C61.3591 31.9965 60.9928 36.6232
                        59.5759 40.9762"
                              stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"
                              class="text-blue-500">
                        </path>
                    </svg>
                </div>
            </div>
            <div class="modal-footer">
            </div>
        </div>
    </div>
{% endmacro %}
