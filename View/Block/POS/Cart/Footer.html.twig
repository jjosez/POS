<!-- Totals and Checkout Button-->
<div class="flex flex-col gap-4 border-t-2 border-dashed p-4">
    <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <div>
                <div class="text-xs font-semibold text-slate-500 uppercase">{{ trans('total') }}</div>
                {{ context.currency().getCurrency().simbolo }}
                <span id="cartTotal" class="text-2xl font-extrabold tracking-tight"
                      data-view="CartView">0.000</span>
            </div>
            <button class="btn btn-icon btn-naked" data-toggle="modal" data-target="totalsDetailModal">
                <i class="fas fa-chevron-up text-slate-400 group-hover:text-slate-600 text-sm"></i>
            </button>
        </div>
        <div class="flex items-center gap-2">
            <button class="btn btn-light" data-action="order:draft:save">
                <span class="mr-auto">{{ trans('hold') }}</span>
            </button>
            {% if terminal.aceptapagos %}
                <button class="btn btn-success px-6 font-bold" data-action="checkout:show">
                    <span class="mr-auto">{{ trans('charge') }}</span>
                </button>
            {% endif %}
        </div>
    </div>
</div>
