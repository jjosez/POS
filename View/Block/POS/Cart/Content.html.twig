<div id="cart:list:template:view" class="flex h-full flex-1 flex-col divide-y-2 divide-dotted">
    <div class="flex flex-1 items-center justify-center">
        <i class="fa fa-shopping-cart fa-5x text-slate-300"></i>
    </div>
</div>

<script id="cart:list:template" type="text/template">
    {% set cartColumnCount = fsc.getCartColumnCount() %}
    {% set excludedColumns = ['referencia', 'descripcion', 'cantidad'] %}
    {% set priceColumns = ['pvpunitario', 'pvpunitarioiva'] %}

    <% if(lines.length === 0) { %>
    <div class="flex h-full items-center justify-center">
        <i class="fa fa-shopping-cart fa-5x text-slate-300"></i>
    </div>
    <% } %>
    <% lines.forEach(function(product, index) { %>
    {{ _self.newProductLine(grid, excludedColumns, priceColumns, cartColumnCount) }}
     {#{{ _self.newLineMockup() }}#}
    <% }) %>
</script>

{% macro newProductLine(grid, excludedColumns, priceColumns, cartColumnCount) %}
    <div class="cart-line py-2 px-4 grid w-full flex-shrink-0 grid-cols-[1fr_auto_auto] items-stretch cursor-pointer hover:bg-slate-50"
         data-action="ui:cart:line:selection:change"
         data-index="<%= index %>"
         aria-selected="false">
        <!-- Producto -->
        <div class="flex min-w-0 items-center gap-3">
            <!-- Thumbnail -->
            <% if (product.thumbnail) { %>
            <img class="pointer-events-auto h-12 w-12 shrink-0 rounded-xl object-cover" src="<%= product.thumbnail %>"
                 alt="<%= product.referencia %>"
                 data-action="product:image:show"
                 data-id="<%= product.idproducto %>"
                 data-code="<%= product.referencia %>">
            <% } else { %>
            <div class="h-12 w-12 shrink-0 rounded-xl bg-slate-100 ring-1 ring-slate-200 flex items-center justify-center text-slate-400">
                <div class="w-16 text-center"><i class="fa-regular fa-image text-xl "></i></div>
            </div>
            <% } %>

            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="text-xs font-semibold text-slate-500"><%= product.referencia %></span>
                </div>

                <!-- Description -->
                <div class="line-clamp-2 text-sm font-semibold text-slate-900">
                    <%= product.descripcion %>
                </div>

                <!-- Badges -->
                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                    {% for column in grid %}
                        {% if column.data not in excludedColumns and column.eneabled and column.carrito and column.readonly %}
                            {% set label = column.tittle ?: trans(column.name) %}
                            {# {% if column.name == 'price-with-tax' or column.name == 'price' %}
                                <span class="font-extrabold rounded-full bg-slate-100 px-2 py-0.5">
                                    {{ label }}: <%= product.{{ column.data }} %>
                                </span>
                            {% else %}
                                <span class="rounded-full bg-slate-100 px-2 py-0.5">{{ label }}: <%= product.{{ column.data }} %></span>
                            {% endif %} #}
                            <div class="mt-1 text-xs text-slate-500">
                                <span class="text-slate-400">{{ label }}: </span>
                                <span class="font-semibold text-slate-700"><%= product.{{ column.data }} %></span>
                            </div>
                            {# <span class="rounded-full bg-slate-100 px-2 py-0.5">{{ label }}: <%= product.{{ column.data }} %></span> #}
                        {% endif -%}
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <!-- Cantidad -->
            <div class="w-24 flex-col">
                <div class="h-4 text-[11px] font-semibold text-slate-500">
                    {{ trans('quantity') }}
                </div>
                <input type="number" id="cart_quantity<%= index %>"
                       class="form-control-base p-1.5 w-full rounded-lg text-right text-sm bg-white"
                       value="<%= product.cantidad %>"
                       data-action="ui:cart:line:field:edit" data-index="<%= index %>" data-field="cantidad">
            </div>
            <div class="flex flex-1 flex-row gap-2 justify-start xl:justify-evenly">
                {% for column in grid %}
                    {% if column.data in priceColumns and column.eneabled and column.carrito and not column.readonly %}
                        {% set label = column.tittle ?: trans(column.name) %}
                        <div class="flex-col w-24">
                            <div class="h-4 text-[11px] font-semibold text-slate-500">{{ label }}</div>
                            {% if column.readonly %}
                                <div class="text-sm font-extrabold text-slate-900"><%= product.{{ column.data }}%>
                                </div>
                            {% else %}
                                <input id="cart_{{ column.data }}<%= index %>"
                                       class="form-control-base p-1.5 w-full rounded-lg text-right text-sm font-bold bg-white"
                                       tabindex="0"
                                       inputmode="decimal"
                                       type="{{ column.type }}"
                                       value="<%= product.{{ column.data }} %>"
                                       data-index="<%= index %>"
                                       data-action="ui:cart:line:field:edit"
                                       data-field="{{ column.data }}">
                            {% endif %}
                        </div>
                    {% endif -%}
                {% endfor %}
            </div>
            <!-- Total + Delete -->
            <div class="w-24 gap-2">
                <div class="text-right">
                    <div class="h-4 text-[11px] font-semibold text-slate-500">{{ trans('line-total-abbr') }}</div>
                    <div class="text-lg font-extrabold tracking-tight text-slate-900">$ <%= product.pvptotaliva %></div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}
{% macro newLineMockup() %}
    <div class="grid w-full flex-shrink-0 grid-cols-[1fr_auto_auto] items-stretch">
        <!-- ITEM 1: El "flexible" que empuja a los demás -->
        <div class="bg-blue-200 p-4">
            <div class="flex min-w-0 items-center gap-3">
                <!-- Thumbnail -->
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-400 ring-1 ring-slate-200">
                    <div class="w-16 text-center"><i class="fa-regular fa-image text-xl"></i></div>
                </div>

                <div class="min-w-0 flex-1">
                    <div class="flex min-w-0 items-center gap-2">
                        <span class="text-xs font-semibold text-slate-500">FLR-FOI-00002</span>
                    </div>
                    <div class="line-clamp-2 text-sm font-semibold text-slate-900">FILTRO DE ACEITE AVEO</div>
                    <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                        <span class="text-slate-400">Precio:</span>
                        <span class="font-semibold text-slate-700">300</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-3 px-4">
            <!-- Cantidad (Sigue dentro del primer bloque) -->
            <div class="w-24 shrink-0">
                <div class="h-4 text-[11px] font-semibold text-slate-500">Cantidad</div>
                <input type="number" class="form-control-base w-full rounded-lg bg-white p-1.5 text-right text-sm"
                       value="1"/>
            </div>
            <div class="flex flex-1 flex-row justify-start gap-2 xl:justify-evenly">
                <div class="w-24 flex-col">
                    <div class="h-4 text-[11px] font-semibold text-slate-500">Precio + impuestos</div>
                    <input id="cart_pvpunitarioiva0"
                           class="form-control-base w-full rounded-lg bg-white p-1.5 text-right text-sm font-bold"
                           tabindex="0" inputmode="decimal" type="number" value="348.00" data-index="0"
                           data-action="ui:cart:line:field:edit" data-field="pvpunitarioiva"
                           data-np-intersection-state="visible"/>
                </div>
            </div>
            <!-- Total + Delete -->
            <div class="ml-auto flex items-center gap-2">
                <div class="text-right">
                    <div class="h-4 text-[11px] font-semibold text-slate-500">line-total</div>
                    <div class="text-lg font-extrabold tracking-tight text-slate-900">$ 348.00</div>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}

