<div id="product:filter:family:view" class="mb-4 flex flex-wrap gap-2 px-4">
</div>
<div class="mb-4 flex-1 overflow-y-auto px-4">
    <div id="product:search:list:view" class="my-1" role="list">
        {% set mode = terminal.product_display_mode | default('grid') %}
        {% set products = fsc.getHomeProducts() %}
        {{ _self.productView(products, mode) }}
    </div>
</div>
<script id="product:search:template" type="text/template">
    <div class="hidden">
    <div class="mb-2 flex items-baseline gap-2">
        <span class="text-sm font-semibold text-slate-700">{{ trans('option') }} A</span>
    </div>
    <div class="<%= mode === 'grid' ? 'grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4' : 'flex flex-col gap-3' %>">
        <% products.forEach(function(product){ %>
        <div role="listitem"
             class="group rounded-lg bg-white p-3 ring-1 transition product-add-btn <%= mode === 'grid' ? 'flex flex-col' : '' %>
                    <%= product.isOutOfStock
                        ? 'ring-red-200 opacity-70 cursor-default'
                        : 'ring-slate-200 hover:ring-slate-300 hover:shadow-sm active:scale-[0.99] cursor-pointer' %>"
             data-action="<%= product.isOutOfStock ? '' : 'ui:cart:line:add' %>"
             data-code="<%= product.code %>"
             data-description="<%= product.description %>"
             data-thumbnail="<%= product.thumbnail %>">

            <div class="<%= mode === 'grid' ? 'flex flex-col h-full' : 'flex gap-3' %>">
                {# Thumbnail #}
                <div class="relative <%= mode === 'grid' ? 'mb-3 h-28 w-full' : 'h-14 w-14 xl:h-16 xl:w-16' %> shrink-0 flex items-center justify-center overflow-hidden rounded-md bg-slate-100 text-slate-400">
                    <% if (product.thumbnail) { %>
                    <img class="h-full w-full object-cover"
                         src="<%= product.thumbnail %>"
                         alt="<%= product.code %>"
                         loading="lazy" decoding="async">

                    {# Overlay zoom button #}
                    <button type="button"
                            class="absolute <%= mode === 'grid' ? 'top-1 right-1 w-10 h-10 rounded-full bg-white/80 text-gray-600' : 'inset-0 bg-black/0 md:hover:bg-black/40' %> z-10 flex items-center justify-center transition-colors group pointer-events-auto"
                            title="{{ trans('view-image') }}"
                            data-action="product:image:show"
                            data-id="<%= product.id %>"
                            data-code="<%= product.code %>">
                        <i class="fas fa-eye <%= mode === 'grid' ? '' : 'text-white opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity' %> pointer-events-none"></i>
                    </button>
                    <% } else { %>
                    <i class="fas fa-image <%= mode === 'grid' ? 'text-2xl' : 'text-xl xl:text-2xl' %> text-slate-300"></i>
                    <% } %>
                </div>

                {# Content #}
                <div class="min-w-0 flex-1">
                    <div class="<%= mode === 'grid' ? 'flex flex-col h-full text-center' : 'flex items-start justify-between gap-3' %>">
                        <div class="min-w-0 <%= mode === 'grid' ? 'flex-1' : '' %>">
                            <p class="text-xs font-semibold text-slate-500 truncate">
                                <%= product.code %>
                            </p>
                            <p class="mt-0.5 text-sm font-semibold leading-snug line-clamp-2">
                                <%= product.description %>
                            </p>
                            <% if (product.detail) { %>
                            <p class="mt-0.5 text-xs text-slate-500 italic truncate">
                                <%= product.detail %>
                            </p>
                            <% } %>
                            {# Badges / meta #}
                            <div class="mt-2 flex flex-wrap <%= mode === 'grid' ? 'justify-center' : '' %> items-center gap-2 text-xs">
                                <% if (product.isOutOfStock) { %>
                                <span class="inline-flex items-center rounded-lg bg-red-50 px-2 py-1 font-semibold text-red-700">
                                    <i class="fa-solid fa-ban mr-1"></i> {{ trans('out-of-stock') }}
                                </span>
                                <% } %>
                                <span class="pointer-events-auto inline-flex items-center rounded-lg bg-slate-100 px-2 py-1 font-semibold text-slate-600 hover:bg-slate-300"
                                      data-action="product:stock:show"
                                      data-code="<%= product.code %>">
                                        Stock: <%= (product.stock ?? 0) %>
                                    </span>

                                <% if (product.family) { %>
                                <span class="inline-flex items-center rounded-lg bg-slate-100 px-2 py-1 font-semibold text-slate-600">
                                        <%= product.family %>
                                    </span>
                                <% } %>
                                <% if (product.brandname) { %>
                                <span class="inline-flex items-center rounded-lg bg-blue-50 px-2 py-1 font-semibold text-blue-700">
                                        <%= product.brandname %>
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        {# Price + CTA #}
                        <div class="<%= mode === 'grid' ? 'mt-auto pt-2 flex items-center justify-center' : 'flex-shrink-0 text-right' %>">
                            <div class="<%= mode === 'grid' ? 'text-lg' : 'text-base' %> font-extrabold text-slate-900">
                                <%= product.priceWithFormat %>
                            </div>
                            <% if (!product.isOutOfStock && mode === 'list') { %>
                            <div class="mt-1 text-xs text-slate-500">
                                {{ trans('touch-to-add') }}
                            </div>
                            <% } else if (product.isOutOfStock && mode === 'list') { %>
                            <button type="button"
                                    class="mt-2 cursor-not-allowed rounded-lg bg-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-500"
                                    disabled>
                                {{ trans('not-available') }}
                            </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
    </div>

    <div class="<%= mode === 'grid' ? 'grid grid-cols-2 gap-4 lg:grid-cols-3 xl:grid-cols-4' : 'flex flex-col gap-3' %>">
        <% products.forEach(function(product){ %>
        <% const unavailable = product.isOutOfStock || Number(product.bloqueado) === 1 %>
        <article role="listitem"
                 class="group flex h-full min-w-0 flex-col overflow-hidden rounded-xl border bg-white p-2.5 transition-all duration-150 product-add-btn
                        <%= unavailable
                            ? 'border-red-200 cursor-default'
                            : 'border-slate-200 hover:border-blue-400 hover:shadow-sm active:scale-[0.99] cursor-pointer' %>"
                 data-action="<%= unavailable ? '' : 'ui:cart:line:add' %>"
                 data-code="<%= product.code %>" data-description="<%= product.description %>"
                 data-thumbnail="<%= product.thumbnail %>" data-bloqueado="<%= product.bloqueado ?? 0 %>">
            <div class="relative aspect-[16/9] overflow-hidden rounded-lg bg-slate-100">
                <button type="button"
                        class="pointer-events-auto absolute left-2 top-2 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white/40 text-slate-400 transition hover:bg-white/80 hover:text-blue-600"
                        data-action="product:detail:show" data-code="<%= product.code %>"
                        title="{{ trans('product-detail') }}" aria-label="{{ trans('product-detail') }}">
                    <i class="fa-solid fa-circle-info text-xs" aria-hidden="true"></i>
                </button>
                <% if (product.thumbnail) { %>
                <img src="<%= product.thumbnail %>" alt="<%= product.description %>"
                     class="h-full w-full object-contain p-3" loading="lazy" decoding="async">
                <button type="button"
                        class="pointer-events-auto absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-white/40 text-slate-400 transition hover:bg-white/80 hover:text-blue-600"
                        data-action="product:image:show" data-id="<%= product.id %>" data-code="<%= product.code %>"
                        title="{{ trans('view-image') }}" aria-label="{{ trans('view-image') }}">
                    <i class="fa-solid fa-expand text-xs" aria-hidden="true"></i>
                </button>
                <% } else { %>
                <div class="flex h-full items-center justify-center text-slate-300">
                    <i class="fa-regular fa-image text-3xl" aria-hidden="true"></i>
                </div>
                <% } %>
            </div>

            <div class="flex flex-1 flex-col px-1 pb-1 pt-3">
                <div class="mb-1 truncate text-xs font-medium text-slate-400"><%= product.code %></div>
                <h3 class="h-10 overflow-hidden line-clamp-2 text-sm font-semibold leading-5 text-slate-900"
                    title="<%= product.description %>"><%= product.description %></h3>
                <% if (product.detail) { %>
                <div class="mt-1 truncate text-xs italic text-slate-400"><%= product.detail %></div>
                <% } %>

                <div class="mt-3 flex flex-wrap items-center gap-2">
                    <button type="button"
                            class="pointer-events-auto inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium
                                   <%= product.isOutOfStock ? 'bg-red-50 text-red-600' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' %>"
                            data-action="product:stock:show" data-code="<%= product.code %>">
                        {{ trans('stock') }}: <%= product.stock ?? 0 %>
                    </button>
                    <% if (product.brandname) { %>
                    <span class="inline-flex max-w-full items-center truncate rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-medium text-blue-600">
                        <%= product.brandname %>
                    </span>
                    <% } %>
                </div>

                <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3">
                    <div class="truncate text-lg font-bold tabular-nums <%= unavailable ? 'text-slate-500' : 'text-slate-950' %>"><%= product.priceWithFormat %></div>
                    <button type="button"
                             class="pointer-events-auto flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-sm transition
                                   <%= unavailable ? 'bg-slate-200 text-slate-400' : 'bg-slate-950 text-white hover:bg-blue-600 active:scale-95' %>"
                            data-action="<%= unavailable ? '' : 'ui:cart:line:add' %>" data-code="<%= product.code %>"
                            data-description="<%= product.description %>" data-thumbnail="<%= product.thumbnail %>" data-bloqueado="<%= product.bloqueado ?? 0 %>"
                            title="{{ trans('add') }}" aria-label="{{ trans('add') }}: <%= product.description %>"
                            <%= unavailable ? 'disabled' : '' %>>
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </article>
        <% }) %>
    </div>

</script>

{% macro productView(products, mode) %}
    <div class="hidden">
    <div class="mb-2 flex items-baseline gap-2">
        <span class="text-sm font-semibold text-slate-700">{{ trans('option') }} A</span>
    </div>
    <div class="{{ mode == 'grid' ? 'grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4' : 'flex flex-col gap-3' }}">
        {% for product in products %}
            {% set cardState = product.isOutOfStock
                ? 'ring-red-200 opacity-70 cursor-default'
                : 'ring-slate-200 hover:ring-slate-300 hover:shadow-sm active:scale-[0.99] cursor-pointer' %}
            {% set actionAttr = product.isOutOfStock ? '' : 'ui:cart:line:add' %}

            <div role="listitem"
                 class="group rounded-lg bg-white p-3 ring-1 transition product-add-btn {{ mode == 'grid' ? 'flex flex-col' : '' }} {{ cardState }}"
                 data-action="{{ actionAttr }}"
                 data-code="{{ product.code }}"
                 data-description="{{ product.description }}"
                 data-thumbnail="{{ product.thumbnail }}">

                <div class="{{ mode == 'grid' ? 'flex flex-col h-full' : 'flex gap-3' }}">
                    {# Thumbnail #}
                    <div class="relative {{ mode == 'grid' ? 'mb-3 h-28 w-full' : 'h-14 w-14 xl:h-16 xl:w-16' }} shrink-0 flex items-center justify-center overflow-hidden rounded-md bg-slate-100 text-slate-400">
                        {% if product.thumbnail %}
                            <img class="h-full w-full object-cover"
                                 src="{{ product.thumbnail }}"
                                 alt="{{ product.code }}"
                                 loading="lazy" decoding="async">

                            <button type="button"
                                    class="absolute {{ mode == 'grid' ? 'top-1 right-1 w-10 h-10 rounded-full bg-white/80 text-gray-600' : 'inset-0 bg-black/0 md:hover:bg-black/40' }} z-10 flex items-center justify-center transition-colors group pointer-events-auto"
                                    title="{{ trans('view-image') }}"
                                    data-action="product:image:show"
                                    data-id="{{ product.id }}"
                                    data-code="{{ product.code }}">
                                <i class="fas fa-eye {{ mode == 'grid' ? '' : 'text-white opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity' }} pointer-events-none"></i>
                            </button>
                        {% else %}
                            <i class="fas fa-image {{ mode == 'grid' ? 'text-2xl' : 'text-xl xl:text-2xl' }} text-slate-300"></i>
                        {% endif %}
                    </div>

                    {# Content #}
                    <div class="min-w-0 flex-1">
                        <div class="{{ mode == 'grid' ? 'flex flex-col h-full text-center' : 'flex items-start justify-between gap-3' }}">
                            <div class="min-w-0 {{ mode == 'grid' ? 'flex-1' : '' }}">
                                <p class="text-xs font-semibold text-slate-500 truncate">
                                    {{ product.code }}
                                </p>
                                <p class="mt-0.5 text-sm font-semibold leading-snug line-clamp-2">
                                    {{ product.description }}
                                </p>
                                {% if product.detail %}
                                    <p class="mt-0.5 text-xs text-slate-500 italic truncate">
                                        {{ product.detail }}
                                    </p>
                                {% endif %}
                                {# Badges / meta #}
                                <div class="mt-2 flex flex-wrap {{ mode == 'grid' ? 'justify-center' : '' }} items-center gap-2 text-xs">
                                    {% if product.isOutOfStock %}
                                        <span class="inline-flex items-center rounded-lg bg-red-50 px-2 py-1 font-semibold text-red-700">
                                            <i class="fa-solid fa-ban mr-1"></i> {{ trans('out-of-stock') }}
                                        </span>
                                    {% endif %}
                                    <span class="pointer-events-auto inline-flex items-center rounded-lg bg-slate-100
                                    px-2 py-1 font-semibold text-slate-600 hover:bg-slate-300"
                                          data-action="product:stock:show"
                                          data-code="{{ product.code }}">
                                        Stock: {{ product.stock | default('0') }}
                                    </span>

                                    {% if product.family %}
                                        <span class="inline-flex items-center rounded-lg bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-500">
                                            {{ product.family }}
                                        </span>
                                    {% endif %}
                                    {% if product.brandname %}
                                        <span class="inline-flex items-center rounded-lg bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700">
                                            {{ product.brandname }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            {# Price #}
                            <div class="{{ mode == 'grid' ? 'mt-auto pt-2 flex items-center justify-center' : 'flex-shrink-0 text-right' }}">
                                <div class="{{ mode == 'grid' ? 'text-lg' : 'text-base' }} font-extrabold text-slate-900">
                                    {{ product.priceWithFormat }}
                                </div>
                                {% if not product.isOutOfStock and mode == 'list' %}
                                    <div class="mt-1 text-xs text-slate-500">
                                        {{ trans('touch-to-add') }}
                                    </div>
                                {% elseif product.isOutOfStock and mode == 'list' %}
                                    <button type="button"
                                            class="mt-2 cursor-not-allowed rounded-lg bg-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-500"
                                            disabled>
                                        {{ trans('not-available') }}
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    </div>

    <div class="{{ mode == 'grid' ? 'grid grid-cols-2 gap-4 lg:grid-cols-3 xl:grid-cols-4' : 'flex flex-col gap-3' }}">
        {% for product in products %}
            {% set unavailable = product.isOutOfStock or product.bloqueado %}
            {% set templateState = unavailable
                ? 'border-red-200 cursor-default'
                : 'border-slate-200 hover:border-blue-400 hover:shadow-sm active:scale-[0.99] cursor-pointer' %}
            {% set templateAction = unavailable ? '' : 'ui:cart:line:add' %}

            <article role="listitem"
                     class="group flex h-full min-w-0 flex-col overflow-hidden rounded-xl border bg-white p-2.5 transition-all duration-150 product-add-btn {{ templateState }}"
                     data-action="{{ templateAction }}" data-code="{{ product.code }}"
                     data-description="{{ product.description }}" data-thumbnail="{{ product.thumbnail }}"
                     data-bloqueado="{{ product.bloqueado ?? 0 }}">
                <div class="relative aspect-[16/9] overflow-hidden rounded-lg bg-slate-100">
                    <button type="button"
                            class="pointer-events-auto absolute left-2 top-2 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white/40 text-slate-400 transition hover:bg-white/80 hover:text-blue-600"
                            data-action="product:detail:show" data-code="{{ product.code }}"
                            title="{{ trans('product-detail') }}" aria-label="{{ trans('product-detail') }}">
                        <i class="fa-solid fa-circle-info text-xs" aria-hidden="true"></i>
                    </button>
                    {% if product.thumbnail %}
                        <img src="{{ product.thumbnail }}" alt="{{ product.description }}"
                             class="h-full w-full object-contain p-3" loading="lazy" decoding="async">
                        <button type="button"
                                class="pointer-events-auto absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-white/40 text-slate-400 transition hover:bg-white/80 hover:text-blue-600"
                                data-action="product:image:show" data-id="{{ product.id }}" data-code="{{ product.code }}"
                                title="{{ trans('view-image') }}" aria-label="{{ trans('view-image') }}">
                            <i class="fa-solid fa-expand text-xs" aria-hidden="true"></i>
                        </button>
                    {% else %}
                        <div class="flex h-full items-center justify-center text-slate-300">
                            <i class="fa-regular fa-image text-3xl" aria-hidden="true"></i>
                        </div>
                    {% endif %}
                </div>

                <div class="flex flex-1 flex-col px-1 pb-1 pt-3">
                    <div class="mb-1 truncate text-xs font-medium text-slate-400">{{ product.code }}</div>
                    <h3 class="h-10 overflow-hidden line-clamp-2 text-sm font-semibold leading-5 text-slate-900"
                        title="{{ product.description }}">{{ product.description }}</h3>
                    {% if product.detail %}
                        <div class="mt-1 truncate text-xs italic text-slate-400">{{ product.detail }}</div>
                    {% endif %}

                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        <button type="button"
                                class="pointer-events-auto inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium {{ product.isOutOfStock ? 'bg-red-50 text-red-600' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' }}"
                                data-action="product:stock:show" data-code="{{ product.code }}">
                            {{ trans('stock') }}: {{ product.stock ?? 0 }}
                        </button>
                        {% if product.brandname %}
                            <span class="inline-flex max-w-full items-center truncate rounded-full bg-blue-50 px-2 py-0.5 text-[10px] font-medium text-blue-600">
                                {{ product.brandname }}
                            </span>
                        {% endif %}
                    </div>

                    <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3">
                        <div class="truncate text-lg font-bold tabular-nums {{ unavailable ? 'text-slate-500' : 'text-slate-950' }}">{{ product.priceWithFormat }}</div>
                        <button type="button"
                                class="pointer-events-auto flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-sm transition {{ unavailable ? 'bg-slate-200 text-slate-400' : 'bg-slate-950 text-white hover:bg-blue-600 active:scale-95' }}"
                                data-action="{{ unavailable ? '' : 'ui:cart:line:add' }}" data-code="{{ product.code }}"
                                data-description="{{ product.description }}" data-thumbnail="{{ product.thumbnail }}"
                                data-bloqueado="{{ product.bloqueado ?? 0 }}"
                                title="{{ trans('add') }}" aria-label="{{ trans('add') }}: {{ product.description }}"
                                {{ unavailable ? 'disabled' : '' }}>
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </article>
        {% endfor %}
    </div>

{% endmacro %}
