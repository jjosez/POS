{#  POS Sales Return Screen #}
<div class="flex flex-col max-h-full w-full bg-white">

    {# ─── Sales Return Container ─── #}
    <div class="flex-1 min-h-0 overflow-auto flex flex-col gap-3 p-4 w-full">

        {# ─── Sales Return Header ─── #}
        <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-3">
                <button class="btn btn-naked p-3 border"
                        data-action="returns:fullscreen:hide">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span class="hidden sm:inline"></span>
                </button>
                <div>
                    <h1 class="text-xl font-bold">{{ trans('new-refund') }}</h1>
                    <p class="text-sm text-slate-500">Selecciona los productos que deseas devolver</p>
                </div>
            </div>
            <div class="flex gap-2">
                <button class="btn text-sm font-bold text-red-700 bg-red-50 hover:bg-red-100 transition-colors gap-1.5 "
                        data-action="returns:sale-clear:action">
                    {{ trans('cancel') }}
                </button>
                <button id="returnSaleConfirmBtn"
                        class="btn btn-primary gap-1.5 px-4 font-semibold"
                        data-action="returns:sale-confirm:action"
                        disabled>
                    <i class="fa-solid fa-check"></i>
                    {{ trans('apply-return') }}
                </button>
            </div>
        </div>

        {# ─── Sales Info ─── #}
        <div class="flex flex-wrap gap-2 items-center">
            <div class="relative flex-1 min-w-[200px]">
                <label class="flex-1 text-gray-400 input-icon">
                    <span><i class="fa fa-sm fa-search"></i></span>
                    <input id="returnSearchInput"
                           class="rounded-lg border border-slate-200 bg-slate-50"
                           type="search"
                           placeholder="{{ trans('search-sale-to-return') }}"
                           autocomplete="off">
                </label>
            </div>
            <button class="btn btn-light gap-1.5 text-sm font-bold transition-colors"
                    data-action="returns:sale-search:action" data-search-type="barcode">
                <i class="fa-solid fa-qrcode"></i>
                Escanear ticket
            </button>
            <button class="btn btn-light gap-1.5 text-sm font-bold transition-colors"
                    data-action="returns:sale-search:action" data-search-type="venta">
                <i class="fa-solid fa-magnifying-glass"></i>
                {{ trans('search') }}
            </button>
            <button class="btn btn-light gap-1.5 text-sm font-bold transition-colors"
                    data-action="returns:sale-search:action" data-search-type="invoice">
                <i class="fa-solid fa-file-invoice"></i>
                Buscar factura
            </button>
        </div>

        {# ─── Sales Return ─── #}
        <div id="returnSaleSummaryCard" class="bg-white rounded-lg border-2 border-t-4 border-slate-300">
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1 min-h-0">

            {# ─── Sales Products ─── #}
            <div class="lg:col-span-7 flex flex-col min-h-0">
                <div class="bg-white rounded-lg border-2 border-t-4 border-slate-300 flex flex-col flex-1 min-h-0 overflow-hidden">
                    <div class="flex items-center justify-between px-4 pt-3 pb-0 shrink-0">
                        <div class="flex items-center gap-2">
                            <h2 class="text-base font-bold">{{ trans('products') }}</h2>
                            <span id="returnSaleProductsBadge"
                                  class="inline-flex items-center justify-center w-5 h-5 text-xs font-semibold rounded-full bg-blue-100 text-blue-700">0</span>
                        </div>
                    </div>
                    <div class="p-3 pt-2 flex-1 min-h-0 overflow-auto">
                        <p class="text-sm text-slate-500 mb-3">
                            <i class="fa-solid fa-circle-info mr-1"></i>
                            {{ trans('selected-lines-will-be-sent-as-negative-sale') }}
                        </p>
                        <div class="overflow-x-auto">
                            <table class="w-full text-[13px]">
                                <thead>
                                <tr class="bg-slate-50 text-slate-600 font-semibold text-xs uppercase">
                                    <th class="px-2 py-2 w-8 text-center"></th>
                                    <th class="px-2 py-2 text-left">{{ trans('product') }}</th>
                                    <th class="px-2 py-2 text-right w-24">{{ trans('price') }}</th>
                                    <th class="px-2 py-2 text-center w-16">{{ trans('qty-sold') }}</th>
                                    <th class="px-2 py-2 text-center w-20">Devuelto</th>
                                    <th class="px-2 py-2 text-center w-20">{{ trans('available') }}</th>
                                </tr>
                                </thead>
                                <tbody id="returnSaleProductsView">
                                {# rendered by returnSaleProductsTemplate #}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="bg-slate-200 p-3 text-sm">
                        <i class="fa-solid fa-circle-info fa-fw"></i>
                        <span>Importante: Verifica que los productos estén en buen estado y cuenten con su empaque original.</span>
                    </div>
                </div>
            </div>

            {# ─── Sales Product Returns ─── #}
            <div class="lg:col-span-5 flex flex-col min-h-0">
                <div class="bg-white rounded-lg border-2 border-t-4 border-slate-300 flex flex-col flex-1 min-h-0 overflow-hidden">
                    <div class="flex items-center justify-between px-4 pt-3 pb-0 shrink-0">
                        <div class="flex items-center gap-2">
                            <h2 class="text-base font-bold">{{ trans('to-refund') }}</h2>
                            <span id="returnSaleCartBadge"
                                  class="inline-flex items-center justify-center w-5 h-5 text-xs font-semibold rounded-full bg-blue-100 text-blue-700">0</span>
                        </div>
                        <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-lg border border-red-200 text-red-700 hover:bg-red-50 transition-colors"
                                data-action="returns:cart:clear:action">
                            <i class="fa-solid fa-trash-can"></i>
                            Vaciar carrito
                        </button>
                    </div>

                    {# Products to return #}
                    <div id="returnSaleCartView" class="p-3 flex flex-col gap-3 flex-1 min-h-0 overflow-auto">
                        {# rendered by returnSaleCartTemplate #}
                    </div>

                    {# ─── Return Summary ─── #}
                    <div class="bg-slate-200 px-4 py-3 mt-auto shrink-0">
                        <div class="flex items-start gap-3">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center">
                                    <i class="fa-solid fa-rotate-left text-lg"></i>
                                </div>
                                <div>
                                    <div class="font-semibold text-sm text-slate-500">{{ trans('return-total') }}</div>
                                    <div id="returnSaleTotalView"
                                         class="text-4xl font-bold text-slate-900 leading-none"></div>
                                </div>
                            </div>
                            <div class="flex-1">
                                <div class="flex justify-end gap-3 text-sm text-slate-500 mt-1">
                                    <span>{{ trans('subtotal') }}:
                                        <span id="returnSaleSubtotal"
                                              class="font-semibold text-slate-900">0.00</span></span>
                                    <span>{{ trans('discount') }}:
                                        <span id="returnSaleDiscount"
                                              class="font-semibold text-slate-900">0.00</span></span>
                                </div>
                                <div class="flex justify-end gap-3 text-sm text-slate-500 mt-1">
                                    <span>{{ trans('total') }}: <span id="returnSaleTotalAmount"
                                                                      class="font-semibold text-blue-600">0.00</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script id="returnSaleSearchResultTemplate" type="text/template">
    <% if (!order) { %>
    <div class="p-3 text-center text-sm text-slate-500">
        <i class="fa-regular fa-circle-info mr-1"></i> Busca y selecciona una venta para iniciar la devoluci&oacute;n.
    </div>
    <% } else { %>
    <div class="p-3">
        <div class="flex flex-wrap items-center gap-3">
            <div class="flex-none w-12 h-12 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg select-none">
                <%= (order.nombrecliente || 'XX').charAt(0).toUpperCase() %>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="font-bold"><%= order.codigo %></span>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-green-100 text-green-700">Completada</span>
                </div>
                <div class="flex flex-wrap gap-3 text-sm text-slate-500 mt-1">
                    <span><i class="fa-regular fa-calendar mr-1"></i><%= order.fecha %> <%= order.hora %></span>
                    <span><i class="fa-regular fa-user mr-1"></i><%= order.nombrecliente %></span>
                </div>
            </div>
            <div class="flex-none text-right">
                <div class="text-sm text-slate-500">{{ trans('total') }}</div>
                <div class="font-bold text-lg"><%= Number.parseFloat(order.total).toFixed(2) %></div>
                <div class="text-sm text-green-600 font-semibold">
                    <i class="fa-regular fa-circle-check mr-1"></i>Pagado: <%= Number.parseFloat(order.total).toFixed(2)
                    %>
                </div>
            </div>
        </div>
    </div>
    <% } %>
</script>

<script id="returnSaleAlreadyRefundedTemplate" type="text/template">
    <tr>
        <td colspan="6" class="px-2 py-8 text-center">
            <div class="flex flex-col items-center justify-center text-amber-600 gap-2">
                <i class="fa-solid fa-circle-exclamation text-3xl"></i>
                <span class="text-sm font-semibold">Esta venta ya fue devuelta completamente.</span>
                <span class="text-xs text-slate-500">No hay productos disponibles para devolver.</span>
            </div>
        </td>
    </tr>
</script>

<script id="returnSaleProductsTemplate" type="text/template">
    <% if (!lines || lines.length === 0) { %>
    <tr>
        <td colspan="6" class="px-2 py-8 text-center text-sm text-slate-400">
            <i class="fa-solid fa-box mr-1"></i> Sin productos para devolver
        </td>
    </tr>
    <% } else { %>
    <% lines.forEach(function(line) { %>
    <tr class="return-product-row border-b border-slate-100 hover:bg-slate-50 transition-colors"
        data-line="<%= line.idlinea %>">
        <td class="px-2 py-2 text-center">
            <input class="h-4 w-4 rounded border-slate-300 text-blue-600 return-product-check" type="checkbox"
                   value="<%= line.idlinea %>"
                   data-refundable="<%= line.refundable %>"
                   aria-label="<%= line.descripcion %>"
            <%= parseFloat(line.refundable) > 0 ? '' : 'disabled' %> >
        </td>
        <td class="px-2 py-2">
            <div class="flex items-center gap-2">
                <div class="product-thumb w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center shrink-0 transition-colors">
                    <i class="fa-solid fa-box text-slate-400 text-base"></i>
                </div>
                <div class="min-w-0">
                    <div class="font-semibold truncate max-w-[260px]"><%= line.descripcion %></div>
                    <div class="text-[11px] text-slate-500"><%= line.referencia %></div>
                </div>
            </div>
        </td>
        <td class="px-2 py-2 text-right font-semibold whitespace-nowrap"><%=
            (parseFloat(line.pvpunitario) || 0).toFixed(2) %>
        </td>
        <td class="px-2 py-2 text-center">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-blue-100 text-blue-700"><%= line.cantidad %></span>
        </td>
        <td class="px-2 py-2 text-center">
            <% if (parseFloat(line.refunded) > 0) { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-yellow-100 text-yellow-700"><%= line.refunded %></span>
            <% } else { %>
            <span class="text-xs text-slate-400">0</span>
            <% } %>
        </td>
        <td class="px-2 py-2 text-center">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-green-100 text-green-700"><%= parseFloat(line.refundable) || 0 %></span>
            <div class="text-[10px] text-green-600 font-semibold">{{ trans('available') }}</div>
        </td>
    </tr>
    <% }); %>
    <% } %>
</script>

<script id="returnSaleCartTemplate" type="text/template">
    <% if (!items || items.length === 0) { %>
    <div class="flex flex-col items-center justify-center py-8 text-slate-400">
        <i class="fa-solid fa-cart-plus text-3xl mb-2"></i>
        <span class="text-sm">Selecciona productos para devolver</span>
    </div>
    <% } else { %>
    <% items.forEach(function(item) { %>
    <div class="return-item-card rounded-xl border border-slate-200 p-3 bg-white flex flex-col gap-2 transition-shadow hover:shadow-sm"
         data-line="<%= item.idlinea %>">
        <div class="flex items-start gap-2">
            <div class="w-11 h-11 rounded-lg bg-slate-100 flex items-center justify-center shrink-0">
                <i class="fa-solid fa-box text-slate-400 text-lg"></i>
            </div>
            <div class="flex-1 min-w-0">
                <div class="font-semibold text-sm truncate"><%= item.descripcion %></div>
                <div class="text-[11px] text-slate-500">SKU: <%= item.referencia %></div>
                <div class="text-sm text-slate-500">Precio unitario: <span class="font-semibold text-slate-900"><%= (parseFloat(item.pvpunitario) || 0).toFixed(2) %></span>
                </div>
            </div>
            <button class="inline-flex items-center justify-center w-7 h-7 text-sm text-red-600 hover:bg-red-50 rounded-lg transition-colors shrink-0 return-cart-remove"
                    data-line="<%= item.idlinea %>" title="Eliminar">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-1">
                <button class="return-qty-minus inline-flex items-center justify-center w-8 h-8 text-sm rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100 transition-colors"
                        data-line="<%= item.idlinea %>">
                    <i class="fa-solid fa-minus"></i>
                </button>
                <input type="number"
                       class="form-control form-control-sm text-center return-qty-input w-14"
                       value="<%= item.cantidad %>"
                       min="0"
                       max="<%= item.maxQty %>"
                       step="1"
                       data-line="<%= item.idlinea %>"
                       data-price="<%= item.pvpunitario %>">
                <button class="return-qty-plus inline-flex items-center justify-center w-8 h-8 text-sm rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100 transition-colors"
                        data-line="<%= item.idlinea %>">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
            <div class="text-right">
                <div class="text-sm text-slate-500">M&aacute;x: <%= item.maxQty %></div>
                <div class="font-bold text-blue-600 return-item-total"
                     data-price="<%= item.pvpunitario %>"><%= Number.parseFloat(item.cantidad *
                    item.pvpunitario).toFixed(2) %>
                </div>
            </div>
        </div>
    </div>
    <% }); %>
    <% } %>
</script>

<style>
    .return-product-row:hover .product-thumb {
        background-color: #e2e8f0;
    }

    .return-qty-input::-webkit-inner-spin-button,
    .return-qty-input::-webkit-outer-spin-button {
        opacity: 1;
    }
</style>
