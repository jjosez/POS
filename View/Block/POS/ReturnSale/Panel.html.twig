<section id="returnSalePane"
         class="hidden w-full md:w-1/2 bg-white md:border-r border-slate-200
                flex-col min-h-0 h-full shadow-sm">

    <!-- Header -->
    <div class="shrink-0 border-b border-solid border-slate-200">
        <div class="flex items-start justify-between gap-3 p-4">
            <div>
                <p class="text-xs font-semibold text-slate-500">{{ trans('refund') }}</p>
                <h2 class="text-lg font-bold tracking-tight">{{ trans('new-refund') }}</h2>
            </div>
            <button class="btn btn-light btn-sm rounded-2 d-flex align-items-center gap-1"
                    data-action="returns:fullscreen:show"
                    title="Pantalla completa">
                <i class="fa-solid fa-expand"></i>
            </button>
            <button class="btn btn-icon btn-naked" id="returnSaleCloseBtn"
                    title="{{ trans('close') }}">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>
        <div class="border-b border-slate-200 bg-slate-50 p-4">
            <form id="returnSaleSearchForm" class="flex flex-col gap-2 md:flex-row md:items-center">
                <div class="flex-1 form-group">
                    <input id="searchSaleInput"
                           class="font-normal form-control"
                           type="text"
                           placeholder="{{ trans('search-sale-to-return') }}"
                           autocomplete="off">
                </div>
                <button type="button" class="btn btn-primary"
                        data-action="returns:sale-search:action">{{ trans('search') }}</button>
                <button type="button" class="btn btn-light"
                        data-action="returns:sale-last:action">{{ trans('last-orders') }}</button>
            </form>
            <div id="returnSaleSearchResultView" class="mt-3"></div>
        </div>
    </div>

    <!-- Lines (scrollable) -->
    <div class="flex-1 min-h-0 overflow-auto">
        <div id="returnSaleLinesTemplateView" class="p-4"></div>
    </div>

    <!-- Summary & confirm -->
    <div class="shrink-0 border-t border-solid border-slate-200">
        <div id="returnSaleSummaryView" class="hidden p-4">
            <div class="flex items-center justify-between rounded-lg bg-slate-100 p-3 text-sm">
                <div>
                    <span class="text-slate-500">{{ trans('total') }}:</span>
                    <span id="returnSaleDocTotal" class="font-semibold">0,00</span>
                </div>
                <div class="text-right">
                    <span class="text-red-600">
                        <span class="text-slate-500">{{ trans('return-total') }}:</span>
                        <span id="returnSaleTotalView" class="text-lg font-semibold">0,00</span>
                    </span>
                </div>
            </div>
        </div>
        <div class="flex items-center justify-between gap-3 p-4">
            <div class="text-xs text-slate-500">
                <span class="font-semibold">{{ trans('info') }}:</span>
                {{ trans('selected-lines-will-be-sent-as-negative-sale') }}
            </div>
            <div class="flex items-center gap-2">
                <button type="button" class="btn btn-light"
                        data-action="returns:sale-clear:action">
                    <i class="fa fw fa-eraser"></i>
                    {{ trans('cancel') }}
                </button>
                <button type="button"
                        class="btn btn-danger px-6 font-bold"
                        id="returnSaleConfirmBtn"
                        data-action="returns:sale-confirm:action"
                        disabled>
                    <i class="fa fw fa-rotate-left"></i> {{ trans('apply-return') }}
                </button>
            </div>
        </div>
    </div>
</section>

<script id="returnSaleSearchResultTemplate" type="text/template">
    <% if (!order) { %>
    <div class="rounded-lg bg-blue-50 p-2 text-xs text-slate-600">
        <i class="fa fw fa-info-circle"></i>
        {{ trans('search-sale-to-return') }}
    </div>
    <% } else { %>
    <div class="flex flex-col rounded-lg bg-white p-3 shadow-xs md:flex-row md:items-center">
        <div class="flex-1 text-xs md:text-sm">
            <div>
                <span class="font-semibold uppercase text-slate-500">{{ trans('code') }}:</span>
                <%= order.codigo %>
            </div>
            <div>
                <span class="font-semibold uppercase text-slate-500">{{ trans('customer') }}:</span>
                <%= order.nombrecliente %>
            </div>
            <div>
                <span class="font-semibold uppercase text-slate-500">{{ trans('date') }}:</span>
                <%= order.fecha %> <%= order.hora %>
            </div>
            <div>
                <span class="font-semibold uppercase text-slate-500">{{ trans('total') }}:</span>
                <%= Number.parseFloat(order.total).toFixed(2) %>
            </div>
        </div>
    </div>
    <% } %>
</script>
<script id="returnSaleLinesTemplate" type="text/template">
    <% if (!lines || lines.length === 0) { %>
    <div class="mt-4 rounded-lg bg-blue-50 p-3 text-sm">
        {{ trans('no-lines-for-return') }}
    </div>
    <% } else { %>

    <!-- HEADER -->
    <div class="mt-3 hidden md:flex items-center rounded-lg bg-slate-800 p-2 text-xs font-semibold uppercase text-white">
        <div class="flex-1">{{ trans('item') }}</div>
        <div class="w-20 text-center">{{ trans('quantity') }}</div>
        <div class="w-28 text-center">{{ trans('to-refund') }}</div>
        <div class="w-24 text-right">{{ trans('price') }}</div>
        <div class="w-24 text-right">{{ trans('total') }}</div>
    </div>

    <% lines.forEach(function(line) { %>
    <!-- ROW -->
    <div class="return-sale-row mt-2 flex flex-col rounded-lg bg-slate-100 p-2 text-xs shadow-xs md:flex-row md:items-center hover:bg-yellow-50"
         data-line="<%= line.idlinea %>">
        <input type="hidden" value="<%= line.idlinea %>">
        <!-- ITEM -->
        <div class="mt-1 flex-1 md:mt-0 md:px-2">
            <div class="font-semibold text-slate-800">
                <%= line.referencia %> - <%= line.descripcion %>
            </div>
            <div class="text-[10px] text-slate-500 md:hidden">
                {{ trans('qty-sold') }}: <%= line.cantidad %> ·
                {{ trans('price') }}: <%= line.pvpunitario %> ·
                <span class="text-orange-600">{{ trans('available') }}: <%= line.refundable %></span>
            </div>
        </div>
        <!-- QTY SOLD -->
        <div class="mt-1 flex items-center justify-between md:mt-0 md:w-20 md:flex-col md:gap-0">
            <span class="text-[10px] uppercase text-slate-400 md:hidden">{{ trans('quantity') }}</span>
            <span class="text-slate-700 font-medium"><%= line.cantidad %></span>
        </div>
        <!-- QTY TO RETURN -->
        <div class="mt-1 flex items-center gap-1 md:mt-0 md:w-28 md:justify-center">
            <span class="text-[10px] uppercase text-slate-400 md:hidden">{{ trans('to-refund') }}</span>
            <div class="flex items-center gap-1">
                <input type="number"
                       min="0"
                       step="any"
                       max="<%= line.refundable %>"
                       value="0"
                       class="return-qty-input form-control form-control-sm w-20 text-right"
                       data-line="<%= line.idlinea %>"
                       data-price="<%= line.pvpunitario %>"
                       data-refundable="<%= line.refundable %>">
                <% if (parseFloat(line.refundable) > 0) { %>
                <button type="button"
                        class="return-qty-max text-[10px] px-1.5 py-0.5 rounded bg-orange-100 text-orange-700 hover:bg-orange-200 font-semibold leading-none"
                        data-line="<%= line.idlinea %>"
                        data-max="<%= line.refundable %>">
                    {{ trans('max') }}
                </button>
                <% } %>
            </div>
        </div>
        <!-- PRICE -->
        <div class="mt-1 flex items-center justify-between md:mt-0 md:w-24 md:justify-end md:px-2">
            <span class="text-[10px] uppercase text-slate-400 md:hidden">{{ trans('price') }}</span>
            <span><%= line.pvpunitario %></span>
        </div>
        <!-- TOTAL -->
        <div class="mt-1 flex items-center justify-between md:mt-0 md:w-24 md:justify-end md:px-2">
            <span class="text-[10px] uppercase text-slate-400 md:hidden">{{ trans('total') }}</span>
            <span class="return-line-total font-semibold text-red-600"
                  data-line="<%= line.idlinea %>">0,00</span>
        </div>
    </div>
    <% }); %>
    <% } %>
</script>
