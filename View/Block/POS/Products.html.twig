<div class="flex p-4">
    <label class="flex-1 text-gray-400 input-icon">
        <span><i class="fa fa-sm fa-search"></i></span>
        <input type="search" id="productSearchBox" placeholder="{{ trans('search') }}">
    </label>
    <button id="productFilterButton" class="ml-2 bg-gray-200 text-slate-800 btn focus:ring-gray-600"
            data-toggle="modal" data-target="productFilterModal">
        <i class="fa fa-tags"></i>
        <span id="productFilterLabel" class="mx-2">{{ trans('filters') }}</span>
    </button>
</div>
<div id="familyList" class="mb-4 flex flex-wrap gap-2 px-4">
</div>
<div class="mb-4 flex-1 overflow-y-auto px-4">
    <div id="productSearchListTemplateView" role="list">
        {# {{ _self.freeProductLineTemplate() }} #}
        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            {% for product in fsc.getHomeProducts() %}
                <div role="listitem"
                     class="flex flex-col rounded-lg p-4 text-xs bg-white shadow-xs product-add-btn
                            {{ product.isOutOfStock ? 'pointer-events-none opacity-75' : 'cursor-pointer' }}"
                     data-action="cart:product:add"
                     data-code="{{ product.code }}"
                     data-description="{{ product.description }}"
                     data-thumbnail="{{ product.thumbnail }}">
                    <!-- Imagen -->
                    <div class="relative mb-3 pointer-events-none">
                        {% if product.thumbnail %}
                            <img class="w-full h-24 rounded-md object-contain"
                                 src="{{ product.thumbnail }}"
                                 alt="{{ product.code }}"
                                 loading="lazy">
                            <button type="button"
                                    class="text-sm absolute top-1 right-1 w-10 h-10 flex items-center justify-center
                                       rounded-full bg-white/80 text-gray-600 pointer-events-auto cursor-pointer"
                                    title="{{ trans('view-image')|default('Ver imagen') }}"
                                    data-action="product:image:show"
                                    data-id="{{ product.id }}"
                                    data-code="{{ product.code }}">
                                <i class="fas fa-eye pointer-events-none"></i>
                            </button>
                        {% else %}
                            <div class="w-full h-24 flex items-center justify-center bg-gray-100 rounded-md pointer-events-auto">
                                <i class="fas fa-image fa-2x text-gray-400"></i>
                            </div>
                        {% endif %}
                    </div>
                    <!-- Descripción -->
                    <div class="flex-1 text-center mb-3">
                        <span class="font-semibold uppercase text-gray-800">
                            {{ product.code }}
                        </span>
                        <p class="italic text-gray-600">{{ product.description }}</p>
                        {% if product.detail %}
                            <p>{{ product.detail }}</p>
                        {% endif %}
                    </div>
                    <!-- Precio / Stock -->
                    <div class="mt-auto pt-2 border-t border-dashed border-gray-200 flex items-center justify-between text-sm">
                        <span class="font-semibold text-blue-500">
                            <i class="fa-solid fa-tag fa-fw"></i> {{ product.priceWithFormat }}
                        </span>
                        <span class="pointer-events-auto font-medium text-gray-900"
                              data-action="product:stock:show"
                              data-code="{{ product.code }}">
                            <i class="fa-solid fa-dolly-flatbed fa-fw pointer-events-none"></i> {{ product.stock | default('0') }}
                        </span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
<div class="flex h-auto select-none flex-row bg-white p-4 md:hidden">
    <button class="btn btn-primary btn-block" data-toggle="block" data-target="cartMainView"
            data-ontoggle="productMainView">
        <span class="mr-auto">Carrito</span>
        <i class="fas fa-shopping-cart fa-fw"></i>
    </button>
</div>
<script id="productSearchListTemplate" type="text/template">
    {# {{ _self.freeProductLineTemplate() }} #}
    <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <% products.forEach(function(product){ %>
        <div role="listitem"
             class="flex flex-col rounded-lg p-4 text-xs bg-white shadow-xs product-add-btn
                    <%= product.isOutOfStock ? 'pointer-events-none opacity-75' : 'cursor-pointer' %>"
             data-action="cart:product:add"
             data-code="<%= product.code %>"
             data-description="<%= product.description %>"
             data-thumbnail="<%= product.thumbnail %>">
            <!-- Imagen -->
            <div class="relative mb-3 pointer-events-none">
                <% if (product.thumbnail) { %>
                <img class="w-full h-24 rounded-md object-contain"
                     src="<%= product.thumbnail %>"
                     alt="<%= product.code %>"
                     loading="lazy">
                <button type="button"
                        class="text-sm absolute top-1 right-1 w-10 h-10 flex items-center justify-center
                            rounded-full bg-white/80 text-gray-600 pointer-events-auto cursor-pointer"
                        title="{{ trans('view-image')|default('Ver imagen') }}"
                        data-action="product:image:show"
                        data-id="<%= product.id %>"
                        data-code="<%= product.code %>">
                    <i class="fas fa-eye pointer-events-none"></i>
                </button>
                <% } else { %>
                <div class="w-full h-24 flex items-center justify-center bg-gray-100 rounded-md pointer-events-auto">
                    <i class="fas fa-image fa-2x text-gray-400"></i>
                </div>
                <% } %>
            </div>
            <!-- Descripción -->
            <div class="flex-1 text-center mb-3">
                <span class="font-semibold uppercase text-gray-800">
                    <%= product.code %>
                </span>
                <p class="italic text-gray-600"><%= product.description %></p>
                <% if(product.detail) { %>
                <p><%= product.detail %></p>
                <% } %>
            </div>
            <!-- Precio / Stock -->
            <div class="mt-auto pt-2 border-t border-dashed border-gray-200 flex items-center justify-between text-sm">
                <span class="font-semibold text-blue-500">
                    <i class="fa-solid fa-tag fa-fw"></i> <%= product.priceWithFormat %>
                </span>
                <span class="pointer-events-auto font-medium text-gray-900"
                      data-action="product:stock:show"
                      data-code="<%= product.code %>">
                    <i class="fa-solid fa-dolly-flatbed fa-fw pointer-events-none"></i> <%= product.stock | 0 %>
                </span>
            </div>
        </div>
        <% }) %>
    </div>
</script>

{% macro freeProductLineTemplate() %}
    <div role="listitem"
         class="mb-4 flex cursor-pointer rounded-lg bg-white p-4 shadow-xs product-add-btn"
         data-action="cart:product:add"
         data-code=""
         data-description="Producto Generico">
        <div class="mr-4 flex items-center">
            <span class="text-sky-500"><i class="fas fa-2x fa-tags"></i></span>
        </div>
        <div class="flex-1 text-sm">
            <p class="text-sm uppercase text-gray-600">
                {{ trans('free-product-line') }}</p>
            <span class="mt-1 inline-block rounded-full bg-green-100 px-3 text-xs font-semibold text-green-800 py-0.5">
                    {{ money(0) }}</span>
            <span class="mt-1 inline-block rounded-full bg-blue-100 px-3 text-xs font-semibold text-blue-800 py-0.5">
                    &infin; {{ trans('unlimited') }}</span>
        </div>
    </div>
{% endmacro %}
