<div class="sticky top-[57px] z-30 m-4 rounded-xl bg-white p-3 ring-1 ring-slate-200">
    <div class="flex flex-col gap-2 md:flex-row md:items-center">
        <!-- Search -->
        <div class="relative flex-1">
            <label class="flex-1 text-gray-400 input-icon">
                <span><i class="fa fa-sm fa-search"></i></span>
                <input id="productSearchBox"  class="rounded-xl border border-slate-200 bg-slate-50"
                       type="search" placeholder="{{ trans('search') }} SKU, {{ trans('code') }}, {{ trans('name') }}">
            </label>
        </div>

        <!-- Actions -->
        <div class="flex gap-2">
            <button class="btn btn-light rounded-lg text-sm font-semibold gap-2"
                    data-toggle="modal" data-target="product:filter:modal">
                <i class="fa-solid fa-filter text-slate-500"></i> {{ trans('filters') }}
            </button>
            {% if context.terminal().free_cart_lines %}
                <button class="btn gap-2 rounded-lg bg-slate-900 text-sm font-extrabold text-white
                     hover:bg-slate-800 active:bg-slate-950"
                        data-action="ui:cart:line:add"
                        data-code=""
                        data-description="{{ trans('generic') }}">
                    <i class="fa-solid fa-plus-circle"></i> {{ trans('free-product-line') }}
                </button>
            {% endif %}
        </div>
    </div>
</div>
<div id="product:filter:family:view" class="mb-4 flex flex-wrap gap-2 px-4">
</div>
<div class="mb-4 flex-1 overflow-y-auto px-4">
    <div id="product:search:list:view" class="mt-1" role="list">
        {% set mode = terminal.product_display_mode | default('grid') %}
        {{ _self.productView(fsc, terminal, mode) }}
    </div>
</div>
<div class="flex h-auto select-none flex-row bg-white p-4 md:hidden">
    <button class="btn btn-primary btn-block" data-toggle="block" data-target="cartMainView"
            data-ontoggle="productMainView">
        <span class="mr-auto">Carrito</span>
        <i class="fas fa-shopping-cart fa-fw"></i>
    </button>
</div>
<script id="product:search:template" type="text/template">
    <div class="<%= mode === 'grid' ? 'grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4' : 'flex flex-col gap-3' %>">
        <% products.forEach(function(product){ %>
        <div role="listitem"
             class="group rounded-lg bg-white p-3 ring-1 transition product-add-btn <%= mode === 'grid' ? 'flex flex-col' : '' %>
                    <%= product.isOutOfStock
                        ? 'ring-red-200 opacity-70 cursor-default'
                        : 'ring-slate-200 hover:ring-slate-300 hover:shadow-sm active:scale-[0.99] cursor-pointer' %>"
             data-action="<%= product.isOutOfStock ? '' : 'ui:cart:line:add' %>"
             data-code="<%= product.code %>"
             data-description="<%= product.description %>"
             data-thumbnail="<%= product.thumbnail %>">

            <div class="<%= mode === 'grid' ? 'flex flex-col h-full' : 'flex gap-3' %>">
                {# Thumbnail #}
                <div class="relative <%= mode === 'grid' ? 'mb-3 h-28 w-full' : 'h-14 w-14 xl:h-16 xl:w-16' %> shrink-0 flex items-center justify-center overflow-hidden rounded-md bg-slate-100 text-slate-400">
                    <% if (product.thumbnail) { %>
                    <img class="h-full w-full object-cover"
                         src="<%= product.thumbnail %>"
                         alt="<%= product.code %>"
                         loading="lazy" decoding="async">

                    {# Overlay zoom button #}
                    <button type="button"
                            class="absolute <%= mode === 'grid' ? 'top-1 right-1 w-10 h-10 rounded-full bg-white/80 text-gray-600' : 'inset-0 bg-black/0 md:hover:bg-black/40' %> z-10 flex items-center justify-center transition-colors group pointer-events-auto"
                            title="{{ trans('view-image') }}"
                            data-action="product:image:show"
                            data-id="<%= product.id %>"
                            data-code="<%= product.code %>">
                        <i class="<%= mode === 'grid' ? 'fas fa-eye' : 'fas fa-search-plus text-white opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity' %> pointer-events-none"></i>
                    </button>
                    <% } else { %>
                    <i class="fas fa-image <%= mode === 'grid' ? 'text-2xl' : 'text-xl xl:text-2xl' %> text-slate-300"></i>
                    <% } %>
                </div>

                {# Content #}
                <div class="min-w-0 flex-1">
                    <div class="<%= mode === 'grid' ? 'flex flex-col h-full text-center' : 'flex items-start justify-between gap-3' %>">
                        <div class="min-w-0 <%= mode === 'grid' ? 'flex-1' : '' %>">
                            <p class="text-xs font-semibold text-slate-500 <%= mode === 'grid' ? 'uppercase text-slate-800' : 'truncate' %>">
                                <%= product.code %>
                            </p>
                            <p class="mt-0.5 <%= mode === 'grid' ? 'italic text-slate-600' : 'text-sm font-semibold leading-snug line-clamp-2' %>">
                                <%= product.description %>
                            </p>
                            <% if (product.detail) { %>
                            <p class="mt-0.5 text-xs text-slate-500 italic truncate">
                                <%= product.detail %>
                            </p>
                            <% } %>
                            {# Badges / meta #}
                            <div class="mt-2 flex flex-wrap <%= mode === 'grid' ? 'justify-center' : '' %> items-center gap-2 text-xs">
                                <% if (product.isOutOfStock) { %>
                                <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 font-semibold text-red-700">
                                    <i class="fa-solid fa-ban mr-1"></i> {{ trans('out-of-stock') }}
                                </span>
                                <% } %>
                                <span class="pointer-events-auto inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-slate-600 hover:bg-slate-300"
                                      data-action="product:stock:show"
                                      data-code="<%= product.code %>">
                                        Stock: <%= (product.stock ?? 0) %>
                                    </span>

                                <% if (product.family) { %>
                                <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-slate-600">
                                        <%= product.family %>
                                    </span>
                                <% } %>
                                <% if (product.brandname) { %>
                                <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 font-semibold text-blue-700">
                                        <%= product.brandname %>
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        {# Price + CTA #}
                        <div class="<%= mode === 'grid' ? 'mt-auto pt-2 border-t border-slate-200 flex items-center justify-center' : 'flex-shrink-0 text-right' %>">
                            <div class="<%= mode === 'grid' ? 'text-base' : 'text-lg' %> font-extrabold text-slate-900">
                                <%= product.priceWithFormat %>
                            </div>
                            <% if (!product.isOutOfStock && mode === 'list') { %>
                            <div class="mt-1 text-xs text-slate-500">
                                {{ trans('touch-to-add') }}
                            </div>
                            <% } else if (product.isOutOfStock && mode === 'list') { %>
                            <button type="button"
                                    class="mt-2 cursor-not-allowed rounded-lg bg-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-500"
                                    disabled>
                                {{ trans('not-available') }}
                            </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</script>

{% macro productView(fsc, terminal, mode) %}
    <div class="{{ mode == 'grid' ? 'grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4' : 'flex flex-col gap-3' }}">
        {% for product in fsc.getHomeProducts() %}
            {% set cardState = product.isOutOfStock
                ? 'ring-red-200 opacity-70 cursor-default'
                : 'ring-slate-200 hover:ring-slate-300 hover:shadow-sm active:scale-[0.99] cursor-pointer' %}
            {% set actionAttr = product.isOutOfStock ? '' : 'ui:cart:line:add' %}

            <div role="listitem"
                 class="group rounded-lg bg-white p-3 ring-1 transition product-add-btn {{ mode == 'grid' ? 'flex flex-col' : '' }} {{ cardState }}"
                 data-action="{{ actionAttr }}"
                 data-code="{{ product.code }}"
                 data-description="{{ product.description }}"
                 data-thumbnail="{{ product.thumbnail }}">

                <div class="{{ mode == 'grid' ? 'flex flex-col h-full' : 'flex gap-3' }}">
                    {# Thumbnail #}
                    <div class="relative {{ mode == 'grid' ? 'mb-3 h-28 w-full' : 'h-14 w-14 xl:h-16 xl:w-16' }} shrink-0 flex items-center justify-center overflow-hidden rounded-md bg-slate-100 text-slate-400">
                        {% if product.thumbnail %}
                            <img class="h-full w-full object-cover"
                                 src="{{ product.thumbnail }}"
                                 alt="{{ product.code }}"
                                 loading="lazy" decoding="async">

                            <button type="button"
                                    class="absolute {{ mode == 'grid' ? 'top-1 right-1 w-10 h-10 rounded-full bg-white/80 text-gray-600' : 'inset-0 bg-black/0 md:hover:bg-black/40' }} z-10 flex items-center justify-center transition-colors group pointer-events-auto"
                                    title="{{ trans('view-image') }}"
                                    data-action="product:image:show"
                                    data-id="{{ product.id }}"
                                    data-code="{{ product.code }}">
                                <i class="{{ mode == 'grid' ? 'fas fa-eye' : 'fas fa-search-plus text-white opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity' }} pointer-events-none"></i>
                            </button>
                        {% else %}
                            <i class="fas fa-image {{ mode == 'grid' ? 'text-2xl' : 'text-xl xl:text-2xl' }} text-slate-300"></i>
                        {% endif %}
                    </div>

                    {# Content #}
                    <div class="min-w-0 flex-1">
                        <div class="{{ mode == 'grid' ? 'flex flex-col h-full text-center' : 'flex items-start justify-between gap-3' }}">
                            <div class="min-w-0 {{ mode == 'grid' ? 'flex-1' : '' }}">
                                <p class="text-xs font-semibold {{ mode == 'grid' ? 'uppercase text-slate-800' : 'text-slate-500 truncate' }}">
                                    {{ product.code }}
                                </p>
                                <p class="mt-0.5 {{ mode == 'grid' ? 'italic text-slate-600' : 'text-sm font-semibold leading-snug line-clamp-2' }}">
                                    {{ product.description }}
                                </p>
                                {% if product.detail %}
                                    <p class="mt-0.5 text-xs text-slate-500 italic truncate">
                                        {{ product.detail }}
                                    </p>
                                {% endif %}
                                {# Badges / meta #}
                                <div class="mt-2 flex flex-wrap {{ mode == 'grid' ? 'justify-center' : '' }} items-center gap-2 text-xs">
                                    {% if product.isOutOfStock %}
                                        <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 font-semibold text-red-700">
                                            <i class="fa-solid fa-ban mr-1"></i> {{ trans('out-of-stock') }}
                                        </span>
                                    {% endif %}
                                    <span class="pointer-events-auto inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-slate-600 hover:bg-slate-300"
                                          data-action="product:stock:show"
                                          data-code="{{ product.code }}">
                                        Stock: {{ product.stock | default('0') }}
                                    </span>

                                    {% if product.family %}
                                        <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-slate-600">
                                            {{ product.family }}
                                        </span>
                                    {% endif %}
                                    {% if product.brandname %}
                                        <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 font-semibold text-blue-700">
                                            {{ product.brandname }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            {# Price + CTA #}
                            <div class="{{ mode == 'grid' ? 'mt-auto pt-2 border-t border-slate-200 flex items-center justify-center' : 'flex-shrink-0 text-right' }}">
                                <div class="{{ mode == 'grid' ? 'text-base' : 'text-lg' }} font-extrabold text-slate-900">
                                    {{ product.priceWithFormat }}
                                </div>
                                {% if not product.isOutOfStock and mode == 'list' %}
                                    <div class="mt-1 text-xs text-slate-500">
                                        {{ trans('touch-to-add') }}
                                    </div>
                                {% elseif product.isOutOfStock and mode == 'list' %}
                                    <button type="button"
                                            class="mt-2 cursor-not-allowed rounded-lg bg-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-500"
                                            disabled>
                                        {{ trans('not-available') }}
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}
