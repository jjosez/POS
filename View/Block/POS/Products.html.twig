<div class="flex p-4">
    <label class="flex-1 text-gray-400 input-icon">
        <span><i class="fa fa-sm fa-search"></i></span>
        <input type="search" id="productSearchBox" placeholder="{{ trans('search') }}">
    </label>
    <button id="productFilterButton" class="ml-2 bg-gray-200 text-slate-800 btn focus:ring-gray-600"
            data-toggle="modal" data-target="productFilterModal">
        <i class="fa fa-tags"></i>
        <span id="productFilterLabel" class="mx-2">{{ trans('filters') }}</span>
    </button>
</div>
<div id="familyList" class="mb-4 flex flex-wrap gap-2 px-4">
</div>
<div class="mb-4 flex-1 overflow-y-auto px-4">
    <div id="productSearchListTemplateView" role="list">
        {{ _self.freeProductLineTemplate() }}
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            {% for product in fsc.getHomeProducts() %}
                <div role="listitem"
                     class="flex cursor-pointer flex-col items-center rounded-lg bg-white p-4 text-xs shadow-sm product-add-btn"
                     data-action="setProductAction"
                     data-code="{{ product.code }}"
                     data-description="{{ product.description }}"
                     data-thumbnail="{{ product.thumbnail }}">
                    {% if product.thumbnail %}
                        <div>
                            <img class="pointer-events-auto h-20 w-20 rounded-md object-scale-down"
                                 src="{{ product.thumbnail }}"
                                 alt="{{ product.code }}"
                                 data-action="productImageAction"
                                 data-id="{{ product.id }}"
                                 data-code="{{ product.code }}">
                        </div>
                    {% else %}
                        <span><i class="fas fa-3x fa-image"></i></span>
                    {% endif %}
                    <div class="flex-1 text-center">
                        <span class="font-semibold uppercase text-gray-800">
                            {{ product.code }}
                        </span>
                        <p class="italic text-gray-600">{{ product.description }}</p>
                        {% if product.detail %}
                            <p>{{ product.detail }}</p>
                        {% endif %}
                    </div>
                    <div class="flex flex-col">
                        <span class="mt-auto inline-block rounded-full bg-green-100 px-3 font-semibold text-green-800 py-0.5">
                        {{ product.priceWithFormat }}</span>
                        <span class="pointer-events-auto mt-1 inline-block rounded-full bg-blue-100 px-3 font-semibold text-blue-800 py-0.5"
                              data-action="stockDetailAction"
                              data-code="{{ product.code }}">
                        {{ product.stock | default('0') }} {{ trans('available') }}</span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
<div class="flex h-auto select-none flex-row bg-white p-4 md:hidden">
    <button class="btn btn-primary btn-block" data-toggle="block" data-target="cartMainView"
            data-ontoggle="productMainView">
        <span class="mr-auto">Carrito</span>
        <i class="fas fa-shopping-cart fa-fw"></i>
    </button>
</div>
<script id="productSearchListTemplate" type="text/template">
    {{ _self.freeProductLineTemplate() }}
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        <% it.items.forEach(function(item){ %>
        <div role="listitem"
             class="flex cursor-pointer flex-col items-center rounded-lg bg-white p-4 text-xs shadow-sm product-add-btn"
             data-action="setProductAction"
             data-code="<%= item.code %>"
             data-description="<%= item.description %>"
             data-thumbnail="<%= item.thumbnail %>">
            <% if (item.thumbnail) { %>
            <div>
                <img class="pointer-events-auto h-20 w-20 rounded-md object-scale-down"
                     src="<%= item.thumbnail %>"
                     alt="<%= item.code %>"
                     data-action="productImageAction"
                     data-id="<%= item.id %>"
                     data-code="<%= item.code %>">
            </div>
            <% } else { %>
            <span><i class="fas fa-3x fa-image"></i></span>
            <% } %>
            <div class="flex-1 text-center">
                <span class="font-semibold uppercase text-gray-800">
                    <%= item.code %>
                </span>
                <p class="italic text-gray-600"><%= item.description %></p>
                <% if(item.detail) { %>
                <p><%= item.detail %></p>
                <% } %>
            </div>
            <div class="flex flex-col">
                <span class="mt-auto inline-block rounded-full bg-green-100 px-3 font-semibold text-green-800 py-0.5">
                <%= item.priceWithFormat %></span>
                <span class="pointer-events-auto mt-1 inline-block rounded-full bg-blue-100 px-3 font-semibold text-blue-800 py-0.5"
                      data-action="stockDetailAction"
                      data-code="<%= item.code %>">
                <%= item.stock | 0 %> {{ trans('available') }} </span>
            </div>
        </div>
        <% }) %>
    </div>
</script>

{% macro freeProductLineTemplate() %}
    <div role="listitem"
         class="mb-4 flex cursor-pointer rounded-lg bg-white p-4 shadow-sm product-add-btn"
         data-action="setProductAction"
         data-code=""
         data-description="Producto Generico">
        <div class="mr-4 flex items-center">
            <span class="text-sky-500"><i class="fas fa-2x fa-tags"></i></span>
        </div>
        <div class="flex-1 text-sm">
            <p class="text-sm uppercase text-gray-600">
                {{ trans('free-product-line') }}</p>
            <span class="mt-1 inline-block rounded-full bg-green-100 px-3 text-xs font-semibold text-green-800 py-0.5">
                    {{ money(0) }}</span>
            <span class="mt-1 inline-block rounded-full bg-blue-100 px-3 text-xs font-semibold text-blue-800 py-0.5">
                    &infin; {{ trans('unlimited') }}</span>
        </div>
    </div>
{% endmacro %}
