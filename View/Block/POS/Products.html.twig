<div class="flex p-4">
    <label class="flex-1 text-gray-400 input-icon">
        <span><i class="fa fa-sm fa-search"></i></span>
        <input type="search" id="productSearchBox" placeholder="{{ trans('search') }}">
    </label>
    <button id="productFilterButton" class="ml-2 bg-gray-200 text-slate-800 btn focus:ring-gray-600"
            data-toggle="modal" data-target="product:filter:modal">
        <i class="fa fa-tags"></i>
        <span id="productFilterLabel" class="mx-2">{{ trans('filters') }}</span>
    </button>
</div>
<div id="product:filter:family:view" class="mb-4 flex flex-wrap gap-2 px-4">
</div>
<div class="mb-4 flex-1 overflow-y-auto px-4">
    <div id="product:search:list:view" role="list">
        {% if terminal.product_display_mode == 'grid' %}
            {{ _self.productGridView(fsc, terminal) }}
        {% elseif terminal.product_display_mode == 'list' %}
            {{ _self.productListView(fsc, terminal) }}
        {% else %}
            {{ _self.productGridView() }}
        {% endif %}
    </div>
</div>
<div class="flex h-auto select-none flex-row bg-white p-4 md:hidden">
    <button class="btn btn-primary btn-block" data-toggle="block" data-target="cartMainView"
            data-ontoggle="productMainView">
        <span class="mr-auto">Carrito</span>
        <i class="fas fa-shopping-cart fa-fw"></i>
    </button>
</div>
<script id="product:search:grid:template" type="text/template">
    <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {% if context.terminal().free_cart_lines %}
            {{ _self.freeProductLineTemplate() }}
        {% endif %}
        <% products.forEach(function(product){ %>
        <div role="listitem"
             class="flex flex-col rounded-lg p-4 text-xs shadow-xs product-add-btn
                    <%= product.isOutOfStock ? 'bg-gray-200 cursor-not-allowed' : 'bg-white cursor-pointer' %>"
             data-action="<%= product.isOutOfStock ? '' : 'cart:product:add' %>"
             data-code="<%= product.code %>"
             data-description="<%= product.description %>"
             data-thumbnail="<%= product.thumbnail %>">
            <!-- Imagen -->
            <div class="mb-3 relative overflow-hidden rounded-md pointer-events-none bg-gray-100">
                <% if (product.thumbnail) { %>
                <img class="w-full h-28 object-cover"
                     src="<%= product.thumbnail %>"
                     alt="<%= product.code %>"
                     loading="lazy" decoding="async">
                <button type="button"
                        class="text-sm absolute top-1 right-1 w-10 h-10 flex items-center justify-center
                            rounded-full bg-white/80 text-gray-600 pointer-events-auto cursor-pointer"
                        title="{{ trans('view-image') }}"
                        data-action="product:image:show"
                        data-id="<%= product.id %>"
                        data-code="<%= product.code %>">
                    <i class="fas fa-eye pointer-events-none"></i>
                </button>
                <% } else { %>
                <div class="w-full h-24 flex items-center justify-center bg-gray-100 rounded-md pointer-events-auto">
                    <i class="fas fa-image fa-2x text-gray-400"></i>
                </div>
                <% } %>
            </div>
            <!-- Descripción -->
            <div class="flex-1 text-center mb-3">
                <span class="font-semibold uppercase text-gray-800">
                    <%= product.code %>
                </span>
                <p class="italic text-gray-600"><%= product.description %></p>
                <% if(product.detail) { %>
                <p><%= product.detail %></p>
                <% } %>
                <br>
                <% if(product.brandname) { %>
                <p class="font-semibold"><%= product.brandname %></p>
                <% } %>
                <% if(product.family) { %>
                <p class="font-semibold"><%= product.family %></p>
                <% } %>
            </div>
            <!-- Precio / Stock -->
            <div class="mt-auto pt-2 border-t border-dashed border-gray-200 flex items-center justify-between text-sm">
                <span class="font-semibold text-blue-500">
                    <i class="fa-solid fa-tag fa-fw"></i> <%= product.priceWithFormat %>
                </span>
                <span class="pointer-events-auto font-medium text-gray-900"
                      data-action="product:stock:show"
                      data-code="<%= product.code %>">
                    <i class="fa-solid fa-dolly-flatbed fa-fw pointer-events-none"></i> <%= product.stock | 0 %>
                </span>
            </div>
        </div>
        <% }) %>
    </div>
</script>

<script id="product:search:list:template" type="text/template">
    <div class="flex flex-col gap-3">
        {% if context.terminal().free_cart_lines %}
            {{ _self.freeProductLineListTemplate() }}
        {% endif %}

        <% products.forEach(function(product){ %>
        <div role="listitem"
             class="group rounded-lg bg-white p-3 ring-1 transition product-add-btn
                    <%= product.isOutOfStock
                        ? 'ring-red-200 opacity-70 cursor-default'
                        : 'ring-slate-200 hover:ring-slate-300 hover:shadow-sm active:scale-[0.99] cursor-pointer' %>"
             data-action="<%= product.isOutOfStock ? '' : 'cart:product:add' %>"
             data-code="<%= product.code %>"
             data-description="<%= product.description %>"
             data-thumbnail="<%= product.thumbnail %>">

            <div class="flex gap-3">
                {# Thumbnail #}
                <div class="relative flex h-14 w-14 xl:h-16 xl:w-16 shrink-0 items-center justify-center overflow-hidden rounded-md bg-slate-100 text-slate-400">
                    <% if (product.thumbnail) { %>
                    <img class="h-full w-full object-cover"
                         src="<%= product.thumbnail %>"
                         alt="<%= product.code %>"
                         loading="lazy" decoding="async">

                    {# Overlay zoom button #}
                    <button type="button"
                            class="absolute inset-0 z-10 flex items-center justify-center bg-black/0 md:hover:bg-black/40 transition-colors group pointer-events-auto"
                            title="{{ trans('view-image') }}"
                            data-action="product:image:show"
                            data-id="<%= product.id %>"
                            data-code="<%= product.code %>">
                        <i class="fas fa-search-plus text-white opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity pointer-events-none"></i>
                    </button>
                    <% } else { %>
                    <i class="fas fa-image text-xl xl:text-2xl text-slate-300"></i>
                    <% } %>
                </div>

                {# Content #}
                <div class="min-w-0 flex-1">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="text-xs font-semibold text-slate-500 truncate">
                                <%= product.code %>
                            </p>
                            <p class="mt-0.5 text-sm font-semibold leading-snug line-clamp-2">
                                <%= product.description %>
                            </p>
                            <% if (product.detail) { %>
                            <p class="mt-0.5 text-xs text-slate-500 italic truncate">
                                <%= product.detail %>
                            </p>
                            <% } %>
                            {# Badges / meta #}
                            <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                                <% if (product.isOutOfStock) { %>
                                <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 font-semibold text-red-700">
                                    <i class="fa-solid fa-ban mr-1"></i> {{ trans('out-of-stock') }}
                                </span>
                                <% } %>

                                <span class="pointer-events-auto inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-slate-600 hover:bg-slate-300"
                                      data-action="product:stock:show"
                                      data-code="<%= product.code %>">
                                        {# <i class="fa-solid fa-dolly-flatbed mr-1"></i> #}
                                        Stock: <%= (product.stock ?? 0) %>
                                    </span>

                                <% if (product.family) { %>
                                <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-slate-600">
                                        <%= product.family %>
                                    </span>
                                <% } %>

                                <% if (product.brandname) { %>
                                <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 font-semibold text-blue-700">
                                        <%= product.brandname %>
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        {# Price + CTA #}
                        <div class="flex-shrink-0 text-right">
                            <div class="text-lg font-extrabold text-slate-900">
                                <%= product.priceWithFormat %>
                            </div>

                            <% if (!product.isOutOfStock) { %>
                            <div class="mt-1 text-xs text-slate-500">
                                {{ trans('touch-to-add') }}
                            </div>
                            <% } else { %>
                            <button type="button"
                                    class="mt-2 cursor-not-allowed rounded-lg bg-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-500"
                                    disabled>
                                {{ trans('not-available') }}
                            </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            {# Extra hint row on mobile #}
            <div class="mt-3 flex items-center justify-between border-t border-slate-200 pt-2 xl:hidden">
                <button type="button"
                        class="pointer-events-auto rounded-lg px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100 flex items-center gap-2"
                        data-action="product:stock:show"
                        data-code="<%= product.code %>">
                    <i class="fa-solid fa-dolly-flatbed text-slate-400 pointer-events-none"></i>
                    <span class="pointer-events-none">Stock: <%= (product.stock ?? 0) %></span>
                </button>

                <% if (!product.isOutOfStock) { %>
                <span class="text-xs text-slate-500">{{ trans('touch-to-add') }}</span>
                <% } else { %>
                <span class="text-xs font-medium text-red-600">
                        <i class="fa-solid fa-ban"></i> {{ trans('out-of-stock') }}
                    </span>
                <% } %>
            </div>
        </div>
        <% }) %>
    </div>
</script>

<script id="product:search:list:template2" type="text/template">
    <div class="flex flex-col gap-2">
        {% if context.terminal().free_cart_lines %}
            {{ _self.freeProductLineListTemplate() }}
        {% endif %}
        <% products.forEach(function(product){ %>
        <div role="listitem"
             class="flex flex-col xl:flex-row xl:items-center gap-2 xl:gap-3 rounded-lg p-3 text-sm border product-add-btn bg-white
                    <%= product.isOutOfStock ? 'border-red-500 cursor-default' : 'border-gray-200 cursor-pointer hover:border-blue-400' %>"
             data-action="<%= product.isOutOfStock ? '' : 'cart:product:add' %>"
             data-code="<%= product.code %>"
             data-description="<%= product.description %>"
             data-thumbnail="<%= product.thumbnail %>">
            <!-- Fila superior: Imagen + Info + Precio -->
            <div class="flex gap-3 flex-1">
                <!-- Imagen -->
                <div class="flex-shrink-0 w-16 h-16 xl:w-20 xl:h-20 relative overflow-hidden rounded-md bg-gray-100">
                    <% if (product.thumbnail) { %>
                    <img class="w-full h-full object-cover"
                         src="<%= product.thumbnail %>"
                         alt="<%= product.code %>"
                         loading="lazy" decoding="async">
                    <button type="button"
                            class="absolute inset-0 z-10 flex items-center justify-center bg-black/0
                                    md:hover:bg-black/40 transition-colors group pointer-events-auto"
                            title="{{ trans('view-image') }}"
                            data-action="product:image:show"
                            data-id="<%= product.id %>"
                            data-code="<%= product.code %>">
                        <i class="fas fa-search-plus text-white opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity pointer-events-none"></i>
                    </button>
                    <% } else { %>
                    <div class="w-full h-full flex items-center justify-center">
                        <i class="fas fa-image text-xl xl:text-2xl text-gray-300"></i>
                    </div>
                    <% } %>
                </div>
                <!-- Contenedor de información -->
                <div class="flex-1 min-w-0 flex flex-col">
                    <!-- Fila: Código + Precio (móvil) -->
                    <div class="flex items-start justify-between gap-2">
                        <div class="flex-1 min-w-0">
                            <div class="font-semibold text-gray-900 uppercase truncate text-xs xl:text-sm">
                                <%= product.code %>
                            </div>
                        </div>
                        <!-- Precio (visible solo en móvil/tablet) -->
                        <div class="xl:hidden flex-shrink-0 text-right">
                            <div class="text-base font-bold text-blue-600">
                                <%= product.priceWithFormat %>
                            </div>
                        </div>
                    </div>
                    <!-- Descripción -->
                    <div class="text-gray-700 text-xs xl:text-sm leading-tight line-clamp-2 xl:line-clamp-none">
                        <%= product.description %>
                    </div>
                    <% if(product.detail) { %>
                    <div class="text-xs text-gray-500 italic truncate hidden xl:block">
                        <%= product.detail %>
                    </div>
                    <% } %>
                    <!-- Badges en móvil/tablet -->
                    <div class="flex flex-wrap gap-1 mt-1 xl:hidden">
                        <% if(product.family) { %>
                        <span class="text-xs px-1.5 py-0.5 bg-purple-100 text-purple-700 rounded">
                            <%= product.family %>
                        </span>
                        <% } %>
                        <% if(product.brandname) { %>
                        <span class="text-xs px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded">
                            <%= product.brandname %>
                        </span>
                        <% } %>
                    </div>
                    <!-- Stock y acción (visible solo en desktop XL) -->
                    <div class="hidden xl:flex items-center gap-3 mt-2">
                        <button type="button"
                                class="pointer-events-auto hover:bg-gray-100 rounded px-2 py-1 transition-colors flex items-center gap-2 text-xs"
                                data-action="product:stock:show"
                                data-code="<%= product.code %>">
                            <i class="fa-solid fa-dolly-flatbed text-gray-500 pointer-events-none"></i>
                            <span class="font-semibold text-gray-900 pointer-events-none">
                                Stock: <%= product.stock | 0 %>
                            </span>
                        </button>
                        <% if(product.family) { %>
                        <div class="text-xs font-semibold text-gray-500">
                            <i class="fa-solid fa-tag"></i> <%= product.family %>
                        </div>
                        <% } %>
                        <% if(product.brandname) { %>
                        <div class="text-xs font-semibold text-blue-500">
                            <i class="fa-solid fa-tag"></i> <%= product.brandname %>
                        </div>
                        <% } %>
                        <% if (product.isOutOfStock) { %>
                        <div class="text-xs text-red-500 font-medium">
                            <i class="fa-solid fa-ban"></i> {{ trans('out-of-stock') }}
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <!-- Sección desktop XL: Badges y Precio en fila -->
            <div class="hidden xl:flex items-center gap-3 flex-shrink-0">
                <!-- Precio y acción -->
                <div class="text-right w-24 2xl:w-28">
                    <div class="text-base 2xl:text-lg font-bold text-blue-600 mb-1">
                        <%= product.priceWithFormat %>
                    </div>
                    <% if (!product.isOutOfStock) { %>
                    <div class="text-xs text-gray-500">
                        <i class="fa-solid fa-plus-circle"></i> {{ trans('touch-to-add') }}
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- Fila inferior: Stock (solo móvil/tablet) -->
            <div class="flex xl:hidden items-center justify-between pt-2 border-t border-gray-200">
                <button type="button"
                        class="pointer-events-auto hover:bg-gray-100 rounded px-2 py-1 transition-colors flex items-center gap-2 text-xs"
                        data-action="product:stock:show"
                        data-code="<%= product.code %>">
                    <i class="fa-solid fa-dolly-flatbed text-gray-500 pointer-events-none"></i>
                    <span class="font-semibold text-gray-900 pointer-events-none">
                        Stock: <%= product.stock | 0 %>
                    </span>
                </button>

                <% if (!product.isOutOfStock) { %>
                <div class="text-xs text-gray-500">
                    <i class="fa-solid fa-plus-circle"></i> {{ trans('touch-to-add') }}
                </div>
                <% } else { %>
                <div class="text-xs text-red-500 font-medium">
                    <i class="fa-solid fa-ban"></i> {{ trans('out-of-stock') }}
                </div>
                <% } %>
            </div>
        </div>
        <% }) %>
    </div>
</script>

{% macro productGridView(fsc, terminal) %}
    <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {% if terminal.free_cart_lines %}
            {{ _self.freeProductLineTemplate() }}
        {% endif %}
        {% for product in fsc.getHomeProducts() %}
            <div role="listitem"
                 class="flex flex-col rounded-lg p-4 text-xs shadow-xs product-add-btn
                        {{ product.isOutOfStock ? 'bg-gray-200 cursor-not-allowed' : 'bg-white cursor-pointer' }}"
                 data-action="{{ product.isOutOfStock ? '' : 'cart:product:add' }}"
                 data-code="{{ product.code }}"
                 data-description="{{ product.description }}"
                 data-thumbnail="{{ product.thumbnail }}">
                <!-- Imagen -->
                <div class="mb-3 relative overflow-hidden rounded-md pointer-events-none bg-gray-100">
                    {% if product.thumbnail %}
                        <img class="w-full h-28 object-cover"
                             src="{{ product.thumbnail }}"
                             alt="{{ product.code }}"
                             loading="lazy" decoding="async">
                        <button type="button"
                                class="text-sm absolute top-1 right-1 w-10 h-10 flex items-center justify-center
                               rounded-full bg-white/80 text-gray-600 pointer-events-auto cursor-pointer"
                                title="{{ trans('view-image') }}"
                                data-action="product:image:show"
                                data-id="{{ product.id }}"
                                data-code="{{ product.code }}">
                            <i class="fas fa-eye pointer-events-none"></i>
                        </button>
                    {% else %}
                        <div class="w-full h-24 flex items-center justify-center bg-gray-100 rounded-md pointer-events-auto">
                            <i class="fas fa-image fa-2x text-gray-400"></i>
                        </div>
                    {% endif %}
                </div>
                <!-- Descripción -->
                <div class="flex-1 text-center mb-3">
                    <span class="font-semibold uppercase text-gray-800">
                        {{ product.code }}
                    </span>
                    <p class="italic text-gray-600">{{ product.description }}</p>
                    {% if product.detail %}
                        <p>{{ product.detail }}</p>
                    {% endif %}
                    {% if product.brandname %}
                        <p class="font-semibold">{{ product.brandname }}</p>
                    {% endif %}
                    {% if product.family %}
                        <p class="font-semibold">{{ product.family }}</p>
                    {% endif %}
                </div>
                <!-- Precio / Stock -->
                <div class="mt-auto pt-2 border-t border-dashed border-gray-200 flex items-center justify-between text-sm">
                    <span class="font-semibold text-blue-500">
                        <i class="fa-solid fa-tag fa-fw"></i> {{ product.priceWithFormat }}
                    </span>
                    <span class="pointer-events-auto font-medium text-gray-900"
                          data-action="product:stock:show"
                          data-code="{{ product.code }}">
                        <i class="fa-solid fa-dolly-flatbed fa-fw pointer-events-none"></i> {{ product.stock | default('0') }}
                    </span>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{% macro productListView(fsc, terminal) %}
    <div class="flex flex-col gap-3">
        {% if terminal.free_cart_lines %}
            {{ _self.freeProductLineListTemplate() }}
        {% endif %}

        {% for product in fsc.getHomeProducts() %}
            {# Base card #}
            {% set cardBase = 'group rounded-lg bg-white p-3 ring-1 transition' %}

            {# State: available vs out of stock #}
            {% if product.isOutOfStock %}
                {% set cardState = 'ring-red-200 opacity-70 cursor-default' %}
                {% set actionAttr = '' %}
            {% else %}
                {% set cardState = 'ring-slate-200 hover:ring-slate-300 hover:shadow-sm active:scale-[0.99] cursor-pointer' %}
                {% set actionAttr = 'cart:product:add' %}
            {% endif %}

            <div role="listitem"
                 class="{{ cardBase }} {{ cardState }} product-add-btn"
                 data-action="{{ actionAttr }}"
                 data-code="{{ product.code }}"
                 data-description="{{ product.description }}"
                 data-thumbnail="{{ product.thumbnail }}">

                <div class="flex gap-3">
                    {# Thumbnail #}
                    <div class="relative flex h-14 w-14 xl:h-16 xl:w-16 shrink-0 items-center justify-center overflow-hidden rounded-md bg-slate-100 text-slate-400">
                        {% if product.thumbnail %}
                            <img class="h-full w-full object-cover"
                                 src="{{ product.thumbnail }}"
                                 alt="{{ product.code }}"
                                 loading="lazy" decoding="async">

                            {# Overlay zoom button #}
                            <button type="button"
                                    class="absolute inset-0 z-10 flex items-center justify-center bg-black/0 md:hover:bg-black/40 transition-colors group pointer-events-auto"
                                    title="{{ trans('view-image') }}"
                                    data-action="product:image:show"
                                    data-id="{{ product.id }}"
                                    data-code="{{ product.code }}">
                                <i class="fas fa-search-plus text-white opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity pointer-events-none"></i>
                            </button>
                        {% else %}
                            <i class="fas fa-image text-xl xl:text-2xl text-slate-300"></i>
                        {% endif %}
                    </div>

                    {# Content #}
                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-xs font-semibold text-slate-500 truncate">
                                    {{ product.code }}
                                </p>
                                <p class="mt-0.5 text-sm font-semibold leading-snug line-clamp-2">
                                    {{ product.description }}
                                </p>
                                {% if product.detail %}
                                    <p class="mt-0.5 text-xs text-slate-500 italic truncate">
                                        {{ product.detail }}
                                    </p>
                                {% endif %}
                                {# Badges / meta #}
                                <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                                    {% if product.isOutOfStock %}
                                        <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 font-semibold text-red-700">
                                            <i class="fa-solid fa-ban mr-1"></i> {{ trans('out-of-stock') }}
                                        </span>
                                    {% endif %}

                                    <span class="pointer-events-auto inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-slate-600 hover:bg-slate-300"
                                          data-action="product:stock:show"
                                          data-code="{{ product.code }}">
                                        {# <i class="fa-solid fa-dolly-flatbed mr-1"></i> #}
                                        Stock: {{ product.stock | default('0') }}
                                    </span>

                                    {% if product.family %}
                                        <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-1 text-slate-600">
                                            {# <i class="fa-solid fa-tag mr-1"></i> #} {{ product.family }}
                                        </span>
                                    {% endif %}

                                    {% if product.brandname %}
                                        <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 font-semibold text-blue-700">
                                            {# <i class="fa-solid fa-tag mr-1"></i> #} {{ product.brandname }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            {# Price + CTA #}
                            <div class="flex-shrink-0 text-right">
                                <div class="text-lg font-extrabold text-slate-900">
                                    {{ product.priceWithFormat }}
                                </div>

                                {% if not product.isOutOfStock %}
                                    <div class="mt-1 text-xs text-slate-500">
                                        {{ trans('touch-to-add') }}
                                    </div>
                                {% else %}
                                    <button type="button"
                                            class="mt-2 cursor-not-allowed rounded-lg bg-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-500"
                                            disabled>
                                        {{ trans('not-available') }}
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                {# Extra hint row on mobile #}
                <div class="mt-3 flex items-center justify-between border-t border-slate-200 pt-2 xl:hidden">
                    <button type="button"
                            class="pointer-events-auto rounded-lg px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100 flex items-center gap-2"
                            data-action="product:stock:show"
                            data-code="{{ product.code }}">
                        <i class="fa-solid fa-dolly-flatbed text-slate-400 pointer-events-none"></i>
                        <span class="pointer-events-none">Stock: {{ product.stock | default('0') }}</span>
                    </button>

                    {% if not product.isOutOfStock %}
                        <span class="text-xs text-slate-500">
                            <i class="fa-solid fa-plus-circle"></i> {{ trans('touch-to-add')|default('Toca para agregar') }}
                        </span>
                    {% else %}
                        <span class="text-xs font-medium text-red-600">
                            <i class="fa-solid fa-ban"></i> {{ trans('out-of-stock') }}
                        </span>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

