<div class="flex h-full flex-col bg-white md:shadow-lg">
    <div class="flex flex-col gap-4 p-4">
        <button id="documentTypeButton" class="w-full bg-gray-200 text-slate-800 btn focus:ring-gray-600"
                data-toggle="modal" data-target="documentTypeModal">
            <i class="fa fa-file-invoice"></i>
            <span id="documentTypeLabel" class="mx-2">
                {{ fsc.getDefaultDocument().descripcion ?: i18n.trans(fsc.getDefaultDocument().tipodoc) }}
            </span>
            <i class="ml-auto fa fa-ellipsis-v"></i>
        </button>
        <button id="customerSearchButton" class="w-full btn btn-primary"
                data-toggle="modal" data-target="customerSearchModal">
            <i class="fa fa-user"></i>
            <span id="customerNameLabel" class="mx-2"{# data-document-field="nombrecliente" #}>
                {{ fsc.getDefaultCustomer().nombre }}</span>
            <i class="ml-auto fa fa-ellipsis-v"></i>
        </button>
        {% for button in fsc.getCustomButtons %}
            {{ include(button) }}
        {% endfor %}
    </div>
    <div id="cartListView" class="flex-1 flex-col overflow-auto px-4 divide-y-2 divide-dotted">
        <div class="flex h-full items-center justify-center">
            <i class="fa fa-shopping-cart fa-5x text-slate-gray-300"></i>
        </div>
    </div>
    <div class="flex flex-col gap-4 border-t-2 border-dashed p-4">
        <div class="flex flex-1 items-center justify-between font-medium">
            <button class="text-slate-800 btn btn-light" data-toggle="modal" data-target="totalsDetailModal">
                <i class="fas fa-ellipsis-v fa-fw"></i> {{ i18n.trans('detail') }} / {{ i18n.trans('payable-amount') }}
            </button>
            <span id="cartTotal" class="text-right text-xl">0.000</span>
        </div>
        <div class="flex h-auto select-none flex-row gap-4">
            <button class="btn btn-icon btn-light md:hidden" data-toggle="block"
                    data-target="cartMainView" data-ontoggle="productMainView">
                <i class="fa fa-arrow-left"></i>
            </button>
            <button class="flex-1 btn btn-warning" data-action="holdOrderAction">
                <span class="mr-auto">{{ i18n.trans('hold') }}</span>
                <i class="fa fa-hourglass-start"></i>
            </button>
            {% if terminal.aceptapagos %}
                <button class="flex-1 btn btn-success" data-toggle="modal" data-target="checkoutModal">
                    <span class="mr-auto">{{ i18n.trans('charge') }}</span>
                    <i class="fa fa-calculator"></i>
                </button>
            {% endif %}
        </div>
    </div>
</div>
<script id="cartListTemplate" type="text/template">
    <div class="flex">
        <div class="flex-1 text-center text-xs">
            <span class="font-semibold">{{ trans('product') }}</span>
        </div>
        <div class="mr-2 flex h-full flex-row justify-between gap-2 self-center">
            {% for column in grid %}
                {% set label = column.tittle ?: trans(column.name) %}
                {%- if column.data == 'referencia' or column.data == 'descripcion' or column.data == 'cantidad' -%}
                {% elseif not column.eneabled -%}
                {% elseif column.carrito -%}
                    <div class="w-20 text-xs">
                        <span class="font-semibold">{{ label }}</span>
                    </div>
                {% endif -%}
            {% endfor %}
        </div>
        <div class="h-8 w-8 text-xs">
            <span class="font-semibold"><i class="fas fa-trash-alt"></i></span>
        </div>
    </div>
    <% if(it.lines.length === 0) { %>
    <div class="flex h-full items-center justify-center">
        <i class="fa fa-shopping-cart fa-5x text-slate-gray-300"></i>
    </div>
    <% } %>
    <% it.lines.forEach(function(product, index) { %>
    <div class="flex select-none py-2">
        <div class="my-auto mr-1 w-25 items-center text-center">
            <% if (product.thumbnail) { %>
            <img class="pointer-events-auto w-16 object-scale-down" src="<%= product.thumbnail %>"
                 alt="<%= product.referencia %>"
                 data-action="productImageAction" data-id="<%= product.idproducto %>"
                 data-code="<%= product.referencia %>">
            <% } else { %>
            <div class="w-16"><i class="fas fa-3x fa-image"></i></div>
            <% } %>
        </div>

        <div class="mx-2 flex flex-1 flex-row space-x-2">
            <p class="flex-1 self-center text-xs">
                    <span class="inline-flex items-center rounded-full bg-slate-100 mr-2 px-2 font-semibold uppercase
                    py-0.5 text-[0.75rem]"><%= product.referencia %></span><%= product.descripcion %>
            </p>
            <div class="flex-col self-center text-xs">
                <div class="flex inline-flex text-xs">
                    <button class="h-8 w-8 rounded-r-none btn btn-icon btn-warning"
                            data-action="quantityDecreaseAction" data-index="<%= index %>">
                        <i class="fa fw fa-minus"></i>
                    </button>
                    <input type="number"
                           class="h-8 w-14 border-2 p-1.5 placeholder-slate-300 focus:border-blue-500 focus:outline-none"
                           value="<%= product.cantidad %>"
                           data-action="editProductFieldAction" data-index="<%= index %>" data-field="cantidad">
                    <button class="h-8 w-8 rounded-l-none btn btn-icon btn-secondary"
                            data-action="quantityIncreaseAction" data-index="<%= index %>">
                        <i class="fa fw fa-plus"></i>
                    </button>
                </div>
            </div>
            <div class="flex flex-row justify-between gap-2 self-center">
                {# <div class="h-full w-24 flex-col text-xs">
                    <label for="productQuantityInput"
                           class="mb-2 text-xs font-semibold capitalize">{{ i18n.trans('quantity') }}</label>
                    <div class="inline-flex space-x-2">
                        <button class="h-8 w-8 flex-none text-xs btn btn-icon btn-warning"
                                data-action="quantityDecreaseAction" data-index="<%= index %>">
                            <i class="fa fw fa-minus"></i>
                        </button>
                        <input id="productQuantityInput" type="number"
                               class="h-8 w-16 rounded-lg border-2 p-2 placeholder-slate-300 focus:border-blue-500 focus:outline-none"
                               value="<%= product.cantidad %>"
                               data-action="editProductFieldAction" data-index="<%= index %>" data-field="cantidad">
                        <button class="h-8 w-8 flex-none text-xs btn btn-icon btn-secondary"
                                data-action="quantityIncreaseAction" data-index="<%= index %>">
                            <i class="fa fw fa-plus"></i>
                        </button>
                    </div>
                </div> #}
                {% for column in grid %}
                    {% set label = column.tittle ?: trans(column.name) %}
                    {%- if column.data == 'referencia' or column.data == 'descripcion' or column.data == 'cantidad' -%}
                    {% elseif not column.eneabled -%}
                    {% elseif column.carrito -%}
                        <div class="h-full w-20 flex-col text-xs">
                            {# <label>
                                <span class="font-semibold">{{ label }}</span>
                            </label> #}
                            {% if column.readonly %}
                                <p><%= product.{{ column.data }} %></p>
                            {% else %}
                                <input class="pointer-events-auto h-8 w-20 rounded-lg border-2 text-right p-1.5 placeholder-slate-300 focus:border-blue-500 focus:outline-none"
                                       tabindex="0"
                                       type="{{ column.type }}" value="<%= product.{{ column.data }} %>"
                                       data-index="<%= index %>"
                                       data-action="editProductFieldAction"
                                       data-field="{{ column.data }}">
                            {% endif %}
                        </div>
                    {% endif -%}
                {% endfor %}
            </div>
        </div>

        {# <div class="flex items-center space-x-2">
                <button class="btn btn-icon btn-light"
                        data-action="editProductAction" data-index="<%= index %>">
                    <i class="fas fa-pen-alt"></i>
                </button>
                <button class="btn btn-icon btn-light"
                        data-action="editProductQuantityAction" data-index="<%= index %>">
                    <span><%= product.cantidad %></span>
                </button>
            </div> #}
        <button class="my-auto h-8 w-8 text-xs btn btn-icon btn-danger" data-action="deleteProductAction"
                data-index="<%= index %>">
            <i class="fas fa-trash-alt"></i>
        </button>
    </div>

    <% }) %>
</script>
