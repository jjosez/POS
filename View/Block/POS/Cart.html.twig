{% set grid = fsc.getFieldOptions() %}
{% set config = context.config() %}
<div class="flex h-full flex-col bg-white md:shadow-lg">
    <div class="flex flex-col gap-4 p-4">
        <div class="flex items-start justify-between gap-3">
            <div>
                <p class="text-xs font-semibold text-slate-500">{{ trans('document') }}</p>
                <h2 id="documentClassLabel" class="text-lg font-bold tracking-tight">
                    {{ config.getDefaultDocument().descripcion ?: trans(config.getDefaultDocument().tipodoc) }}
                </h2>
            </div>
            <button class="btn btn-icon btn-naked" title="{{ trans('edit') }}"
                    data-toggle="modal"
                    data-target="document:type:modal">
                <i class="ml-auto fa-solid fa-pencil"></i>
            </button>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <button class="btn btn-primary grid grid-cols-[auto_1fr] gap-x-3 items-center h-auto py-2 px-4 text-left"
                    data-toggle="modal" data-target="customer:search:modal">
                <span class="h-8 w-8 rounded-xl bg-white ring-1 ring-slate-200 text-center text-slate-900">
                    <i class="fa-solid fa-user align-middle"></i></span>
                <span class="flex flex-col">
                    <span class="text-[10px] opacity-80">{{ trans('customer') }}</span>
                    <span id="customerNameLabel"
                          class="text-sm font-bold leading-none"> {{ config.getDefaultCustomer().nombre }}</span>
                </span>
            </button>
            {% if terminal.can_change_agent %}
                {% set agentButtonAttributes = 'data-toggle=modal data-target=agent:select:modal' %}
                {% set agentButtonState = '' %}
            {% else %}
                {% set agentButtonAttributes = '' %}
                {% set agentButtonState = 'disabled' %}
            {% endif %}
            <button class="btn btn-primary grid grid-cols-[auto_1fr] gap-x-3 items-center h-auto py-2 px-4 text-left"
                    {{ agentButtonAttributes }} {{ agentButtonState }}>
                <span class="h-8 w-8 rounded-xl bg-white ring-1 ring-slate-200 text-center text-slate-900"><i
                            class="fa-solid fa-user-tie align-middle"></i></span>
                <span class="flex flex-col">
                    <span class="text-[10px] opacity-80">{{ trans('agent') }}</span>
                    <span id="agentNameLabel" class="text-sm font-bold leading-none">
                        {% if fsc.user.codagente %}
                            {% set agent =  context.agents().getAgent(fsc.user.codagente) %}
                            {{ agent.nombre }}
                        {% else %}
                            {{ trans('select-agent') }}
                        {% endif %}
                    </span>
                </span>
            </button>
        </div>
        {% for button in fsc.getCustomButtons %}
            {{ include(button) }}
        {% endfor %}
    </div>
    <div id="cartListTemplateView" class="flex-1 flex-col overflow-auto px-4 divide-y-2 divide-dotted">
        <!-- Empty Cart Thumbnail-->
        <div class="flex h-full items-center justify-center">
            <i class="fa fa-shopping-cart fa-5x text-slate-gray-300"></i>
        </div>
    </div>
    <!-- Totals and Checkout Button-->
    <div class="flex flex-col gap-4 border-t-2 border-dashed p-4">
        <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <div>
                    <div class="text-xs font-semibold text-slate-500 uppercase">{{ trans('total') }}</div>
                    <span id="cartTotal" class="text-2xl font-extrabold tracking-tight"
                          data-view="CartView">$0.000</span>
                </div>
                <button class="btn btn-icon btn-naked" data-toggle="modal" data-target="totalsDetailModal">
                    <i class="fas fa-chevron-up text-slate-400 group-hover:text-slate-600 text-sm"></i>
                </button>
            </div>
            <div class="flex items-center gap-2">
                <button class="btn btn-light" data-action="order:draft:save">
                    <span class="mr-auto">{{ trans('hold') }}</span>
                </button>
                {% if terminal.aceptapagos %}
                    <button class="btn btn-success px-6 font-bold" data-action="checkout:show">
                        <span class="mr-auto">{{ trans('charge') }}</span>
                    </button>
                {% endif %}
            </div>
        </div>
    </div>
</div>
<script id="cartListTemplate" type="text/template">
    {% set cartColumnCount = fsc.getCartColumnCount() %}
    {% set excludedColumns = ['referencia', 'descripcion', 'cantidad'] %}
    {% set priceColumns = ['pvpunitario', 'pvpunitarioiva'] %}

    <div class="flex text-xs mb-1.5">
        <div class="flex-1 text-center">
            <span class="font-semibold">{{ trans('product') }}</span>
        </div>
        <div class="w-32 text-center">
            <span class="font-semibold">{{ trans('quantity') }}</span>
        </div>
        {% if cartColumnCount <= 3 %}
            <div class="mr-2 flex h-full flex-row justify-between gap-2">
                {% for column in grid %}
                    {% if column.data not in excludedColumns and column.eneabled and column.carrito %}
                        {% set label = column.tittle ?: trans(column.name) %}
                        <div class="w-20">
                            <span class="font-semibold">{{ label }}</span>
                        </div>
                    {% endif -%}
                {% endfor %}
            </div>
        {% endif %}
        <div class="h-8 w-8 content-center text-center">
            <span class="font-semibold"><i class="fas fa-trash-alt"></i></span>
        </div>
    </div>
    <% if(lines.length === 0) { %>
    <div class="flex h-full items-center justify-center">
        <i class="fa fa-shopping-cart fa-5x text-slate-gray-300"></i>
    </div>
    <% } %>
    <% console.log('Cart lines', lines) %>
    <% lines.forEach(function(product, index) { %>
    {{ _self.newProductLine(grid, excludedColumns, priceColumns, cartColumnCount) }}
    <% }) %>
</script>

{% macro newProductLine(grid, excludedColumns, priceColumns, cartColumnCount) %}
    <div class="grid grid-cols-12 items-center gap-3 py-2">
        <!-- Producto -->
        <div class="col-span-12 xl:col-span-7 2xl:col-span-8 flex items-center gap-3 min-w-0">
            <!-- Thumbnail -->
            <% if (product.thumbnail) { %>
            <img class="pointer-events-auto h-12 w-12 shrink-0 rounded-xl object-cover" src="<%= product.thumbnail %>"
                 alt="<%= product.referencia %>"
                 data-action="product:image:show"
                 data-id="<%= product.idproducto %>"
                 data-code="<%= product.referencia %>">
            <% } else { %>
            <div class="h-12 w-12 shrink-0 rounded-xl bg-slate-100 ring-1 ring-slate-200 flex items-center justify-center text-slate-400">
                <div class="w-16 text-center"><i class="fa-regular fa-image text-xl "></i></div>
            </div>
            <% } %>

            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="text-xs font-semibold text-slate-500"><%= product.referencia %></span>
                </div>

                <!-- Description -->
                <div class="line-clamp-2 text-sm font-semibold text-slate-900">
                    <%= product.descripcion %>
                </div>

                <!-- Badges -->
                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                    {% for column in grid %}
                        {% if column.data not in excludedColumns and column.eneabled and column.carrito and column.readonly %}
                            {% set label = column.tittle ?: trans(column.name) %}
                            {% if column.name == 'price-with-tax' or column.name == 'price' %}
                                <span class="font-extrabold rounded-full bg-slate-100 px-2 py-0.5">
                                    {{ label }}: <%= product.{{ column.data }} %>
                                </span>
                            {% else %}
                                <span class="rounded-full bg-slate-100 px-2 py-0.5">{{ label }}: <%= product.{{ column.data }} %></span>
                            {% endif %}
                        {% endif -%}
                    {% endfor %}
                    <button class="btn rounded-lg font-normal text-slate-500 bg-slate-100 px-2 py-0.5 hover:bg-slate-200"
                            data-action="cart:product:edit" data-index="<%= index %>">
                        <i class="fa-solid fa-pen-to-square"></i>&nbsp;{{ trans('edit') }}
                    </button>
                </div>
            </div>

            <!-- Cantidad -->
            <div class="flex gap-2 text-xs items-end">
                <button class="h-8 w-8 text-center btn btn-icon btn-light"
                        data-action="cart:product:edit" data-index="<%= index %>">
                    <i class="fas fa-pen-alt"></i>
                </button>
                <div class="w-28 flex-col">
                    <div class="h-4 text-[11px] text-slate-500">
                        {{ trans('quantity') }}
                    </div>
                    <div class="flex">
                        <button class="h-8 w-8 rounded-r-none btn btn-icon btn-light"
                                data-action="cart:product:quantity:decrease" data-index="<%= index %>">
                            <i class="fa fw fa-minus"></i>
                        </button>
                        <input type="number" id="cart_quantity<%= index %>"
                               class="h-8 w-full rounded-none p-1.5 form-control-base font-bold text-center text-sm"
                               value="<%= product.cantidad %>"
                               data-action="cart:product:field:edit" data-index="<%= index %>" data-field="cantidad">
                        <button class="h-8 w-8 rounded-l-none btn btn-icon btn-light"
                                data-action="cart:product:quantity:increase" data-index="<%= index %>">
                            <i class="fa fw fa-plus"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-span-12 xl:col-span-5 2xl:col-span-4 flex items-center gap-3">
            <div class="flex flex-1 flex-row gap-2 justify-around">
                {% for column in grid %}
                    {% if column.data in priceColumns and column.eneabled and column.carrito and not column.readonly %}
                        {% set label = column.tittle ?: trans(column.name) %}
                        <div class="flex-col w-28">
                            <div class="text-[11px] text-slate-500">{{ label }}</div>
                            {% if column.readonly %}
                                <div class="text-sm font-extrabold text-slate-900"><%= product.{{ column.data }}%>
                                </div>
                            {% else %}
                                <input id="cart_{{ column.data }}<%= index %>"
                                       class="form-control-base p-1.5 w-full rounded-xl text-right text-sm font-bold"
                                       tabindex="0"
                                       inputmode="decimal"
                                       type="{{ column.type }}"
                                       value="<%= product.{{ column.data }} %>"
                                       data-index="<%= index %>"
                                       data-action="cart:product:field:edit"
                                       data-field="{{ column.data }}">
                            {% endif %}
                        </div>
                    {% endif -%}
                {% endfor %}
            </div>
            <!-- Total + Delete -->
            <div class="ml-auto flex items-center gap-2">
                <div class="text-right">
                    <div class="text-[11px] text-slate-500">{{ trans('line-total') }}</div>
                    <div class="text-base font-extrabold text-slate-900">$<%= product.pvptotaliva %></div>
                </div>
                <button class="h-8 w-8 text-xs btn btn-icon bg-red-50 text-red-700 hover:bg-red-100 active:bg-red-200 focus:ring-1"
                        data-action="cart:product:delete"
                        data-index="<%= index %>">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </div>
        </div>
    </div>
{% endmacro %}

