{% set grid = fsc.getFieldOptions() %}
<div class="flex h-full flex-col bg-white md:shadow-lg">
    <div class="flex flex-col gap-4 p-4">
        <button id="documentTypeButton" class="w-full bg-gray-200 text-slate-800 btn focus:ring-gray-600"
                data-toggle="modal"
                data-target="document:type:modal">
            <i class="fa fa-file-invoice"></i>
            <span id="documentClassLabel" class="mx-2" data-view="CartView">
                {{ context.config().getDefaultDocument().descripcion ?: trans(context.config().getDefaultDocument().tipodoc) }}
            </span>
            <i class="ml-auto fa fa-ellipsis-v"></i>
        </button>
        <button id="customerSearchButton" class="w-full btn btn-primary"
                data-toggle="modal" data-target="customer:search:modal">
            <i class="fa fa-user"></i>
            <span id="customerNameLabel" class="mx-2" data-view="CartView">
                {{ context.config().getDefaultCustomer().nombre }}</span>
            <i class="ml-auto fa fa-ellipsis-v"></i>
        </button>
        {% for button in fsc.getCustomButtons %}
            {{ include(button) }}
        {% endfor %}
    </div>
    <div id="cartListTemplateView" class="flex-1 flex-col overflow-auto px-4 divide-y-2 divide-dotted">
        <div class="flex h-full items-center justify-center">
            <i class="fa fa-shopping-cart fa-5x text-slate-gray-300"></i>
        </div>
    </div>
    <div class="flex flex-col gap-4 border-t-2 border-dashed p-4">
        <div class="flex flex-1 items-center justify-between font-medium">
            <button class="text-slate-800 btn btn-light" data-toggle="modal" data-target="totalsDetailModal">
                <i class="fas fa-ellipsis-v fa-fw"></i> {{ trans('detail') }} / {{ trans('payable-amount') }}
            </button>
            <span id="cartTotal" class="text-right text-xl" data-view="CartView">0.000</span>
        </div>
        <div class="flex h-auto select-none flex-row gap-4">
            <button class="btn btn-icon btn-light md:hidden" data-toggle="block"
                    data-target="cartMainView" data-ontoggle="productMainView">
                <i class="fa fa-arrow-left"></i>
            </button>
            <button class="flex-1 btn btn-secondary" data-action="order:draft:save">
                <span class="mr-auto">{{ trans('hold') }}</span>
                <i class="fa fa-hourglass-start"></i>
            </button>
            {% if terminal.aceptapagos %}
                <button class="flex-1 btn btn-success" data-action="checkout:show">
                {#<button class="flex-1 btn btn-success" data-toggle="modal" data-target="checkoutModal">#}
                    <span class="mr-auto">{{ trans('charge') }}</span>
                    <i class="fa fa-calculator"></i>
                </button>
            {% endif %}
        </div>
    </div>
</div>
<script id="cartListTemplate" type="text/template">
    {% set cartColumnCount = fsc.getCartColumnCount() %}
    {% set excludedColumns = ['referencia', 'descripcion', 'cantidad'] %}
    <div class="flex text-xs mb-1.5">
        <div class="flex-1 text-center">
            <span class="font-semibold">{{ trans('product') }}</span>
        </div>
        <div class="w-32 text-center">
            <span class="font-semibold">{{ trans('quantity') }}</span>
        </div>
        {% if cartColumnCount <= 3 %}
            <div class="mr-2 flex h-full flex-row justify-between gap-2">
                {% for column in grid %}
                    {% if column.data not in excludedColumns and column.eneabled and column.carrito %}
                        {% set label = column.tittle ?: trans(column.name) %}
                        <div class="w-20">
                            <span class="font-semibold">{{ label }}</span>
                        </div>
                    {% endif -%}
                {% endfor %}
            </div>
        {% endif %}
        <div class="h-8 w-8 content-center text-center">
            <span class="font-semibold"><i class="fas fa-trash-alt"></i></span>
        </div>
    </div>
    <% if(lines.length === 0) { %>
    <div class="flex h-full items-center justify-center">
        <i class="fa fa-shopping-cart fa-5x text-slate-gray-300"></i>
    </div>
    <% } %>
    <% lines.forEach(function(product, index) { %>
    <div class="flex flex-col">
        <div class="flex select-none py-2">
            <div class="mr-1 flex flex-1 items-center gap-2">
                <% if (product.thumbnail) { %>
                <img class="pointer-events-auto w-16 object-cover rounded-md" src="<%= product.thumbnail %>"
                     alt="<%= product.referencia %>"
                     data-action="product:image:show"
                     data-id="<%= product.idproducto %>"
                     data-code="<%= product.referencia %>">
                <% } else { %>
                <div class="w-16 text-center"><i class="fas fa-3x fa-image"></i></div>
                <% } %>
                <p class="flex-1 self-center text-xs">
                    <span class="inline-flex items-center rounded-full bg-slate-100 mr-2 px-2 font-semibold uppercase
                            py-0.5 text-[0.75rem]"><%= product.referencia %></span><%= product.descripcion %>
                </p>
                <button class="h-8 w-8 text-center text-xs btn btn-icon btn-light"
                        data-action="cart:product:edit" data-index="<%= index %>">
                    <i class="fas fa-pen-alt"></i>
                </button>
            </div>
            <div class="mx-2 flex flex-row space-x-2">
                <div class="flex inline-flex self-center text-xs">
                    <button class="h-8 w-8 rounded-r-none btn btn-icon btn-warning"
                            data-action="cart:product:quantity:decrease" data-index="<%= index %>">
                        <i class="fa fw fa-minus"></i>
                    </button>
                    <input type="number" id="cart_quantity<%= index %>"
                           class="h-8 w-12 rounded-none p-1.5 form-control-base"
                           value="<%= product.cantidad %>"
                           data-action="cart:product:field:edit" data-index="<%= index %>" data-field="cantidad">
                    <button class="h-8 w-8 rounded-l-none btn btn-icon btn-secondary"
                            data-action="cart:product:quantity:increase" data-index="<%= index %>">
                        <i class="fa fw fa-plus"></i>
                    </button>
                </div>
                {% if cartColumnCount <= 3 %}
                    <div class="flex flex-row justify-between gap-2 self-center">
                        {% for column in grid %}
                            {% if column.data not in excludedColumns and column.eneabled and column.carrito %}
                                <div class="w-20 text-xs">
                                    {% if column.readonly %}
                                        <p><%= product.{{ column.data }} %></p>
                                    {% else %}
                                        <input id="cart_{{ column.data }}<%= index %>"
                                                class="h-8 w-20 text-right p-1.5 form-control-base"
                                               tabindex="0"
                                               type="{{ column.type }}"
                                               value="<%= product.{{ column.data }} %>"
                                               data-index="<%= index %>"
                                               data-action="cart:product:field:edit"
                                               data-field="{{ column.data }}">
                                    {% endif %}
                                </div>
                            {% endif -%}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            <div class="flex items-center">
                <button class="h-8 w-8 text-xs btn btn-icon btn-danger" data-action="cart:product:delete"
                        data-index="<%= index %>">
                    <i class="fas fa-trash-alt"></i>
                </button>
            </div>
        </div>
        {% if cartColumnCount > 3 %}
            <div class="mb-2 flex flex-row place-content-around">
                {% for column in grid %}
                    {% if column.data not in excludedColumns and column.eneabled and column.carrito %}
                        {% set label = column.tittle ?: trans(column.name) %}
                        <div class="flex w-20 flex-col text-xs">
                            <span class="truncate font-semibold">{{ label }}</span>
                            {% if column.readonly %}
                                <p class="self-center"><%= product.{{ column.data }} %></p>
                            {% else %}
                                <input class="h-8 w-20 text-right p-1.5 form-control-base"
                                       tabindex="0"
                                       type="{{ column.type }}"
                                       value="<%= product.{{ column.data }} %>"
                                       data-index="<%= index %>"
                                       data-action="cart:product:field:edit"
                                       data-field="{{ column.data }}">
                            {% endif %}
                        </div>
                    {% endif -%}
                {% endfor %}
            </div>
        {% endif %}
    </div>
    <% }) %>
</script>
