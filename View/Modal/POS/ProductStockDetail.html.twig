<div id="product:stock:modal" class="modal hidden">
    <!--content-->
    <div class="modal-content md:modal-content-sm">
        <!--header-->
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-xl font-semibold text-slate-900">{{ trans('stock-detail') }}</h2>
                    <p class="truncate text-sm text-slate-500">{{ trans('available') }}</p>
                </div>
            </div>
            <button type="button" class="btn btn-icon btn-naked ml-2" data-toggle="modal" data-target="product:stock:modal" aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <!--body-->
        <div class="modal-body p-0">
            <div class="overflow-hidden">
                <table class="w-full">
                    <tbody id="product:stock:list:view" class="font-semibold text-slate-gray-700">
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <span>Deslice para ver mas elementos</span>
        </div>
    </div>
</div>
<script id="product:stock:list:template" type="text/template">
    <% if(stocks.length === 0) { %>
    <tr>
        <td colspan="20" class="p-4">No se encontro stock</td>
    </tr>
    <% } %>
    <% stocks.forEach(function(stock){ %>
    <tr class="bg-blue-100">
        <td class="p-4 font-medium">
            <%= stock.warehouse %>
        </td>
        <td class="p-4 font-medium">
            <%= stock.stock %> disponibles
        </td>
    </tr>
    <% }) %>
</script>
