<div id="session:close:modal" class="modal hidden">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="text-2xl text-slate-gray-700 font-semibold">{{ trans('cashup') }}
                &centerdot; {{ terminal.nombre }}
            </h2>
            <a class="btn btn-icon btn-light ml-auto" href="{{ context.session().url() }}" target="_blank">
                <i class="fa fw fa-eye"></i>
            </a>
            <a class="btn btn-icon btn-primary ml-2" href="{{ terminal.url('edit') }}" target="_blank" title="{{ terminal.nombre }}">
                <i class="fa-solid fa-desktop"></i>
            </a>
            <button class="btn btn-icon btn-success ml-2" title="{{ trans('print-z') }}"
                    data-action="session:report:x">
                <i class="fa fa-print fa-fw"></i>
            </button>
            <button class="btn btn-icon btn-danger ml-2" data-toggle="modal" data-target="session:close:modal">
                <i class="fa fw fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <form id="closeSessionForm" method="POST">
                <input type="hidden" name="action" value="session:close">
                <p>Detalle de monedas / billetes</p>
                <div class="grid grid-cols-4 gap-4 mt-4">
                    {% for denominacion in context.config().getDenominations() %}
                        <div class="form-group">
                            <span class="text-xl font-medium text-left">{{ denominacion.valor }} X </span>
                            <input name="cash[{{ denominacion.valor }}]" type="number" value="0">
                        </div>
                    {% else %}
                        <div class="alert alert-warning" role="alert">
                            No hay denominaciones registradas, registralas en.
                            <a href="{{ trans('EditConfiguracionPOS') }}">{{ trans('pos-settings') }}</a>
                        </div>
                    {% endfor %}
                </div>
            </form>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-warning btn-round" id="closeSessionButton" data-action="session:close"
                    data-toggle="modal" data-target="session:close:modal">
                {{ trans('continue') }}</button>
        </div>
    </div>
</div>
