<div id="product:edit:modal" class="modal hidden">
    <!--content-->
    <div class="modal-content">
        <!--header-->
        <div class="modal-header">
            <h2 class="text-2xl text-slate-gray-700 font-semibold">{{ trans('edit') }}</h2>
            <button class="btn btn-icon btn-danger ml-2" data-toggle="modal" data-target="product:edit:modal">
                <i class="fa fw fa-times"></i>
            </button>
        </div>
        <!--body-->
        <div class="modal-body">
            <div id="cartEditTemplateView" class="grid grid-cols-2 gap-4 items-end">
            </div>
        </div>
    </div>
</div>
<script id="cartEditTemplate" type="text/template">
    {% for column in grid %}
        {% set label = column.tittle ?: trans(column.name)%}
        {%- if column.data == 'referencia' -%}
            <div class="col-span-2 form-group">
                <label for="{{ column.data }}" class="font-semibold capitalize">{{ label }} </label>
                <input id="{{ column.data }}" type="{{ column.type }}" class="font-normal form-control"
                       value="<%= product.referencia %>" data-action="cart:product:field:edit"
                       data-index="<%= product.index %>" data-field="{{ column.data }}" readonly>
            </div>
        {%- elseif column.data == 'descripcion' %}
            <div class="col-span-2 form-group">
                <label for="{{ column.data }}" class="font-semibold capitalize">{{ label }}</label>
                <textarea id="{{ column.data }}" class="font-normal form-control" rows="3"
                          data-action="cart:product:field:edit"
                          data-index="<%= product.index %>" data-field="{{ column.data }}"
                        {% if column.readonly %} readonly {% endif %}><%= product.descripcion %>
                </textarea>
            </div>
        {% elseif column.eneabled -%}
            <div class="form-group">
                <label for="{{ column.data }}" class="font-semibold capitalize">{{ label }}</label>
                <input id="{{ column.data }}" class="font-normal form-control" type="{{ column.type }}"
                       value="<%= product.{{ column.data }} %>"
                       step=".001" data-index="<%= product.index %>"
                       data-action="{{ column.readonly ? '' : 'cart:product:field:edit' }}"
                       data-field="{{ column.data }}" {% if column.readonly %} readonly {% endif %}>
            </div>
        {% endif -%}
    {% endfor %}
</script>
