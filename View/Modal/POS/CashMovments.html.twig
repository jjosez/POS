<div id="moneyInOutModal" class="modal hidden">
    <div class="modal-content md:modal-content-sm">
        <div class="modal-header">
            <h2 class="text-2xl text-slate-gray-700 font-semibold">{{ trans('till-session-cash-movments') }}</h2>
            <button class="btn btn-icon btn-danger ml-2" data-toggle="modal" data-target="moneyInOutModal">
                <i class="fa fw fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="border-b border-gray-200 dark:border-gray-700 mb-4">
                <ul class="flex flex-wrap -mb-px tablist" data-target="cash-movments" role="tablist">
                    <li class="mr-2" role="presentation">
                        <button class="tab tab-active" data-toggle="tab" data-target="cash-entry"
                                type="button" role="tab"
                                aria-controls="entry">{{ trans('deposit') }}
                        </button>
                    </li>
                    <li class="mr-2" role="presentation">
                        <button class="tab" data-toggle="tab" data-target="cash-withdraw"
                                type="button" role="tab"
                                aria-controls="dashboard">{{ trans('withdraw') }}
                        </button>
                    </li>
                </ul>
            </div>
            <div class="mt-3" id="cash-movments">
                <div id="cash-entry" role="tabpanel" aria-labelledby="tabs-with-underline-item-1"
                     class="tabcontent">
                    <form id="cashEntryForm" method="POST">
                        <input type="hidden" name="action" value="cash-entry-action">
                        <input type="hidden" name="token" value="{{ fsc.getNewToken() }}">
                        <div class="form-group mt-4">
                            <span class="font-medium">{{ trans('amount') }}</span>
                            <input name="amount" type="number" required>
                        </div>
                        <div class="form-group mt-2">
                            <span class="font-medium">{{ trans('description') }}</span>
                            <input name="description" type="text" required>
                        </div>
                    </form>
                    <button type="submit" class="mt-4 mx-auto btn btn-primary btn-round"
                            data-action="cashEntryAction"
                            data-toggle="modal" data-target="moneyInOutModal">
                        {{ trans('deposit') }}</button>
                </div>
                <div id="cash-withdraw" class="tabcontent hidden" role="tabpanel"
                     aria-labelledby="cash-withdraw">
                    <form id="cashWithdrawForm" method="POST">
                        <input type="hidden" name="action" value="cash-withdraw-action">
                        <input type="hidden" name="token" value="{{ fsc.getNewToken() }}">
                        <div class="form-group mt-4">
                            <span class="font-medium">{{ trans('amount') }}</span>
                            <input name="amount" type="number" required>
                        </div>
                        <div class="form-group mt-2">
                            <span class="font-medium">{{ trans('description') }}</span>
                            <input name="description" type="text" required>
                        </div>
                    </form>
                    <button type="submit" class="mt-4 mx-auto btn btn-warning btn-round"
                            data-action="cashWithdrawAction"
                            data-toggle="modal" data-target="moneyInOutModal">
                        {{ trans('withdraw') }}</button>
                </div>
            </div>
        </div>
    </div>
</div>
