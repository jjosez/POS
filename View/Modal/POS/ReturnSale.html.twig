<div id="returnSaleModal" class="hidden modal">
    <div class="h-full modal-content md:modal-content-xl">
        <div class="modal-header">
            <h2 class="text-2xl font-semibold text-slate-gray-700">
                {{ trans('sales-returns') }}
            </h2>

            <button class="ml-auto btn btn-sm btn-light" data-action="clearReturnSaleAction">
                <i class="fa fw fa-eraser"></i>
            </button>

            <button class="ml-2 btn btn-icon btn-danger" data-toggle="modal" data-target="returnSaleModal">
                <i class="fa fw fa-times"></i>
            </button>
        </div>

        {# Búsqueda de venta #}
        <div class="border-b border-slate-200 bg-slate-50 p-4">
            <form id="returnSaleSearchForm" class="flex flex-col gap-2 md:flex-row md:items-center" data-action="searchReturnOrderAction">
                <div class="flex-1">
                    <label class="mb-1 block text-xs font-semibold uppercase text-slate-500">
                        {{ trans('search-sale') }}
                    </label>
                    <input type="text" name="term" autocomplete="off"
                           class="form-control"
                           placeholder="{{ trans('code') }}, {{ trans('customer') }}, {{ trans('date') }}">
                </div>

                <div class="flex gap-2 pt-2 md:pt-0">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fw fa-search"></i> {{ trans('search') }}
                    </button>

                    <button type="button" class="btn btn-light" data-action="loadLastOrderForReturnAction">
                        <i class="fa fw fa-clock-rotate-left"></i> {{ trans('last-order') }}
                    </button>
                </div>
            </form>

            <div id="returnSaleSearchResultView" class="mt-3"></div>
        </div>

        <div class="modal-body">
            {# Aquí se pintan las líneas de la venta seleccionada #}
            <div id="returnSaleLinesTemplateView"></div>
        </div>

        <div class="modal-footer flex items-center justify-between">
            <div class="text-xs text-slate-500">
                <span class="font-semibold">
                    {{ trans('info') }}:
                </span>
                {{ trans('selected-lines-will-be-sent-as-negative-sale') }}
            </div>

            <div class="flex items-center gap-4">
                <div class="text-right">
                    <div class="text-xs uppercase text-slate-500">
                        {{ trans('return-total') }}
                    </div>
                    <div id="returnSaleTotalView" class="text-lg font-semibold text-red-600">
                        0,00
                    </div>
                </div>

                <button type="button"
                        class="btn btn-danger"
                        data-action="confirmReturnSaleAction"
                        disabled>
                    <i class="fa fw fa-rotate-left"></i> {{ trans('apply-return') }}
                </button>
            </div>
        </div>
    </div>
</div>
