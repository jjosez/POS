<div id="customer:search:modal" class="modal hidden">
    <!--content-->
    <div class="modal-content md:modal-content-sm min-h-4/5">
        <!--header-->
        <div class="modal-header flex-col items-stretch gap-3 p-4">
            <div class="flex items-center">
                <div class="flex min-w-0 items-center gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0">
                        <h2 class="text-xl font-semibold text-slate-900">{{ trans('customer') }}</h2>
                        <p class="truncate text-sm text-slate-500">{{ trans('search') }}</p>
                    </div>
                </div>
                <button type="button" class="btn btn-icon btn-success ml-auto"
                        data-toggle="collapse" data-target="newCustomerForm"
                        aria-label="{{ trans('new') }}">
                    <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-icon btn-naked ml-2"
                        data-toggle="modal" data-target="customer:search:modal"
                        aria-label="{{ trans('close') }}">
                    <i class="fa-solid fa-times" aria-hidden="true"></i>
                </button>
            </div>
            <label class="input-icon text-gray-400">
                <span><i class="fa-solid fa-search fa-sm" aria-hidden="true"></i></span>
                <input type="search" id="customerSearchBox" placeholder="{{ trans('search') }}" data-view="CartView">
            </label>
        </div>
        <!--body-->
        <div class="modal-body p-0">
            <div class="hidden p-5" id="newCustomerForm">
                <div class="form-group">
                    <label for="newCustomerTaxID" class="mb-2">{{ trans('cifnif') }}</label>
                    <input type="text" class="form-control" id="newCustomerTaxID">
                </div>
                <div class="form-group my-2">
                    <label for="newCustomerName" class="mb-2">{{ trans('name-or-business-name') }}</label>
                    <input type="text" class="form-control" id="newCustomerName">
                </div>
                <div class="form-group my-4">
                    <button class="btn justify-center bg-blue-500 hover:bg-blue-600" type="button"
                            id="newCustomerSaveButton" data-toggle="collapse" data-target="newCustomerForm"
                            data-action="customer:save">{{ trans('save') }}</button>
                </div>
            </div>
            <div class="p-3 sm:p-4">
                <div id="customer:list:view" class="flex flex-col gap-2" role="list" aria-live="polite">
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <span><i class="fas fa-arrow-down"></i> {{ trans('scroll-for-more') }}</span>
        </div>
    </div>
</div>
<script id="customer:list:template" type="text/template">
    <% const initialFor = s => { const t = (s || '').trim(); return t ? t.charAt(0).toUpperCase() : '#'; }; %>
    <% const _ctx = it || {}; %>
    <% const customerList = Array.isArray(_ctx.customers) ? _ctx.customers : []; %>
    <% const isLoading = !!_ctx.loading; %>
    <% if (isLoading) { %>
    <div class="flex flex-col gap-2" aria-busy="true" aria-live="polite">
        <% for (let i = 0; i < 4; i++) { %>
        <div class="flex w-full items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2 min-h-14">
            <span class="h-8 w-8 shrink-0 animate-pulse rounded-xl bg-slate-200"></span>
            <span class="flex min-w-0 flex-1 flex-col gap-2">
                <span class="h-3.5 w-2/3 animate-pulse rounded bg-slate-200"></span>
                <span class="h-3 w-1/3 animate-pulse rounded bg-slate-100"></span>
            </span>
        </div>
        <% } %>
    </div>
    <% } else if(customerList.length === 0) { %>
    <div class="flex min-h-48 flex-col items-center justify-center rounded-lg border border-dashed border-slate-200 bg-slate-50 p-6 text-center text-sm text-slate-400">
        <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-white text-slate-400 ring-1 ring-slate-200">
            <i class="fa-solid fa-user-slash text-2xl" aria-hidden="true"></i>
        </div>
        <div class="font-semibold text-slate-700">{{ trans('no-results') }}</div>
        <p class="mt-1 text-sm text-slate-500">{{ trans('no-customers-found') }}</p>
    </div>
    <% } %>
    <% customerList.forEach(function(customer){ %>
    <button type="button" role="listitem"
            class="add-customer-btn group pointer-events-auto flex w-full items-center gap-3 rounded-lg border border-slate-200 bg-white px-3 py-2 min-h-14 text-left transition focus:outline-none focus:ring-2 focus-within:ring-blue-400 hover:border-blue-300 hover:bg-slate-50 active:bg-slate-100/60"
            data-action="cart:customer:set"
            data-code="<%= customer.code %>" data-description="<%= customer.description %>">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-white text-xs font-bold uppercase text-slate-700 ring-1 ring-slate-200 transition group-hover:bg-slate-100" aria-hidden="true">
            <%= initialFor(customer.description) %>
        </span>
        <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-semibold text-slate-800"><%= customer.description %></span>
            <% if(customer.details && customer.details.length) { %>
            <span class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                <% customer.details.forEach(function(detail){ %>
                <% const labelText = detail.label
                    ? detail.label.charAt(0).toUpperCase() + detail.label.slice(1).toLowerCase()
                    : ''; %>
                <span class="inline-flex min-w-0 max-w-full items-baseline gap-1.5 truncate">
                    <% if(labelText) { %>
                    <span class="text-xs text-slate-400"><%= labelText %>:</span>
                    <% } %>
                    <span class="truncate text-xs font-semibold<% if(detail.tone === 'danger') { %> text-red-700<% } else if(detail.tone === 'warning') { %> text-amber-700<% } else if(detail.tone === 'success') { %> text-emerald-700<% } else if(detail.tone === 'info') { %> text-blue-700<% } else { %> text-slate-700<% } %>"><%= detail.value %></span>
                </span>
                <% }) %>
            </span>
            <% } %>
        </span>
    </button>
    <% }) %>
</script>
