<div id="printModal" class="modal hidden">
    <div class="modal-content md:modal-content-sm">
        <div class="modal-header">
            <h2 class="text-2xl text-slate-gray-700 font-semibold">{{ trans('print') }}</h2>
            <button class="btn btn-icon btn-danger ml-2" data-toggle="modal" data-target="printModal">
                <i class="fa fw fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <div id="printSelectionTemplateView" class="flex flex-col space-y-2">
            </div>
        </div>
        <div class="modal-footer">
        </div>
    </div>
</div>
<script id="printSelectionTemplate" type="text/template">
    {% for format in fsc.getSaleTicketFormats() %}
        <button class="btn btn-block btn-light"
                data-action="printOrderAction"
                data-code="<%= it.data.lastOrderID %>"
                data-format="{{ format.ticketAction }}">
            <i class="{{ format.ticketIcon }}"></i> {{ format.ticketTitle }}
        </button>
    {% endfor %}
    <button class="btn btn-block btn-light"
            data-action="printOrderAction"
            data-code="<%= it.data.lastOrderID %>"
            data-format="normal">
        <i class="fas fa-receipt fa-fw"></i>{{ trans('normal') }}
    </button>
    <button class="btn btn-block btn-light hover:bg-gray-200/75"
            data-action="printOrderAction"
            data-code="<%= it.data.lastOrderID %>"
            data-format="gift">
        <i class="fas fa-gift fa-fw"></i>{{ trans('gift') }}
    </button>
    <button class="btn btn-block btn-light hover:bg-gray-200/75"
            data-action="printOrderAction"
            data-code="<%= it.data.lastOrderID %>"
            data-format="mail">
        <i class="fas fa-envelope fa-fw"></i>{{ trans('send-mail') }}
    </button>
    <button class="btn btn-block btn-light hover:bg-gray-200/75"
            data-action="printOrderAction"
            data-code="<%= it.data.lastOrderID %>"
            data-format="pdf">
        <i class="fas fa-envelope fa-fw"></i>PDF
    </button>
</script>
