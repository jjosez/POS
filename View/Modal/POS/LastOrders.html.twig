<div id="order:last:list:modal" class="hidden modal" role="dialog" aria-modal="true"
     aria-labelledby="lastOrdersTitle">
    <div class="h-full modal-content md:w-4/5 md:max-w-4xl">
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <h2 id="lastOrdersTitle" class="text-xl font-semibold text-slate-900">{{ trans('last-orders') }}</h2>
                    <p class="truncate text-sm text-slate-500">{{ trans('till-session-operations') }}</p>
                </div>
            </div>
           {# <button class="ml-auto btn btn-icon btn-primary" data-action="session:close">
                <i class="fa fw fa-arrow-down-wide-short"></i>
            </button>#}
            <button type="button" class="ml-2 btn btn-icon btn-naked" data-toggle="modal"
                    data-target="order:last:list:modal" aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal-body">
            <div id="last:order:list:view">
                <div class="flex justify-center py-8"></div>
            </div>
        </div>
        <div class="modal-footer">
            <span><i class="fas fa-arrow-down"></i> {{ trans('scroll-to-more') }}</span>
        </div>
    </div>
</div>
<script id="last:order:list:template" type="text/template">
    <% if(orders.length === 0) { %>
    <div class="flex flex-1 rounded-lg bg-blue-100 p-2 shadow-xs md:flex-row">
        <span>{{ trans('no-data') }}</span>
    </div>
    <% } %>
    <% if (orders.length > 0) { %>
    <div class="space-y-2">
    <% orders.forEach(function(order){ %>
    <% const isRefund = order.esdevolucion === true || order.esdevolucion === 1 || order.esdevolucion === '1'; %>
    <div class="rounded-xl border border-l-3 border-slate-200 bg-white px-4 py-3 transition-colors hover:border-slate-300 hover:bg-slate-50/50
        <%= isRefund ? 'border-l-orange-500' : 'border-l-blue-500' %>">
        <div class="grid grid-cols-2 gap-x-4 gap-y-2 md:grid-cols-[minmax(0,1fr)_minmax(7rem,0.42fr)_minmax(8rem,0.38fr)_auto] md:items-center md:gap-4">
            <div class="col-span-2 min-w-0 md:col-span-1">
                <div class="text-base font-semibold leading-tight text-slate-800">
                    <%= isRefund ? '{{ trans('refund') }}' : '{{ trans('sale-operation') }}' %>
                </div>
                <div class="mt-0.5 truncate text-sm font-semibold leading-tight text-slate-700"><%= order.codigo %></div>
                <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                    <% if (order.nombrecliente) { %>
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-user-tag text-slate-400" aria-hidden="true"></i>
                        <%= order.nombrecliente %>
                    </span>
                    <% } %>
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-regular fa-calendar text-slate-400" aria-hidden="true"></i>
                        <%= order.fecha %>
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-regular fa-clock text-slate-400" aria-hidden="true"></i>
                        <%= order.hora %>
                    </span>
                </div>
            </div>

            <div class="min-w-0">
                <div class="text-xs font-medium uppercase tracking-wide text-slate-400">{{ trans('method') }}</div>
                <div class="truncate text-sm font-semibold leading-5 text-slate-700">
                    <% if (order.paymentMethod) { %><%= order.paymentMethod %><% } else { %>&mdash;<% } %>
                </div>
            </div>

            <div class="text-right md:text-left">
                <div class="text-xs font-medium uppercase tracking-wide text-slate-400">{{ trans('total') }}</div>
                <div class="text-lg font-bold leading-5 tabular-nums <%= isRefund || Number.parseFloat(order.total) < 0 ? 'text-red-600' : 'text-slate-900' %>">
                    <% if (Number.parseFloat(order.total) < 0) { %>-<% } %>{{ context.currency().getCurrency().simbolo }}<%= order.absoluteTotalFormatted %>
                </div>
            </div>

            <div class="col-span-2 flex items-center justify-end gap-1.5 md:col-span-1">
                <a href="<%= order.url %>" target="_blank"
                   class="btn btn-icon btn-naked h-10 w-10 text-slate-500 hover:text-blue-700"
                   title="{{ trans('open') }}" aria-label="{{ trans('open') }}">
                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                </a>
                <button type="button" class="btn btn-icon btn-naked h-10 w-10 text-slate-500 hover:text-blue-700"
                        title="{{ trans('print') }}" aria-label="{{ trans('print') }}"
                        data-action="print:order:context"
                        data-code="<%= order.iddocumento %>"
                        data-model="<%= order.tipodoc %>"
                        data-order="<%= order.idoperacion %>">
                    <i class="fa-solid fa-print" aria-hidden="true"></i>
                </button>
                <% if (!isRefund) { %>
                <button type="button" class="btn btn-icon btn-naked h-10 w-10 text-slate-500 hover:text-orange-700"
                        title="{{ trans('refund') }}" aria-label="{{ trans('refund') }}"
                        data-action="returns:sale:open:from-list:action"
                        data-code="<%= order.iddocumento %>"
                        data-model="<%= order.tipodoc %>"
                        data-order="<%= order.idoperacion %>">
                    <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                </button>
                <% } else { %>
                <span class="invisible h-10 w-10" aria-hidden="true"></span>
                <% } %>
            </div>
        </div>
    </div>
    <% }) %>
    </div>
    <% } %>
</script>
