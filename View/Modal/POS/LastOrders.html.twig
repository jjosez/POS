<div id="order:last:list:modal" class="hidden modal">
    <div class="h-full modal-content md:w-4/5 md:max-w-4xl">
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-xl font-semibold text-slate-900">{{ trans('last-orders') }}</h2>
                    <p class="truncate text-sm text-slate-500">{{ trans('till-session-operations') }}</p>
                </div>
            </div>
             {#<button class="ml-auto btn btn-icon btn-primary" data-action="session:close">
                <i class="fa fw fa-arrow-down-wide-short"></i>
            </button> #}
            <button type="button" class="ml-2 btn btn-icon btn-naked" data-toggle="modal" data-target="order:last:list:modal" aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="m-4 hidden items-center rounded-lg bg-blue-500 p-4 text-white md:flex shadow-sm ">
            <div class="flex-1">
                <span class="font-semibold capitalize italic">{{ trans('code') }}</span>
            </div>
            <div class="flex-1">
                <span class="font-semibold capitalize italic">{{ trans('customer') }}</span>
            </div>
            <div class="flex-1 text-center">
                <span class="font-semibold capitalize italic">{{ trans('total') }}</span>
            </div>
            <div class="flex-1 text-center">
                <span class="font-semibold capitalize italic">{{ trans('date') }}</span>
            </div>
            <div class="flex justify-center w-24">
                <span class="font-semibold capitalize italic"><i class="fas fa-tools"></i></span>
            </div>
        </div>
        <div class="modal-body">
            <div id="last:order:list:view">
                <div class="flex justify-center py-8">
                    <svg class="w-12 h-12 animate-spin text-blue-500" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M32 3C36.5778 3 41.0906 4.08374 45.1692 6.16256C49.2477 8.24138 52.7762 11.2562 55.466 14.9605C58.1558 18.6647 59.9304 22.9531 60.6448 27.4748C61.3591 31.9965 60.9928 36.6232 59.5759 40.9762" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"></path>
                    </svg>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <span><i class="fas fa-arrow-down"></i> {{ trans('scroll-to-more') }}</span>
        </div>
    </div>
</div>
<script id="last:order:list:template" type="text/template">
    <% if(orders.length === 0) { %>
    <div class="flex flex-1 rounded-lg bg-blue-100 p-2 shadow-xs md:flex-row">
        <span>{{ trans('no-data') }}</span>
    </div>
    <% } %>
    <% orders.forEach(function(order){ %>
    <div class="mb-4 p-2 flex cursor-pointer flex-col rounded-lg bg-slate-100 md:flex-row
    <% if (order.dtomecanico) { %>table-row-red<% } else { %>hover:bg-yellow-100<% } %>">
        <div class="flex flex-1 flex-col items-center md:flex-row">
            <div class="flex-1">
                <span class="font-semibold capitalize italic md:hidden">{{ trans('code') }}: </span>
                <%= order.codigo %>
            </div>
            <div class="flex-1">
                <span class="font-semibold capitalize italic md:hidden">{{ trans('customer') }}: </span>
                <%= order.nombrecliente %>
            </div>
            <div class="flex-1 text-right">
                <span class="font-semibold capitalize italic md:hidden">{{ trans('total') }}: </span>
                <%= order.totalFormatted %>
            </div>
            <div class="flex-1 text-right">
                <span class="font-semibold capitalize italic md:hidden">{{ trans('date') }}: </span>
                <%= order.fecha %> <%= order.hora %>
            </div>
            <p><%= order.observaciones || '' %></p>
        </div>
        <div class="mt-4 flex items-center justify-between md:mt-0">
            <button type="button"
                    class="mx-2 btn btn-icon btn-light"
                    data-action="print:order:context"
                    data-code="<%= order.iddocumento %>"
                    data-model="<%= order.tipodoc %>"
                    data-order="<%= order.idoperacion %>">
                <i class="fas fa-print fa-sm"></i>
            </button>
            <button type="button"
                    class="mr-2 btn btn-icon btn-warning"
                    title="{{ trans('refund') }}"
                    data-action="returns:sale-open-from-list:action"
                    data-code="<%= order.iddocumento %>"
                    data-model="<%= order.tipodoc %>"
                    data-order="<%= order.idoperacion %>">
                <i class="fa-solid fa-hand-holding-dollar fa-fw"></i>
            </button>
            <a href="<%= order.url %>" type="button" target="_blank" class="btn btn-icon btn-primary">
                <i class="fas fa-file-invoice fa-sm"></i>
            </a>
        </div>
    </div>
    <% }) %>
</script>
