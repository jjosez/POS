<div id="draftOrdersModal" class="hidden modal">
    <div class="h-full modal-content md:w-4/5 md:max-w-4xl">
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-xl font-semibold text-slate-900">{{ trans('pos-orders-on-hold') }}</h2>
                    <p class="truncate text-sm text-slate-500">{{ trans('paused-orders') }}</p>
                </div>
            </div>
            <button type="button" class="ml-2 btn btn-icon btn-naked" data-toggle="modal" data-target="draftOrdersModal" aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal-body">
            <div id="draft:order:list:view" class="p-0">
            </div>
        </div>
        <div class="modal-footer">
            <span><i class="fas fa-arrow-down"></i> {{ trans('scroll-to-more') }}</span>
        </div>
    </div>
</div>

<script id="draft:order:list:template" type="text/template">
    <% if(drafts.length === 0 && refunds.length === 0) { %>
    <div class="flex min-h-48 flex-col items-center justify-center rounded-xl bg-slate-50 p-6 text-center">
        <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-white text-slate-400">
            <i class="fa-solid fa-box-archive text-2xl" aria-hidden="true"></i>
        </div>
        <div class="font-semibold text-slate-700">{{ trans('no-draft-orders') }}</div>
        <p class="mt-1 max-w-sm text-sm text-slate-500">{{ trans('no-draft-orders-description') }}</p>
    </div>
    <% } %>

    <% if(drafts.length > 0) { %>
    <div class="space-y-2">
    <% drafts.forEach(function(order){ %>
    <% const rowColor = order.rowcolor || 'slate'; %>
    <div class="rounded-xl bg-<%= rowColor %>-50 px-4 py-3 transition-colors hover:bg-<%= rowColor %>-100">
        <div class="grid grid-cols-2 gap-x-4 gap-y-2 md:grid-cols-[minmax(0,1fr)_minmax(8rem,0.38fr)_auto] md:items-center md:gap-4">
            <button type="button" class="col-span-2 min-w-0 text-left md:col-span-1"
                    data-action="order:draft:resume" data-code="<%= order.idpausada %>">
                <span class="block truncate text-sm font-semibold leading-tight text-slate-800"><%= order.codigo %></span>
                <span class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                    <% if (order.nombrecliente) { %>
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-user-tag text-slate-400" aria-hidden="true"></i>
                        <%= order.nombrecliente %>
                    </span>
                    <% } %>
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-regular fa-calendar text-slate-400" aria-hidden="true"></i>
                        <%= order.fecha %>
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-regular fa-clock text-slate-400" aria-hidden="true"></i>
                        <%= order.hora %>
                    </span>
                </span>
                <% if (order.observaciones) { %>
                <span class="mt-1 block truncate text-xs italic text-slate-400"><%= order.observaciones %></span>
                <% } %>
            </button>

            <div class="text-right md:text-left">
                <div class="text-xs font-medium uppercase tracking-wide text-slate-400">{{ trans('total') }}</div>
                <div class="text-lg font-bold leading-5 tabular-nums <%= Number.parseFloat(order.total) < 0 ? 'text-red-600' : 'text-slate-900' %>">
                    <% if (Number.parseFloat(order.total) < 0) { %>-<% } %><%= Math.abs(Number.parseFloat(order.total) || 0).toFixed(2) %>
                </div>
            </div>

            <div class="flex items-center justify-end gap-1.5">
                <button type="button" class="btn btn-icon btn-naked h-10 w-10 text-slate-500 hover:text-blue-700"
                        title="{{ trans('continue') }}" aria-label="{{ trans('continue') }}"
                        data-action="order:draft:resume" data-code="<%= order.idpausada %>">
                    <i class="fa-solid fa-cart-arrow-down" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-icon btn-naked h-10 w-10 text-slate-500 hover:text-blue-700"
                        title="{{ trans('print') }}" aria-label="{{ trans('print') }}"
                        data-action="print:draft:context" data-code="<%= order.idpausada %>"
                        data-model="BorradorPuntoVenta" data-order="">
                    <i class="fa-solid fa-print" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-icon btn-naked h-10 w-10 text-slate-500 hover:text-red-700"
                        title="{{ trans('delete') }}" aria-label="{{ trans('delete') }}"
                        data-action="order:draft:delete" data-code="<%= order.idpausada %>">
                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>
    <% }); %>
    </div>
    <% } %>

    <% if(refunds.length > 0) { %>
    <div class="mb-2 mt-5 px-1 text-xs font-medium uppercase tracking-wide text-slate-500">
        {{ trans('pos-refund-drafts') }}
    </div>
    <div class="space-y-2">
    <% refunds.forEach(function(draft){ %>
    <div class="rounded-xl bg-red-50/50 px-4 py-3 transition-colors hover:bg-red-100/50">
        <div class="grid grid-cols-2 gap-x-4 gap-y-2 md:grid-cols-[minmax(0,1fr)_minmax(8rem,0.38fr)_auto] md:items-center md:gap-4">
            <button type="button" class="col-span-2 min-w-0 text-left md:col-span-1"
                    data-action="returns:draft:resume:action" data-id="<%= draft.iddevolucion %>">
                <span class="flex min-w-0 items-center gap-2 leading-tight">
                    <span class="truncate text-sm font-semibold text-slate-800"><%= draft.codigo_original %></span>
                    <% if (draft.codigo) { %>
                    <span class="h-4 w-px shrink-0 bg-slate-300" aria-hidden="true"></span>
                    <span class="shrink-0 text-xs font-medium uppercase tracking-wide text-slate-500"><%= draft.codigo %></span>
                    <% } %>
                </span>
                <span class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
                    <% if (draft.nombrecliente) { %>
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-user-tag text-slate-400" aria-hidden="true"></i>
                        <%= draft.nombrecliente %>
                    </span>
                    <% } %>
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-regular fa-calendar text-slate-400" aria-hidden="true"></i>
                        <%= draft.fecha %>
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <i class="fa-regular fa-clock text-slate-400" aria-hidden="true"></i>
                        <%= draft.hora %>
                    </span>
                </span>
            </button>

            <div class="text-right md:text-left">
                <div class="text-xs font-medium uppercase tracking-wide text-slate-400">{{ trans('total') }}</div>
                <div class="text-lg font-bold leading-5 tabular-nums text-red-600">
                    -{{ context.currency().getCurrency().simbolo }}<%= Math.abs(Number.parseFloat(draft.total) || 0).toFixed(2) %>
                </div>
            </div>

            <div class="flex items-center justify-end gap-1.5">
                <button type="button" class="btn btn-icon btn-light h-10 w-10 text-blue-700"
                        title="{{ trans('continue') }}" aria-label="{{ trans('continue') }}"
                        data-action="returns:draft:resume:action" data-id="<%= draft.iddevolucion %>">
                    <i class="fa-solid fa-play" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-icon btn-naked h-10 w-10 text-slate-500 hover:text-red-700"
                        title="{{ trans('delete') }}" aria-label="{{ trans('delete') }}"
                        data-action="order:refund:draft:delete" data-id="<%= draft.iddevolucion %>">
                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>
    <% }); %>
    </div>
    <% } %>
</script>
