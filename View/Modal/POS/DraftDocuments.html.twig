<div id="draftOrdersModal" class="hidden modal">
    <div class="h-full modal-content md:modal-content-lg">
        <div class="modal-header">
            <h2 class="text-2xl font-semibold text-slate-gray-700">{{ trans('pos-orders-on-hold') }}</h2>
            <button class="ml-2 btn btn-icon btn-naked" data-toggle="modal" data-target="draftOrdersModal">
                <i class="fa fw fa-times"></i>
            </button>
        </div>
        <div class="m-4 hidden items-center rounded-lg bg-blue-500 p-4 text-white md:flex">
            <div class="flex-1 text-center">
                <span class="font-semibold capitalize italic">{{ trans('code') }}</span>
            </div>
            <div class="flex-1 text-center">
                <span class="font-semibold capitalize italic">{{ trans('customer') }}</span>
            </div>
            <div class="flex-1 text-center">
                <span class="font-semibold capitalize italic">{{ trans('total') }}</span>
            </div>
            <div class="flex-1 text-center">
                <span class="font-semibold capitalize italic">{{ trans('date') }}</span>
            </div>
            <div class="flex w-24 justify-center">
                <span class="font-semibold capitalize italic"><i class="fas fa-tools"></i></span>
            </div>
        </div>
        <div class="modal-body">
            <div id="draft:order:list:view" class="p-0">
                <div class="flex justify-center py-8">
                    <svg class="w-12 h-12 animate-spin text-blue-500" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M32 3C36.5778 3 41.0906 4.08374 45.1692 6.16256C49.2477 8.24138 52.7762 11.2562 55.466 14.9605C58.1558 18.6647 59.9304 22.9531 60.6448 27.4748C61.3591 31.9965 60.9928 36.6232 59.5759 40.9762" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"></path>
                    </svg>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <span><i class="fas fa-arrow-down"></i> {{ trans('scroll-to-more') }}</span>
        </div>
    </div>
</div>
</div>

<script id="draft:order:list:template" type="text/template">
    <% if(drafts.length === 0 && refunds.length === 0) { %>
    <div class="flex flex-1 rounded-lg bg-blue-100 p-2 shadow-xs md:flex-row">
        <span>{{ trans('no-data') }}</span>
    </div>
    <% } %>

    <% if(drafts.length > 0) { %>
    {#<div class="mb-2 px-2 py-1 text-sm font-semibold uppercase text-slate-500 border-b border-slate-200">
        {{ trans('pos-orders-on-hold') }}
    </div>#}
    <% drafts.forEach(function(order){ %>
    <div class="mb-4 p-2 flex cursor-pointer flex-col rounded-lg md:flex-row bg-<%= order.rowcolor %>-100 hover:bg-<%= order.rowcolor %>-200">
        <div class="flex flex-1 flex-col items-center md:flex-row"
             data-action="order:draft:resume" data-code="<%= order.idpausada %>">
                <div class="flex-1 pointer-events-none">
                    <span class="font-semibold capitalize italic md:hidden">{{ trans('code') }}: </span>
                    <%= order.codigo %>
                </div>
                <div class="flex-1 pointer-events-none">
                    <span class="font-semibold capitalize italic md:hidden">{{ trans('customer') }}:</span>
                    <%= order.nombrecliente %>
                </div>
                <div class="flex-1 pointer-events-none text-right">
                    <span class="font-semibold capitalize italic md:hidden">{{ trans('total') }}: </span>
                    <span class="<% if (order.total <= 0) { %>text-red-500<% } %>">
                    <%= order.total %></span>
                </div>
                <div class="flex-1 text-right pointer-events-none">
                    <span class="font-semibold capitalize italic md:hidden">{{ trans('date') }}: </span>
                    <%= order.fecha %> <%= order.hora %>
                </div>
            <span class="text-sm italic pointer-events-none">
                <%= order.observaciones || '' %>
            </span>
        </div>
        <div class="mt-4 flex items-center justify-between md:mt-0">
            <button type="button" class="mx-2 btn btn-icon btn-light"
                    data-action="print:draft:context" data-code="<%= order.idpausada %>" data-model="BorradorPuntoVenta" data-order="">
                <i class="fas fa-print fa-sm"></i>
            </button>
            <button type="button" class="btn btn-icon bg-red-50 text-red-700 hover:bg-red-100 active:bg-red-200"
                    data-action="order:draft:delete" data-code="<%= order.idpausada %>">
                <i class="fas fa-trash fa-sm"></i>
            </button>
        </div>
    </div>
    <% }); %>
    <% } %>

    <% if(refunds.length > 0) { %>
    <div class="mb-2 mt-4 px-2 py-1 text-sm font-semibold uppercase text-slate-500 border-b border-slate-200">
        {{ trans('pos-refund-drafts') }}
    </div>
    <% refunds.forEach(function(draft){ %>
    <div class="mb-4 p-2 flex cursor-pointer flex-col rounded-lg md:flex-row bg-yellow-100 hover:bg-yellow-200">
        <div class="flex flex-1 flex-col items-center md:flex-row"
             data-action="returns:draft:resume:action" data-id="<%= draft.iddevolucion %>">
                <div class="flex-1 pointer-events-none">
                    <span class="font-semibold capitalize italic md:hidden">{{ trans('code') }}: </span>
                    <span class="inline-flex items-center gap-1">
                        <i class="fa-solid fa-rotate-left text-xs"></i>
                        <%= draft.codigo_original %>
                        <% if (draft.codigo) { %>
                        <span class="text-[10px] text-slate-400 font-normal">#<%= draft.codigo %></span>
                        <% } %>
                    </span>
                </div>
                <div class="flex-1 pointer-events-none">
                    <span class="font-semibold capitalize italic md:hidden">{{ trans('customer') }}:</span>
                    <%= draft.nombrecliente %>
                </div>
                <div class="flex-1 pointer-events-none text-right">
                    <span class="font-semibold capitalize italic md:hidden">{{ trans('total') }}: </span>
                    <span class="text-red-500">-<%= Number.parseFloat(draft.total).toFixed(2) %></span>
                </div>
                <div class="flex-1 text-right pointer-events-none">
                    <span class="font-semibold capitalize italic md:hidden">{{ trans('date') }}: </span>
                    <%= draft.fecha %> <%= draft.hora %>
                </div>
            <span class="text-sm italic pointer-events-none">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-yellow-100 text-yellow-700">Devoluci&oacute;n</span>
            </span>
        </div>
        <div class="mt-4 flex items-center justify-between md:mt-0">
            <button type="button" class="btn btn-icon bg-red-50 text-red-700 hover:bg-red-100 active:bg-red-200"
                    data-action="order:refund:draft:delete" data-id="<%= draft.iddevolucion %>">
                <i class="fas fa-trash fa-sm"></i>
            </button>
        </div>
    </div>
    <% }); %>
    <% } %>
</script>
