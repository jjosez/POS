<div class="modal hidden" id="product:image:modal">
    <div class="modal-content">
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <i class="fa-solid fa-images" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-xl font-semibold text-slate-900">{{ trans('images') }}</h2>
                    <p class="truncate text-sm text-slate-500">{{ trans('product') }}</p>
                </div>
            </div>
            <button type="button" class="btn btn-icon btn-naked ml-2" data-toggle="modal" data-target="product:image:modal" aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal-body">
            <div id="product:image:list:template:view">
            </div>
        </div>
    </div>
</div>
<script id="product:image:list:template" type="text/template">
    <% if(images.length === 0) { %>
    <tr>
        <td colspan="20" class="p-4">No se encontraron imagenes</td>
    </tr>
    <% } %>
    <div class="divide-y-4 divide-dotted">
        <% images.forEach(function(image){ %>
        <div class="flex-1">
            <img class="mx-auto py-2" src="<%= image %>" alt="Imagen Producto" loading="lazy">
        </div>
        <% }) %>
    </div>
</script>
