<div id="return:sale:experimental:modal" class="hidden modal" role="dialog" aria-modal="true"
     aria-labelledby="returnExperimentalTitle">
    <div class="modal-content h-full md:h-auto md:max-h-[90vh] md:w-4/5 md:max-w-5xl">
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-amber-700">
                    <i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2">
                        <h2 id="returnExperimentalTitle" class="truncate text-xl font-semibold text-slate-900">
                            {{ trans('new-refund') }}
                        </h2>
                        <span class="rounded-full bg-violet-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-violet-700">Beta</span>
                    </div>
                    <p class="truncate text-sm text-slate-500">{{ trans('search-sale-to-return') }}</p>
                </div>
            </div>
            <button type="button" class="ml-2 btn btn-icon btn-naked"
                    data-action="returns:experimental:close:action" aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>

        <div class="border-b border-slate-200 bg-slate-50 p-3 sm:p-4">
            <div class="flex flex-col gap-2 sm:flex-row">
                <label class="input-icon min-w-0 flex-1 text-slate-400">
                    <span><i class="fa-solid fa-receipt" aria-hidden="true"></i></span>
                    <input id="returnExperimentalSearchInput" type="search" autocomplete="off" autofocus
                           aria-label="{{ trans('search-sale-to-return') }}"
                           placeholder="{{ trans('search-sale-to-return') }}">
                </label>
                <div class="grid grid-cols-2 gap-2 sm:flex">
                    <button type="button" class="btn btn-light justify-center"
                            data-action="returns:experimental:scan-focus:action">
                        <i class="fa-solid fa-barcode mr-2" aria-hidden="true"></i>
                        {{ trans('search') }}
                    </button>
                    <button type="button" class="btn btn-primary justify-center"
                            data-action="returns:sale-search:action">
                        <i class="fa-solid fa-magnifying-glass mr-2" aria-hidden="true"></i>
                        {{ trans('search') }}
                    </button>
                </div>
            </div>
            <div id="returnExperimentalOrderSummary" class="mt-3 hidden items-center gap-3 rounded-xl border border-slate-200 bg-white p-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 font-bold text-blue-700"
                     id="returnExperimentalCustomerInitial">--</div>
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                        <strong id="returnExperimentalOrderCode" class="text-slate-900"></strong>
                        <span id="returnExperimentalOrderDate" class="text-xs text-slate-500"></span>
                    </div>
                    <div id="returnExperimentalCustomerName" class="truncate text-sm text-slate-600"></div>
                </div>
                <div class="text-right">
                    <div class="text-xs uppercase tracking-wide text-slate-400">{{ trans('total') }}</div>
                    <strong id="returnExperimentalDocumentTotal" class="text-slate-900">0.00</strong>
                </div>
                <button type="button" class="btn btn-icon btn-naked shrink-0"
                        data-action="returns:experimental:change-sale:action" title="{{ trans('search-sale-to-return') }}"
                        aria-label="{{ trans('search-sale-to-return') }}">
                    <i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i>
                </button>
            </div>
            <label id="returnExperimentalFilterWrap" class="input-icon mt-3 hidden text-slate-400">
                <span><i class="fa-solid fa-filter" aria-hidden="true"></i></span>
                <input id="returnExperimentalLocalFilter" type="search" autocomplete="off"
                       aria-label="{{ trans('search') }}"
                       placeholder="{{ trans('search') }}">
            </label>
        </div>

        <div id="returnExperimentalLinesView" class="modal-body min-h-0 flex-1 bg-slate-50 p-3 sm:p-4"></div>

        <div class="modal-footer flex-col gap-3 p-3 sm:flex-row sm:items-center sm:p-4">
            <div class="flex w-full items-center justify-between gap-4 sm:w-auto sm:justify-start">
                <button type="button" id="returnExperimentalClearSelection" class="btn btn-naked px-0 text-slate-500"
                        data-action="returns:cart:clear:action" disabled>
                    <i class="fa-solid fa-eraser mr-2" aria-hidden="true"></i>
                    {{ trans('clear') }}
                </button>
                <div class="text-right sm:text-left">
                    <div class="text-xs text-slate-500"><span id="returnExperimentalSelectedCount">0</span> {{ trans('to-refund') }}</div>
                    <div class="text-xs text-slate-400"><span id="returnExperimentalSelectedUnits">0</span> {{ trans('units') }}</div>
                </div>
            </div>
            <div class="flex w-full items-center gap-3 sm:ml-auto sm:w-auto">
                <div class="min-w-24 text-right">
                    <div class="text-xs uppercase tracking-wide text-slate-500">{{ trans('return-total') }}</div>
                    <strong class="text-xl text-blue-700"><span id="returnExperimentalTotal">0.00</span></strong>
                </div>
                <button type="button" id="returnExperimentalConfirm" class="btn btn-success flex-1 justify-center sm:flex-none"
                        data-action="returns:sale-confirm:action" disabled>
                    <i class="fa-solid fa-credit-card mr-2" aria-hidden="true"></i>
                    <span>{{ trans('apply-return') }}</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script id="returnExperimentalLinesTemplate" type="text/template">
    <% if (loading) { %>
    <div class="flex min-h-48 flex-col items-center justify-center gap-3 text-slate-500">
        <i class="fa-solid fa-circle-notch animate-spin text-3xl text-blue-600"></i>
        <span class="text-sm">{{ trans('loading') }}</span>
    </div>
    <% } else if (error) { %>
    <div class="flex min-h-48 flex-col items-center justify-center gap-3 rounded-xl border border-red-200 bg-red-50 p-6 text-center text-red-700">
        <i class="fa-solid fa-circle-exclamation text-3xl"></i>
        <span class="font-semibold"><%= error %></span>
    </div>
    <% } else if (!hasOrder) { %>
    <div class="flex min-h-48 flex-col items-center justify-center gap-3 text-center text-slate-400">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white shadow-sm">
            <i class="fa-solid fa-receipt text-3xl text-slate-300"></i>
        </div>
        <span class="max-w-sm text-sm">{{ trans('search-sale-to-return') }}</span>
    </div>
    <% } else if (!lines.length) { %>
    <div class="flex min-h-48 flex-col items-center justify-center gap-3 text-center text-amber-700">
        <i class="fa-solid fa-box-open text-3xl"></i>
        <span class="font-semibold">{{ trans('no-lines-for-return') }}</span>
    </div>
    <% } else { %>
    <div class="space-y-2">
        <% lines.forEach(function(line) { %>
        <article class="rounded-xl border p-3 transition-colors <%= line.selected ? 'border-blue-300 bg-blue-50 shadow-sm' : 'border-slate-200 bg-white' %>">
            <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl <%= line.selected ? 'bg-blue-100 text-blue-700' : 'bg-slate-100 text-slate-400' %>">
                    <i class="fa-solid fa-box text-lg" aria-hidden="true"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="truncate font-semibold text-slate-900"><%= line.descripcion || line.referencia || '-' %></div>
                    <div class="truncate text-xs text-slate-500"><%= line.referencia || '-' %></div>
                    <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-slate-500">
                        <span>{{ trans('qty-sold') }}: <strong><%= line.cantidad %></strong></span>
                        <span>{{ trans('refund') }}: <strong><%= line.refunded %></strong></span>
                        <span class="text-emerald-700">{{ trans('available') }}: <strong><%= line.refundable %></strong></span>
                    </div>
                </div>
                <div class="shrink-0 text-right">
                    <div class="mb-1 text-xs text-slate-500">{{ trans('to-refund') }}</div>
                    <div class="flex items-center gap-1">
                        <button type="button" class="return-experimental-qty-minus btn btn-icon btn-light h-11 w-11"
                                data-line="<%= line.idlinea %>" aria-label="{{ trans('subtract') }}"
                                <%= line.disableDecrease ? 'disabled' : '' %>>
                            <i class="fa-solid fa-minus" aria-hidden="true"></i>
                        </button>
                        <input type="number" class="return-experimental-qty-input h-11 w-16 rounded-lg border border-slate-300 bg-white px-1 text-center font-bold text-slate-900"
                               min="0" max="<%= line.refundable %>" step="any" value="<%= line.selectedQty %>"
                               data-line="<%= line.idlinea %>" aria-label="{{ trans('to-refund') }}">
                        <button type="button" class="return-experimental-qty-plus btn btn-icon btn-light h-11 w-11"
                                data-line="<%= line.idlinea %>" aria-label="{{ trans('add') }}"
                                <%= line.disableIncrease ? 'disabled' : '' %>>
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        </article>
        <% }); %>
    </div>
    <% } %>
</script>
