<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
        <default>nextval('pos_cash_movements_id_seq'::regclass)</default>
    </column>
    <column>
        <name>idsesion</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>nickusuario</name>
        <type>character varying(50)</type>
        <null>NO</null>
    </column>
    <column>
        <name>nickautoriza</name>
        <type>character varying(50)</type>
        <null>YES</null>
        <default>NULL</default>
    </column>
    <column>
        <name>descripcion</name>
        <type>text</type>
        <null>NO</null>
    </column>
    <column>
        <name>fecha</name>
        <type>date</type>
        <null>NO</null>
    </column>
    <column>
        <name>hora</name>
        <type>time without time zone</type>
        <null>NO</null>
    </column>
    <column>
        <name>total</name>
        <type>double precision</type>
        <null>NO</null>
    </column>
    <constraint>
        <name>pos_cash_movements_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>ca_pos_cash_movements_session</name>
        <type>FOREIGN KEY (idsesion) REFERENCES pos_sessions (idsesion) ON DELETE RESTRICT ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_pos_cash_movements_users</name>
        <type>FOREIGN KEY (nickusuario) REFERENCES users (nick) ON DELETE RESTRICT ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_pos_cash_movements_authorizer</name>
        <type>FOREIGN KEY (nickusuario) REFERENCES users (nick) ON DELETE RESTRICT ON UPDATE CASCADE</type>
    </constraint>
</table>
