<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
        <default>nextval('pos_payment_methods_id_seq'::regclass)</default>
    </column>
    <column>
        <name>idterminal</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>icon</name>
        <type>character varying(25)</type>
        <null>YES</null>
        <default>NULL</default>
    </column>
    <column>
        <name>codpago</name>
        <type>character varying(10)</type>
        <null>NO</null>
    </column>
    <column>
        <name>recibecambio</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <constraint>
        <name>pos_payment_methods_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>uniq_codpago_idterminal</name>
        <type>UNIQUE (codpago, idterminal)</type>
    </constraint>
    <constraint>
        <name>ca_pos_payment_methods_terminal</name>
        <type>FOREIGN KEY (idterminal) REFERENCES pos_terminals (idterminal) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_pos_payment_methods_formaspago</name>
        <type>FOREIGN KEY (codpago) REFERENCES formaspago (codpago) ON DELETE RESTRICT ON UPDATE CASCADE</type>
    </constraint>
</table>
