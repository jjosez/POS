<div class="modal hidden" id="userModal">
    <div class="modal-content md:modal-content-sm">
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <i class="fa-solid fa-user" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-xl font-semibold text-slate-900">{{ trans('user') }}</h2>
                    <p class="truncate text-sm text-slate-500">{{ fsc.user.nick }}</p>
                </div>
            </div>
            <button type="button" class="btn btn-icon btn-naked ml-2" data-toggle="modal" data-target="userModal" aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="text-center">
                <span><i class="fa fa-user fa-3x"></i></span>
                <h2 class="text-2xl text-slate-gray-700 font-semibold">{{ fsc.user.nick }}</h2>
            </div>
            <div class="flex-1 mt-5">
                <form method="post">
                    <input type="hidden" name="action" value="change-user">
                    <label class="input-icon text-gray-600">
                        <span><i class="fa fa-user fa-sm"></i></span>
                        <input type="text" id="userNick" name="userNick" placeholder="Usuario...">
                    </label>
                    <label class="mt-5 input-icon text-gray-600">
                        <span><i class="fa fa-user-secret fa-sm"></i></span>
                        <input type="password" id="userPassword" name="userPassword" placeholder="****"
                               autocomplete="false">
                    </label>
                    <button id="loginButton" class="btn btn-success ml-auto mt-5">
                        <i class="fa fa-sign-in-alt"></i>
                        <span class="mx-2 text-center">{{ trans('change') }}</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
