<div id="loadingModal" class="modal hidden">
    <div class="modal-content md:modal-content-sm p-8">
        <div class="flex justify-center mb-6">
            <div class="w-20 h-20 rounded-full bg-blue-50 flex items-center justify-center">
                <svg class="w-10 h-10 animate-spin text-blue-600"
                     viewBox="0 0 64 64"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg">
                    <path
                            d="M32 3C36.5778 3 41.0906 4.08374 45.1692 6.16256C49.2477 8.24138 52.7762 11.2562 55.466 14.9605C58.1558 18.6647 59.9304 22.9531 60.6448 27.4748C61.3591 31.9965 60.9928 36.6232 59.5759 40.9762"
                            stroke="currentColor"
                            stroke-width="5"
                            stroke-linecap="round"/>
                </svg>
            </div>
        </div>
        <h2 id="loadingTitle"
            class="text-center text-3xl font-bold text-slate-900 mb-3">
            {{ trans('wait') }}
        </h2>
        <p id="loadingMessage"
           class="text-center text-slate-500 leading-6">
            {{ trans('processing-request') }}
        </p>
        {#<div class="mt-8 h-2 rounded-full bg-slate-200 overflow-hidden">
            <div class="h-full w-2/5 bg-blue-600 rounded-full animate-indeterminate"></div>
        </div>#}
    </div>
</div>

