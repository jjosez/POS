{% macro denominationRows(denominations, symbol) %}
    {% for denomination in denominations %}
        <div class="grid grid-cols-3 items-center gap-3 border-b border-slate-100 py-2 last:border-b-0"
             data-cash-count-row>
            <span class="font-medium text-slate-800">
                {{ symbol }}<span data-cash-denomination data-value="{{ denomination.valor }}">{{ denomination.valor }}</span>
            </span>
            <label class="flex items-center justify-center gap-2 text-slate-400">
                <span aria-hidden="true">×</span>
                <input name="cash[{{ denomination.clave }}]" type="number" value="0" min="0" step="1"
                       inputmode="numeric" class="h-10 w-20 rounded-md border border-slate-300 text-center text-base"
                       data-cash-count-input data-code="{{ denomination.clave }}" data-value="{{ denomination.valor }}"
                       aria-label="{{ trans('quantity') }}">
            </label>
            <strong class="text-right font-semibold text-slate-900">
                {{ symbol }}<span data-cash-subtotal>0.00</span>
            </strong>
        </div>
    {% endfor %}
{% endmacro %}

{% set bills = [] %}
{% set coins = [] %}
{% for denomination in context.config().getDenominations() %}
    {% if denomination.tipo == 'bill' %}
        {% set bills = bills|merge([denomination]) %}
    {% else %}
        {% set coins = coins|merge([denomination]) %}
    {% endif %}
{% endfor %}
{% set currencySymbol = context.currency().getCurrency().simbolo %}

<div id="session:close:modal" class="modal hidden">
    <div class="modal-content md:modal-content-sm">
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <i class="fa-solid fa-cash-register" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-xl font-semibold text-slate-900">{{ trans('cashup') }}</h2>
                    <p class="truncate text-sm text-slate-500">{{ terminal.nombre }}</p>
                </div>
            </div>
            <a class="btn btn-icon btn-light ml-auto" href="{{ context.session().url() }}" target="_blank">
                <i class="fa fw fa-eye"></i>
            </a>
            <a class="btn btn-icon btn-primary ml-2" href="{{ terminal.url('edit') }}" target="_blank" title="{{ terminal.nombre }}">
                <i class="fa-solid fa-desktop"></i>
            </a>
            <button class="btn btn-icon btn-success ml-2" title="{{ trans('print-z') }}"
                    data-action="session:report:x">
                <i class="fa fa-print fa-fw"></i>
            </button>
            <button type="button" class="btn btn-icon btn-naked ml-2" data-toggle="modal" data-target="session:close:modal" aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal-body">
            <form id="closeSessionForm" method="POST">
                <input type="hidden" name="action" value="session:close">
                <h3 class="mb-4 text-sm font-semibold text-slate-700">{{ trans('cash-count-detail') }}</h3>

                {% if bills %}
                    <section class="mb-5" aria-labelledby="cashBillsTitle">
                        <h4 id="cashBillsTitle" class="py-4 text-xs font-semibold uppercase tracking-wide text-slate-500">
                            {{ trans('bills') }}
                        </h4>
                        {{ _self.denominationRows(bills, currencySymbol) }}
                    </section>
                {% endif %}

                {% if coins %}
                    <section aria-labelledby="cashCoinsTitle">
                        <h4 id="cashCoinsTitle" class="py-4 text-xs font-semibold uppercase tracking-wide text-slate-500">
                            {{ trans('coins') }}
                        </h4>
                        {{ _self.denominationRows(coins, currencySymbol) }}
                    </section>
                {% endif %}

                {% if not bills and not coins %}
                    <div class="alert alert-warning" role="alert">
                        {{ trans('no-currency-denominations') }}
                        <a href="{{ terminal.url('edit') }}">{{ trans('pos-settings') }}</a>
                    </div>
                {% endif %}
            </form>
        </div>
        <div class="modal-footer items-center gap-4 border-t border-slate-200 p-4">
            <div class="mr-auto flex min-w-0 items-baseline gap-3">
                <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ trans('cash-counted') }}</span>
                <strong class="text-xl text-slate-900">
                    {{ currencySymbol }}<span id="cashCountedTotal">0.00</span>
                </strong>
            </div>
            <button type="submit" class="btn btn-primary" id="closeSessionButton" data-action="session:close"
                    data-toggle="modal" data-target="session:close:modal">
                {{ trans('continue') }}
            </button>
        </div>
    </div>
</div>
