<div id="moneyInOutModal" class="modal hidden">
    <div class="modal-content md:modal-content-sm">
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <i class="fa-solid fa-money-bill-transfer" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-xl font-semibold text-slate-900">{{ trans('till-session-cash-movments') }}</h2>
                    <p class="truncate text-sm text-slate-500">{{ trans('cash-movements-summary') }}</p>
                </div>
            </div>
            <button type="button" class="btn btn-icon btn-naked ml-2" data-toggle="modal" data-target="moneyInOutModal" aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="border-b border-gray-200 dark:border-gray-700 mb-4">
                <ul class="flex flex-wrap -mb-px tablist" data-target="cash-movments" role="tablist">
                    <li class="mr-2" role="presentation">
                        <button class="tab tab-active cursor-pointer"
                                data-toggle="tab"
                                data-target="cash-entry"
                                type="button" role="tab"
                                aria-controls="entry">
                            {{ trans('deposit') }}
                        </button>
                    </li>
                    <li class="mr-2" role="presentation">
                        <button class="tab cursor-pointer"
                                data-toggle="tab"
                                data-target="cash-withdraw"
                                type="button" role="tab"
                                aria-controls="dashboard">
                            {{ trans('withdraw') }}
                        </button>
                    </li>
                </ul>
            </div>
            <div class="mt-3" id="cash-movments">
                <div id="cash-entry" role="tabpanel"
                     class="tabcontent">
                    <form id="cashEntryForm" method="POST">
                        <input type="hidden" name="action" value="cash:entry">
                        <input type="hidden" name="token" value="{{ fsc.getNewToken() }}">
                        <div class="form-group mt-4">
                            <span class="font-medium">{{ trans('amount') }}</span>
                            <input name="amount" type="number" required>
                        </div>
                        <div class="form-group mt-2">
                            <span class="font-medium">{{ trans('description') }}</span>
                            <input name="description" type="text" required>
                        </div>
                    </form>
                    <button type="button" class="mt-4 mx-auto btn btn-primary btn-round"
                            data-action="session:cash:entry"
                            data-toggle="modal" data-target="moneyInOutModal">
                        {{ trans('deposit') }}</button>
                </div>
                <div id="cash-withdraw" class="tabcontent hidden" role="tabpanel"
                     aria-labelledby="cash-withdraw">
                    <form id="cashWithdrawForm" method="POST">
                        <input type="hidden" name="action" value="cash:withdraw">
                        <input type="hidden" name="token" value="{{ fsc.getNewToken() }}">
                        <div class="form-group mt-4">
                            <span class="font-medium">{{ trans('amount') }}</span>
                            <input name="amount" type="number" required>
                        </div>
                        <div class="form-group mt-2">
                            <span class="font-medium">{{ trans('description') }}</span>
                            <input name="description" type="text" required>
                        </div>
                    </form>
                    <button type="button" class="mt-4 mx-auto btn btn-warning btn-round"
                            data-action="session:cash:withdraw"
                            data-toggle="modal" data-target="moneyInOutModal">
                        {{ trans('withdraw') }}</button>
                </div>
            </div>
        </div>
    </div>
</div>
