<div id="product:edit:modal" class="modal hidden">
    <!--content-->
    <div class="modal-content">
        <!--header-->
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <h2 class="text-xl font-semibold text-slate-900">{{ trans('edit') }}</h2>
                    <p class="truncate text-sm text-slate-500">{{ trans('product') }}</p>
                </div>
            </div>
            <button type="button" class="btn btn-icon btn-naked ml-2" data-toggle="modal" data-target="product:edit:modal" aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>
        <!--body-->
        <div class="modal-body">
            <div id="cart:edit:form:view" class="grid grid-cols-2 gap-4 items-end">
            </div>
        </div>
    </div>
</div>
<div id="keypad:input:modal" class="hidden fixed inset-0 z-50">
    <div class="absolute inset-0 bg-black/40" onclick="closeKeypad(false)"></div>

    <div class="absolute inset-x-0 bottom-0 bg-white rounded-t-3xl p-4 pb-[env(safe-area-inset-bottom)]
              shadow-xl">
        <div class="flex items-center justify-between">
            <div class="text-sm font-extrabold text-slate-900">Captura</div>
            <button class="rounded-xl px-3 py-2 text-sm font-bold text-slate-700 bg-slate-100 hover:bg-slate-200"
                    onclick="closeKeypad(false)">Cancelar
            </button>
        </div>

        <div class="mt-3 rounded-2xl bg-slate-50 ring-1 ring-slate-200 p-3 text-right">
            <div class="text-xs font-semibold text-slate-500">Valor</div>
            <div id="keypadDisplay" class="text-2xl font-extrabold text-slate-900">0</div>
        </div>

        <div class="mt-3 grid grid-cols-3 gap-2">
            <button class="rounded-2xl bg-slate-100 py-4 text-xl font-extrabold" onclick="pressKeypad('7')">7</button>
            <button class="rounded-2xl bg-slate-100 py-4 text-xl font-extrabold" onclick="pressKeypad('8')">8</button>
            <button class="rounded-2xl bg-slate-100 py-4 text-xl font-extrabold" onclick="pressKeypad('9')">9</button>

            <button class="rounded-2xl bg-slate-100 py-4 text-xl font-extrabold" onclick="pressKeypad('4')">4</button>
            <button class="rounded-2xl bg-slate-100 py-4 text-xl font-extrabold" onclick="pressKeypad('5')">5</button>
            <button class="rounded-2xl bg-slate-100 py-4 text-xl font-extrabold" onclick="pressKeypad('6')">6</button>

            <button class="rounded-2xl bg-slate-100 py-4 text-xl font-extrabold" onclick="pressKeypad('1')">1</button>
            <button class="rounded-2xl bg-slate-100 py-4 text-xl font-extrabold" onclick="pressKeypad('2')">2</button>
            <button class="rounded-2xl bg-slate-100 py-4 text-xl font-extrabold" onclick="pressKeypad('3')">3</button>

            <button class="rounded-2xl bg-slate-100 py-4 text-lg font-extrabold" onclick="pressKeypad('.')">.</button>
            <button class="rounded-2xl bg-slate-100 py-4 text-xl font-extrabold" onclick="pressKeypad('0')">0</button>
            <button class="rounded-2xl bg-slate-100 py-4 text-lg font-extrabold" onclick="pressKeypad('⌫')">⌫</button>
        </div>

        <div class="mt-3 grid grid-cols-2 gap-2">
            <button class="rounded-2xl bg-slate-100 py-3 text-sm font-extrabold text-slate-700"
                    onclick="pressKeypad('C')">
                Limpiar
            </button>
            <button class="rounded-2xl bg-emerald-600 py-3 text-sm font-extrabold text-white hover:bg-emerald-500 active:bg-emerald-700"
                    onclick="closeKeypad(true)">
                OK
            </button>
        </div>

        <div class="mt-2 text-[11px] text-slate-500 flex flex-wrap gap-2">
            <span class="rounded-full bg-slate-100 px-2 py-1">Enter: OK</span>
            <span class="rounded-full bg-slate-100 px-2 py-1">Esc: Cancelar</span>
            <span class="rounded-full bg-slate-100 px-2 py-1">*</span>
            <span class="rounded-full bg-slate-100 px-2 py-1">Abrir keypad</span>
        </div>
    </div>
</div>
<script id="cart:edit:form:template" type="text/template">
    {% for column in grid %}
        {% set label = column.tittle ?: trans(column.name) %}
        {%- if column.data == 'referencia' -%}
            <div class="col-span-2 form-group">
                <label for="{{ column.data }}" class="font-semibold capitalize">{{ label }} </label>
                <input id="{{ column.data }}" type="{{ column.type }}" class="font-normal form-control"
                       value="<%= product.referencia %>" data-action="ui:cart:line:field:edit"
                       data-index="<%= product.index %>" data-field="{{ column.data }}" readonly>
            </div>
        {%- elseif column.data == 'descripcion' %}
            <div class="col-span-2 form-group">
                <label for="{{ column.data }}" class="font-semibold capitalize">{{ label }}</label>
                <textarea id="{{ column.data }}" class="font-normal form-control" rows="3"
                          data-action="ui:cart:line:field:edit"
                          data-index="<%= product.index %>" data-field="{{ column.data }}"
                        {% if column.readonly %} readonly {% endif %}><%- = product.descripcion %></textarea>
            </div>
        {% elseif column.eneabled -%}
            <div class="form-group">
                <label for="{{ column.data }}" class="font-semibold capitalize">{{ label }}</label>
                <input id="{{ column.data }}" class="font-normal form-control" type="{{ column.type }}"
                       value="<%= product.{{ column.data }} %>"
                       step=".001" data-index="<%= product.index %>"
                       data-action="{{ column.readonly ? '' : 'ui:cart:line:field:edit' }}"
                       data-field="{{ column.data }}" {% if column.readonly %} readonly {% endif %}>
            </div>
        {% endif -%}
    {% endfor %}
</script>
