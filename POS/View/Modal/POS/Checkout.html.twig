{% set paymentMethods = context.config().getPaymentMethods() %}
{% set cashMethod = context.config().getCashPaymentMethod() %}
<div id="checkout:modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="checkoutTitle">
    <div class="modal-content md:max-w-2xl">
        <div class="modal-header items-center p-4">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600">
                    <i class="fa-solid fa-credit-card" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <h2 id="checkoutTitle" class="text-xl font-semibold text-slate-900">{{ trans('charge') }}</h2>
                    <p class="truncate text-sm text-slate-500">{{ trans('payments-summary') }}</p>
                </div>
            </div>
            <button type="button" class="btn btn-icon btn-naked ml-2"
                    data-action="checkout:hide" data-toggle="modal" data-target="checkout:modal"
                    aria-label="{{ trans('close') }}">
                <i class="fa-solid fa-times" aria-hidden="true"></i>
            </button>
        </div>

        <div class="modal-body space-y-5">
            <div class="flex items-center justify-between rounded-lg border border-blue-100 bg-blue-50 p-4">
                <span class="font-semibold text-slate-700">{{ trans('payable-amount') }}</span>
                <span class="text-3xl font-bold tracking-tight text-slate-900">
                    <span class="mr-1 text-lg text-slate-500">{{ context.currency().getCurrency().simbolo }}</span><span
                            id="checkoutTotal">0.00</span>
                </span>
            </div>

            <div id="checkoutPaymentEntry" class="space-y-5">
                <div>
                    <label for="paymentApplyInput" class="mb-2 block text-sm font-semibold text-slate-700">
                        {{ trans('checkout-payment-amount') }}
                    </label>
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <label class="input-icon min-w-0 flex-1 text-slate-500">
                            <span aria-hidden="true">{{ context.currency().getCurrency().simbolo }}</span>
                            <input type="number" id="paymentApplyInput"
                                   class="h-14 text-right text-2xl font-bold text-slate-900"
                                   placeholder="0" inputmode="decimal" min="0"
                                   step="any"
                                   autocomplete="off">
                        </label>
                        <button type="button" class="btn btn-light h-14 justify-center px-5 sm:w-auto"
                                data-action="checkout:payment:recalc" data-value="balance">
                            <i class="fa-solid fa-scale-balanced mr-2" aria-hidden="true"></i>
                            <span>{{ trans('checkout-remaining') }}</span>
                        </button>
                    </div>
                </div>

                <section aria-labelledby="checkoutPaymentMethodsTitle">
                    <h3 id="checkoutPaymentMethodsTitle" class="mb-3 text-sm font-semibold text-slate-700">
                        {{ trans('available-payment-methods') }}
                    </h3>
                    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                        {% for element in paymentMethods %}
                            {% if loop.index <= 3 %}
                                {% set paymentIcon = element.iconClass() %}
                                <button type="button"
                                        class="btn btn-light relative min-h-20 flex-col justify-center gap-1 border-2 px-2 py-2 text-center"
                                        data-action="checkout:payment:add"
                                        data-payment-method
                                        data-payment-kind="native"
                                        data-code="{{ element.codpago }}"
                                        data-description="{{ element.descripcion }}"
                                        data-cash="{{ element.codpago == cashMethod ? 'true' : 'false' }}"
                                        aria-pressed="false">
                                    <i class="fa-solid fa-fw {{ paymentIcon }} text-lg" aria-hidden="true"></i>
                                    <span class="w-full whitespace-normal text-center text-sm leading-tight">{{ element.descripcion }}</span>
                                    <i data-payment-check hidden
                                       class="fa-solid fa-circle-check absolute right-1.5 top-1.5 text-sm text-blue-600"
                                       aria-hidden="true"></i>
                                </button>
                            {% endif %}
                        {% endfor %}
                        <button type="button"
                                class="btn btn-light min-h-20 flex-col justify-center gap-1 border-2 px-2 py-2"
                                data-action="checkout:payment:more" aria-expanded="false"
                                aria-controls="checkoutMoreMethods">
                            <i class="fa-solid fa-fw fa-ellipsis text-lg" aria-hidden="true"></i>
                            <span class="text-sm leading-tight">{{ trans('more') }}</span>
                        </button>
                    </div>

                    <div id="checkoutMoreMethods"
                         class="mt-2 hidden grid-cols-2 gap-2 rounded-lg border border-slate-200 bg-slate-50 p-3 sm:grid-cols-3">
                        {% for element in paymentMethods %}
                            {% if loop.index > 3 %}
                                {% set paymentIcon = element.iconClass() %}
                                <button type="button"
                                        class="btn btn-light relative min-h-20 flex-col justify-center gap-1 border-2 px-2 py-2 text-center"
                                        data-action="checkout:payment:add"
                                        data-payment-method
                                        data-payment-kind="native"
                                        data-code="{{ element.codpago }}"
                                        data-description="{{ element.descripcion }}"
                                        data-cash="{{ element.codpago == cashMethod ? 'true' : 'false' }}"
                                        aria-pressed="false">
                                    <i class="fa-solid fa-fw {{ paymentIcon }} text-lg" aria-hidden="true"></i>
                                    <span class="w-full whitespace-normal text-center text-sm leading-tight">{{ element.descripcion }}</span>
                                    <i data-payment-check hidden
                                       class="fa-solid fa-circle-check absolute right-1.5 top-1.5 text-sm text-blue-600"
                                       aria-hidden="true"></i>
                                </button>
                            {% endif %}
                        {% endfor %}

                        <div id="checkoutPaymentSourcesMount"
                             class="payment-sources-section contents"
                             data-loading-text="{{ trans('loading') }}"
                             data-error-text="{{ trans('payment-sources-load-error') }}"
                             data-retry-text="{{ trans('retry') }}"
                             data-empty-text="{{ trans('no-more-payment-methods') }}"
                             data-available-text="{{ trans('available') }}"></div>
                    </div>
                </section>

            </div>
            <section id="checkoutAppliedPayments" class="hidden" aria-labelledby="checkoutAppliedPaymentsTitle">
                <h3 id="checkoutAppliedPaymentsTitle" class="mb-2 text-xs font-semibold uppercase text-slate-500">
                    {{ trans('payments-summary') }}
                </h3>
                <div id="payment:list:view"></div>
            </section>

            <div id="checkoutPendingSummary"
                  class="hidden space-y-2 rounded-lg border border-slate-200 p-3 text-sm"
                  aria-live="polite">

                <div class="flex items-center justify-between gap-2">
                    <span>{{ trans('checkout-remaining') }}</span>
                    <strong>
                        {{ context.currency().getCurrency().simbolo }}
                        <span id="checkoutPendingAmount">0.00</span>
                    </strong>
                </div>
            </div>

            <div class="flex items-center justify-between gap-3 rounded-lg border border-slate-200 bg-slate-50 p-4">
                <div class="flex items-center gap-2">
                    <span class="text-sm text-slate-600">{{ trans('collected-amount') }}</span>
                    <strong class="text-lg text-blue-600">
                        {{ context.currency().getCurrency().simbolo }} <span id="checkoutCollectedAmount">0.00</span>
                    </strong>
                </div>
                <div id="checkoutBalanceRow" class="flex items-center gap-2 border-l border-slate-200 pl-4">
                    <span id="checkoutChangeLabel" class="text-sm text-slate-600">{{ trans('change-amount') }}</span>
                    <span id="checkoutBalanceLabel"
                          class="hidden text-sm text-slate-600">{{ trans('checkout-remaining') }}</span>
                    <strong class="text-lg text-emerald-600">
                        {{ context.currency().getCurrency().simbolo }} <span id="checkoutChangeAmount">0.00</span>
                    </strong>
                </div>
            </div>

        </div>

        <div class="modal-footer gap-3 p-4">
            <button type="button" class="btn btn-naked" data-action="checkout:hide"
                    data-toggle="modal" data-target="checkout:modal">
                {{ trans('cancel') }}
            </button>
            <button type="button" id="orderSaveButton" class="btn btn-success ml-auto"
                    data-action="order:save" disabled>
                <span id="checkoutConfirmLabel" data-charge="{{ trans('charge') }}"
                      data-finalize="{{ trans('finalize-sale') }}">{{ trans('charge') }}</span>
                <i class="fa-solid fa-arrow-right ml-2" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

<script id="payment:list:template" type="text/template">
    <% payments.forEach(function(value, index) { %>
    <div class="flex items-center gap-3 border-t border-slate-200 py-2 first:border-t-0 <%= value.kind === 'source' ? 'payment-row-source' : '' %>">
        <i class="fa-solid fa-circle-check text-blue-600" aria-hidden="true"></i>
        <span class="min-w-0 flex-1 truncate text-sm font-medium text-slate-700"><%= value.description %></span>
        <strong class="text-slate-900"><%= value.formattedAmount %></strong>
        <button type="button" class="btn btn-icon btn-naked h-9 w-9 text-red-600"
                data-action="checkout:payment:delete" data-index="<%= index %>"
                aria-label="{{ trans('delete') }}">
            <i class="fa-solid fa-times" aria-hidden="true"></i>
        </button>
    </div>
    <% }) %>
</script>

<script id="payment-sources-list" type="text/template">
    <% it.sources.forEach(function(source) { %>
        <button type="button"
                class="btn btn-light relative min-h-20 w-full flex-col justify-center gap-1 border-2 px-2 py-2 text-center payment-source-item <%= source.available ? '' : 'opacity-60' %>"
                data-action="checkout:payment-source:add"
                data-payment-kind="source"
                data-code="<%= source.code %>"
                data-label="<%= source.label %>"
                data-description="<%= source.description ?? '' %>"
                data-available="<%= source.available ? 'true' : 'false' %>"
                data-available-amount="<%= source.available_amount ?? '' %>"
                data-status="<%= source.status ?? 'AVAILABLE' %>"
                data-message="<%= source.message ?? '' %>"
                aria-pressed="false"
            <%= source.available ? '' : 'disabled' %>>
            <i class="fa-solid fa-fw <%= source.icon || 'fa-circle-dot' %> text-lg" aria-hidden="true"></i>
            <span class="w-full whitespace-normal text-center text-sm leading-tight"><%= source.label %></span>
            <% if (source.availableText) { %>
                <span class="w-full whitespace-normal text-center text-xs leading-tight text-slate-500"><%= source.availableText %></span>
            <% } else if (source.message) { %>
                <span class="w-full whitespace-normal text-center text-xs leading-tight text-slate-500"><%= source.message %></span>
            <% } else if (source.description) { %>
                <span class="w-full whitespace-normal text-center text-xs leading-tight text-slate-500"><%= source.description %></span>
            <% } %>
            <i data-payment-source-check hidden
               class="fa-solid fa-circle-check absolute right-1.5 top-1.5 text-sm text-blue-600"
               aria-hidden="true"></i>
        </button>
    <% }) %>

    <% if (it.status === 'loading') { %>
        <div class="col-span-full flex items-center justify-center gap-2 rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm text-slate-500"
             data-payment-sources-loading>
            <span class="loading loading-spinner loading-xs"></span>
            <span><%= it.texts.loading %></span>
        </div>
    <% } else if (it.status === 'error') { %>
        <div class="col-span-full flex items-center justify-center gap-2 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-600"
             data-payment-sources-error>
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span><%= it.texts.error %></span>
            <button type="button" class="btn btn-naked ml-2"
                    data-action="checkout:payment-sources:retry">
                <%= it.texts.retry %>
            </button>
        </div>
    <% } else if (it.showEmpty) { %>
        <div class="col-span-full rounded-lg border border-slate-200 bg-slate-50 p-3 text-center text-sm text-slate-500"
             data-more-payment-methods-empty>
            <%= it.texts.empty %>
        </div>
    <% } %>
</script>
