<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>codserie</name>
        <type>character varying(4)</type>
        <null>NO</null>
    </column>
    <column>
        <name>descripcion</name>
        <type>character varying(30)</type>
        <null>NO</null>
    </column>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
        <default>nextval('pos_document_types_id_seq'::regclass)</default>
    </column>
    <column>
        <name>idterminal</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>tipodoc</name>
        <type>character varying(30)</type>
        <null>NO</null>
    </column>
    <column>
        <name>preferido</name>
        <type>boolean</type>
        <default>false</default>
    </column>
    <constraint>
        <name>pos_document_types_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>uniq_serie_tipodoc_idterminal</name>
        <type>UNIQUE (codserie, tipodoc, idterminal)</type>
    </constraint>
    <constraint>
        <name>ca_pos_document_types_terminal</name>
        <type>FOREIGN KEY (idterminal) REFERENCES pos_terminals (idterminal) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_pos_document_types_series</name>
        <type>FOREIGN KEY (codserie) REFERENCES series (codserie) ON DELETE RESTRICT ON UPDATE CASCADE</type>
    </constraint>
</table>
