<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>columns</name>
        <type>text</type>
    </column>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>idterminal</name>
        <type>integer</type>
        <null>YES</null>
    </column>
    <column>
        <name>nick</name>
        <type>character varying(50)</type>
    </column>
    <constraint>
        <name>pos_terminal_options_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>uniq_pos_terminal_options</name>
        <type>UNIQUE (idterminal, nick)</type>
    </constraint>
    <constraint>
        <name>ca_pos_terminal_options_terminal</name>
        <type>FOREIGN KEY (idterminal) REFERENCES pos_terminals (idterminal) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_pos_terminal_options_users</name>
        <type>FOREIGN KEY (nick) REFERENCES users (nick) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
</table>
