<?xml version="1.0" encoding="UTF-8"?>
<table>
    <column>
        <name>cantidad</name>
        <type>double precision</type>
    </column>
    <column>
        <name>codpago</name>
        <type>character varying(10)</type>
        <null>YES</null>
    </column>
    <column>
        <name>id</name>
        <type>serial</type>
        <null>NO</null>
    </column>
    <column>
        <name>idmodelfrom</name>
        <type>integer</type>
        <null>YES</null>
    </column>
    <column>
        <name>idmodelto</name>
        <type>integer</type>
        <null>YES</null>
    </column>
    <column>
        <name>idpagopos</name>
        <type>integer</type>
        <null>NO</null>
    </column>
    <column>
        <name>idparent</name>
        <type>integer</type>
        <null>YES</null>
    </column>
    <column>
        <name>modelfrom</name>
        <type>character varying(30)</type>
        <null>YES</null>
    </column>
    <column>
        <name>modelto</name>
        <type>character varying(30)</type>
        <null>YES</null>
    </column>
    <constraint>
        <name>pos_payment_tracking_pkey</name>
        <type>PRIMARY KEY (id)</type>
    </constraint>
    <constraint>
        <name>ca_pos_payment_tracking_payment</name>
        <type>FOREIGN KEY (idpagopos) REFERENCES pos_payments (idpago) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_pos_payment_tracking_parent</name>
        <type>FOREIGN KEY (idparent) REFERENCES pos_payment_tracking (id) ON DELETE CASCADE ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>ca_pos_payment_tracking_method</name>
        <type>FOREIGN KEY (codpago) REFERENCES formaspago (codpago) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint>
    <constraint>
        <name>uq_pos_payment_tracking_transition</name>
        <type>UNIQUE (idparent, modelto, idmodelto)</type>
    </constraint>
</table>
